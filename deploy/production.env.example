# Production-only values. Copy to deploy/production.env (ignored by Git).
# Keep deploy/production.env private (chmod 600). No development provider defaults.

# Required. Generate with: openssl rand -hex 32; exactly 64 hex characters.
# Never rotate by merely editing this variable after a database has initialized.
# Use only hexadecimal characters: the password is also embedded in a PostgreSQL URL.
POSTGRES_PASSWORD=

# Required. Set the public HTTPS origin (no trailing path), e.g. https://lansurfer.example.org
LANSURFER_BASE_URL=
# Local Docker host port behind a reverse proxy; do not expose it publicly.
LANSURFER_HTTP_PORT=8080
LANSURFER_INSTANCE_NAME=
# Optional. Only exact, trusted proxy IPs/CIDRs; never 0.0.0.0/0.
LANSURFER_TRUSTED_PROXIES=

# Choose at least one login provider before onboarding users.
# Configure both issuer + client ID for OIDC; secret is optional for PKCE public clients.
LANSURFER_OIDC_ISSUER=
LANSURFER_OIDC_CLIENT_ID=
LANSURFER_OIDC_CLIENT_SECRET=
LANSURFER_OIDC_DISPLAY_NAME=
LANSURFER_OIDC_GAME_NICK_CLAIM=

# Discord login (separate from Discord notification delivery).
LANSURFER_DISCORD_CLIENT_ID=
LANSURFER_DISCORD_CLIENT_SECRET=
LANSURFER_DISCORD_WEBHOOK_CLIENT_ID=
LANSURFER_DISCORD_WEBHOOK_CLIENT_SECRET=

# Web Push and encrypted Discord notification data. Preserve keys across restores.
# Generate VAPID and encryption keys once with the LANsurfer CLI (see deploy/README.md).
LANSURFER_WEBPUSH_PUBLIC_KEY=
LANSURFER_WEBPUSH_PRIVATE_KEY=
LANSURFER_WEBPUSH_SUBJECT=
LANSURFER_DATA_ENCRYPTION_KEY=

# Twitch login and IGDB discovery are independently opt-in but share credentials.
LANSURFER_TWITCH_CLIENT_ID=
LANSURFER_TWITCH_CLIENT_SECRET=
LANSURFER_TWITCH_AUTH_ENABLED=false
LANSURFER_IGDB_ENABLED=false

# Operator identity appears on Terms/Privacy pages; name + email required for Discord login.
LANSURFER_LEGAL_ENTITY_NAME=
LANSURFER_LEGAL_ADDRESS=
LANSURFER_LEGAL_CONTACT_EMAIL=
LANSURFER_IMPRINT_URL=

# Optional per-player chat rate override (defaults are 5 messages per 20s).
LANSURFER_CHAT_RATE_LIMIT=
LANSURFER_CHAT_RATE_WINDOW=
