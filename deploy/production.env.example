# __LANSURFER_DEPLOYMENT_RELEASE_HEADER__
LANSURFER_IMAGE=__LANSURFER_RELEASE_IMAGE__
POSTGRES_IMAGE=postgres:18.6-alpine@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2

# Required. Generate with: openssl rand -hex 32; exactly 64 hex characters.
# Never rotate by merely editing this variable after a database has initialized.
# Use only hexadecimal characters: the password is also embedded in a PostgreSQL URL.
POSTGRES_PASSWORD=

# Required. Set the public HTTPS origin (no trailing path), e.g. https://lansurfer.example.org
LANSURFER_BASE_URL=
# Local Docker host port behind a reverse proxy; do not expose it publicly.
LANSURFER_HTTP_PORT=8080
# Optional label for your LAN event/community; up to 64 characters.
LANSURFER_INSTANCE_NAME=
# Optional. Only exact, trusted proxy IPs/CIDRs; never 0.0.0.0/0.
LANSURFER_TRUSTED_PROXIES=

# Optional existing Docker-based Traefik, after downloading compose.traefik.yaml.
# Uncomment COMPOSE_FILE, HOST, NETWORK and CERT_RESOLVER; ENTRYPOINT is
# optional (defaults to websecure). The network and TLS resolver must exist.
# COMPOSE_FILE=compose.yaml:compose.traefik.yaml
# TRAEFIK_HOST=lansurfer.example.org
# TRAEFIK_NETWORK=traefik_proxy
# TRAEFIK_CERT_RESOLVER=letsencrypt
# TRAEFIK_ENTRYPOINT=websecure

# Choose at least one login provider before onboarding users.
# Configure both issuer + client ID for OIDC; secret is optional for PKCE public clients.
LANSURFER_OIDC_ISSUER=
LANSURFER_OIDC_CLIENT_ID=
LANSURFER_OIDC_CLIENT_SECRET=
# Optional login-provider label; defaults to OpenID Connect.
LANSURFER_OIDC_DISPLAY_NAME=
# Optional ID-token string claim for suggesting a Game Nick, e.g. nickname.
LANSURFER_OIDC_GAME_NICK_CLAIM=

# Discord player login: register <HTTPS origin>/auth/discord/callback.
LANSURFER_DISCORD_CLIENT_ID=
LANSURFER_DISCORD_CLIENT_SECRET=
# Optional Discord webhook delivery: a separate OAuth flow and credentials.
# Register <HTTPS origin>/admin/discord/callback with the webhook.incoming scope.
# Then authorize the destination via Administration -> Discord delivery.
# Requires LANSURFER_DATA_ENCRYPTION_KEY as well; never rotate it casually.
LANSURFER_DISCORD_WEBHOOK_CLIENT_ID=
LANSURFER_DISCORD_WEBHOOK_CLIENT_SECRET=

# Optional Web Push: configure both VAPID keys and a subject starting with
# mailto: or https://. Generate keys once with:
# docker compose run --rm --no-deps lansurfer admin notifications generate-secrets
# Data-encryption key must be standard Base64 of 32 bytes for Web Push OR
# Discord delivery. Save/reuse it across restores; never rotate casually.
LANSURFER_WEBPUSH_PUBLIC_KEY=
LANSURFER_WEBPUSH_PRIVATE_KEY=
LANSURFER_WEBPUSH_SUBJECT=
LANSURFER_DATA_ENCRYPTION_KEY=

# Twitch login and IGDB discovery are independently opt-in but share credentials.
# Both Twitch credentials are needed if EITHER feature is enabled.
LANSURFER_TWITCH_CLIENT_ID=
LANSURFER_TWITCH_CLIENT_SECRET=
LANSURFER_TWITCH_AUTH_ENABLED=false
LANSURFER_IGDB_ENABLED=false

# Legal documents are edited in Administration -> Legal texts after first login.
# Enable the administrator-written imprint page if needed.
LANSURFER_IMPRINT_ENABLED=false

# Optional chat rate per player/Game Request; defaults: 5 messages per 20s.
# Limit must be a positive integer; window a duration of at least 1s.
LANSURFER_CHAT_RATE_LIMIT=
LANSURFER_CHAT_RATE_WINDOW=
