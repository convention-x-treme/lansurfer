# Development-only defaults for running the Go process outside Compose.
LANSURFER_DATABASE_URL=postgres://lansurfer:lansurfer@127.0.0.1:5432/lansurfer?sslmode=disable
LANSURFER_LISTEN_ADDR=:8080
LANSURFER_BASE_URL=http://localhost:8080
# Comma-separated IP addresses or CIDR ranges of reverse proxies that are
# allowed to supply X-Forwarded-For. Leave empty when connecting directly.
LANSURFER_TRUSTED_PROXIES=

# Local CXT development realm. Discovery uses:
# https://auth.convention-x-treme.de/realms/local-dev/.well-known/openid-configuration
# The provider must allow http://localhost:8080/auth/callback as a redirect URI.
LANSURFER_OIDC_ISSUER=https://auth.convention-x-treme.de/realms/local-dev
LANSURFER_OIDC_CLIENT_ID=lansurfer
# Optional for a public PKCE client; set it when using a confidential client.
LANSURFER_OIDC_CLIENT_SECRET=
LANSURFER_OIDC_DISPLAY_NAME=CXT account
LANSURFER_OIDC_GAME_NICK_CLAIM=nickname

# Optional Discord login. Configure both values or leave both empty.
# The Discord application's OAuth2 redirect must include
# http://localhost:8080/auth/discord/callback.
LANSURFER_DISCORD_CLIENT_ID=
LANSURFER_DISCORD_CLIENT_SECRET=

# Optional Discord notification delivery (separate from Discord login above).
# Configure both values or leave both empty. Requires LANSURFER_DATA_ENCRYPTION_KEY.
LANSURFER_DISCORD_WEBHOOK_CLIENT_ID=
LANSURFER_DISCORD_WEBHOOK_CLIENT_SECRET=

# Optional Web Push. Set both VAPID keys together; subject is required when
# Web Push is enabled. Data encryption key must be an AES-256 key and is
# required for Web Push or Discord notification delivery. Never commit real secrets.
LANSURFER_WEBPUSH_PUBLIC_KEY=
LANSURFER_WEBPUSH_PRIVATE_KEY=
LANSURFER_WEBPUSH_SUBJECT=
LANSURFER_DATA_ENCRYPTION_KEY=

# Optional Twitch application shared by Twitch login and IGDB discovery.
# Enable either capability explicitly. Enabled capabilities require both credentials.
# Register http://localhost:8080/auth/twitch/callback for Twitch login.
LANSURFER_TWITCH_CLIENT_ID=
LANSURFER_TWITCH_CLIENT_SECRET=
LANSURFER_TWITCH_AUTH_ENABLED=false
LANSURFER_IGDB_ENABLED=false

# Optional minimum instance identity (max 64 Unicode characters, no control
# characters/line breaks). Empty falls back to "LANsurfer". A real pilot
# deployment should set an explicit name.
LANSURFER_INSTANCE_NAME=

# Operator legal identity shown on /terms and /privacy. Required when Discord
# login is configured (entity name and contact email). Keep the address on one
# line; separate parts with commas.
LANSURFER_LEGAL_ENTITY_NAME=Computerfreunde Karlsdorf-Neuthard e.V.
LANSURFER_LEGAL_ADDRESS=<Street and number>, <Postal code> Karlsdorf-Neuthard, Germany
LANSURFER_LEGAL_CONTACT_EMAIL=datenschutz@convention-x-treme.de
# Optional absolute http(s) link to an external imprint (Impressum), e.g.
# https://www.convention-x-treme.de/impressum (placeholder: confirm the URL).
LANSURFER_IMPRINT_URL=
