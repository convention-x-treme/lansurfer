# Development-only defaults for running the Go process outside Compose.
LANSURFER_DATABASE_URL=postgres://lansurfer:lansurfer@127.0.0.1:5432/lansurfer?sslmode=disable
LANSURFER_LISTEN_ADDR=:8080
LANSURFER_BASE_URL=http://localhost:8080
# Comma-separated IP addresses or CIDR ranges of reverse proxies that are
# allowed to supply X-Forwarded-For. Leave empty when connecting directly.
LANSURFER_TRUSTED_PROXIES=

# Local CXT development realm. Discovery uses:
# https://auth.convention-x-treme.de/realms/local-dev/.well-known/openid-configuration
# The provider must allow http://localhost:8080/auth/callback as a redirect URI.
LANSURFER_OIDC_ISSUER=https://auth.convention-x-treme.de/realms/local-dev
LANSURFER_OIDC_CLIENT_ID=lansurfer
# Optional for a public PKCE client; set it when using a confidential client.
LANSURFER_OIDC_CLIENT_SECRET=

# Optional IGDB discovery provider. Configure both values or leave both empty.
LANSURFER_IGDB_CLIENT_ID=
LANSURFER_IGDB_CLIENT_SECRET=
