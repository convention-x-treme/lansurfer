package components

import "github.com/convention-x-treme/lansurfer/internal/web/branding"

templ EmptyState(brand branding.Brand) {
	<section class="request-empty" aria-labelledby="empty-state-title">
		<img src={ brand.Assets.Mascot } alt=""/>
		<div>
			<h3 id="empty-state-title" class="text-2xl font-bold">Quiet out there. Start something?</h3>
			<p class="mt-2 max-w-xl text-base-content/70">No open requests right now. Post one so other players can join.</p>
			<a class="btn btn-primary btn-sm mt-5" href="/game-requests/new">Create Game Request</a>
		</div>
	</section>
}

templ ErrorState() {
	<div role="alert" class="alert alert-error">
		<div>
			<h3 class="font-bold">Something went wrong</h3>
			<p class="text-sm">We could not load this section. Try the request again.</p>
		</div>
		<button type="button" class="btn btn-sm border-error-content/40 bg-transparent text-error-content hover:border-error-content hover:bg-error-content/15" hx-get="/ui/patterns/empty" hx-target="#pattern-preview" hx-swap="innerHTML">Try again</button>
	</div>
}
