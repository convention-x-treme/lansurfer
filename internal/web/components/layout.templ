package components

import "github.com/convention-x-treme/lansurfer/internal/web/branding"
import webmiddleware "github.com/convention-x-treme/lansurfer/internal/web/middleware"

type Viewer struct {
	DisplayName string
	Role string
}

type NavigationState struct {
	Viewer *Viewer
	LoginAvailable bool
}

templ Layout(brand branding.Brand, title string, navigation NavigationState) {
	<!doctype html>
	<html lang="en" data-theme="lansurfer-dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content={ brand.Tagline }/>
			<title>{ title } · { brand.Name }</title>
			<link rel="stylesheet" href={ brand.Assets.Stylesheet }/>
			<script src={ brand.Assets.Script } defer></script>
		</head>
		<body class="bg-base-100 text-base-content antialiased">
			<a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-warning focus:px-4 focus:py-2 focus:text-warning-content" href="#main-content">Skip to content</a>
			@Navigation(brand, navigation)
			if navigation.Viewer != nil {
				<div data-realtime-url="/events/game-requests"></div>
				<div id="live-notices" class="pointer-events-none fixed right-4 top-4 z-50 grid w-[min(24rem,calc(100%-2rem))] gap-3 [&>*]:pointer-events-auto" aria-live="polite"></div>
			}
			<main id="main-content">
				{ children... }
			</main>
			@Footer(brand)
		</body>
	</html>
}

templ Navigation(brand branding.Brand, state NavigationState) {
	<header class="border-b border-base-300 bg-base-200/95 shadow-sm">
		<nav class="navbar page-shell min-h-18 px-0" aria-label="Primary navigation">
			<div class="navbar-start">
				<a class="brand-wordmark text-2xl text-primary" href="/" aria-label={ brand.Name + " home" }>{ brand.Name }</a>
			</div>
			<div class="navbar-center hidden md:flex">
				<ul class="menu menu-horizontal gap-1 px-1">
					<li><a class="menu-active" href="/" aria-current="page">Home</a></li>
					if state.Viewer != nil {
						<li><a href="/games">Games</a></li>
						<li><a href="/games/mine">My Games</a></li>
					} else {
						<li><span class="cursor-not-allowed opacity-55" aria-disabled="true">Games</span></li>
					}
					if state.Viewer != nil {
						<li><a href="/game-requests">Game Requests</a></li>
					} else {
						<li><span class="cursor-not-allowed opacity-55" aria-disabled="true">Game Requests</span></li>
					}
					if state.Viewer != nil && state.Viewer.Role == "admin" {
						<li><a href="/admin/games">Admin</a></li>
					}
				</ul>
			</div>
			<div class="navbar-end gap-2">
				<button type="button" class="btn btn-ghost btn-sm" data-theme-toggle aria-label="Use light theme" title="Use light theme">Light</button>
				if state.Viewer != nil {
					<details class="dropdown dropdown-end">
						<summary class="btn btn-ghost btn-sm" aria-label="Open user menu">{ state.Viewer.DisplayName }</summary>
						<div class="dropdown-content z-20 mt-3 w-56 rounded-box border border-base-300 bg-base-200 p-3 shadow-xl">
							<p class="truncate font-semibold">{ state.Viewer.DisplayName }</p>
							<p class="data-text mt-1 text-xs uppercase text-base-content/60">{ state.Viewer.Role }</p>
							<form method="post" action="/auth/logout" class="mt-3">
								@CSRFInput()
								<button type="submit" class="btn btn-outline btn-sm w-full">Log out</button>
							</form>
						</div>
					</details>
				} else if state.LoginAvailable {
					<a class="btn btn-primary btn-sm" href="/auth/login">Log in</a>
				}
				<details class="dropdown dropdown-end md:hidden">
					<summary class="btn btn-ghost btn-sm" aria-label="Open navigation">Menu</summary>
					<ul class="menu dropdown-content z-20 mt-3 w-56 rounded-box border border-base-300 bg-base-200 p-2 shadow-xl">
						<li><a class="menu-active" href="/" aria-current="page">Home</a></li>
						if state.Viewer != nil {
							<li><a href="/games">Games</a></li>
							<li><a href="/games/mine">My Games</a></li>
						} else {
							<li><span class="cursor-not-allowed opacity-55" aria-disabled="true">Games</span></li>
						}
						if state.Viewer != nil {
							<li><a href="/game-requests">Game Requests</a></li>
						} else {
							<li><span class="cursor-not-allowed opacity-55" aria-disabled="true">Game Requests</span></li>
						}
						if state.Viewer != nil && state.Viewer.Role == "admin" {
							<li><a href="/admin/games">Admin games</a></li>
							<li><a href="/admin/events">Admin events</a></li>
						}
					</ul>
				</details>
			</div>
		</nav>
	</header>
}

templ CSRFInput() {
	<input type="hidden" name="csrf_token" value={ webmiddleware.CSRFToken(ctx) }/>
}

templ Footer(brand branding.Brand) {
	<footer class="border-t border-base-300 bg-base-200">
		<div class="page-shell flex flex-col gap-1 py-6 text-sm text-base-content/70 sm:flex-row sm:items-center sm:justify-between">
			<p><span class="brand-wordmark text-base-content">{ brand.Name }</span> · Open-source LFG for LAN events.</p>
			<p>{ brand.Tagline }</p>
		</div>
	</footer>
}
