package components

import (
	"context"
	"fmt"
	"strings"
	"unicode/utf8"

	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	webmiddleware "github.com/convention-x-treme/lansurfer/internal/web/middleware"
)

// A visitor who has chosen a theme gets it in the markup, so the first paint is
// already correct; without a choice the attribute is absent and the stylesheet's
// prefers-color-scheme default decides. Either way nothing repaints on load.
func themeAttributes(ctx context.Context) templ.Attributes {
	if theme := webmiddleware.ThemeChoice(ctx); theme != "" {
		return templ.Attributes{"data-theme": theme}
	}
	return nil
}

type Viewer struct {
	ID string
	GameNick string
	Role string
}

type NavigationState struct {
	Viewer *Viewer
	LoginAvailable bool
	Section string
	// OpenRequests is rendered beside the Game Requests link. It counts every
	// open Game Request on the installation, never the subset a discovery
	// filter matched. Sections without a count on the current page omit it.
	OpenRequests int64
}

templ Layout(brand branding.Brand, title string, navigation NavigationState) {
	<!doctype html>
	<html lang="en" { themeAttributes(ctx)... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content={ brand.Tagline }/>
			<title>{ title } · { brand.Name }</title>
			@FontPreloads(brand)
			<link rel="stylesheet" href={ brand.Assets.Stylesheet }/>
			<script src={ brand.Assets.Script } defer></script>
		</head>
		<body class="bg-base-100 text-base-content antialiased">
			<a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-warning focus:px-4 focus:py-2 focus:text-warning-content" href="#main-content">Skip to content</a>
			if navigation.Viewer != nil {
				<div class="app-shell">
					@DesktopNavigation(brand, navigation)
					<div class="min-w-0">
						@MobileNavigation(brand, navigation)
						<div data-realtime-url="/events/game-requests"></div>
						<div id="live-notices" class="pointer-events-none fixed bottom-4 right-4 z-50 grid w-[min(24rem,calc(100%-2rem))] gap-3 [&>*]:pointer-events-auto" aria-live="polite"></div>
						<main id="main-content" class="min-w-0">
							{ children... }
						</main>
					</div>
				</div>
			} else {
				<div class="flex min-h-screen flex-col">
					@PublicHeader(brand, navigation)
					<main id="main-content" class="flex-1">
						{ children... }
					</main>
					@Footer(brand)
				</div>
			}
		</body>
	</html>
}

templ AuthLayout(brand branding.Brand, title string) {
	<!doctype html>
	<html lang="en" { themeAttributes(ctx)... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content={ brand.Tagline }/>
			<title>{ title } · { brand.Name }</title>
			@FontPreloads(brand)
			<link rel="stylesheet" href={ brand.Assets.Stylesheet }/>
			<script src={ brand.Assets.Script } defer></script>
		</head>
		<body class="bg-base-100 text-base-content antialiased">
			<a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-warning focus:px-4 focus:py-2 focus:text-warning-content" href="#main-content">Skip to content</a>
			<header class="auth-header"><a class="brand-wordmark text-xl" href="/"><span>LAN</span><span class="text-primary">surfer</span></a>@ThemeToggle()</header>
			<main id="main-content">{ children... }</main>
		</body>
	</html>
}

templ PublicHeader(brand branding.Brand, state NavigationState) {
	<header class="border-b border-base-300 bg-base-100/95">
		<nav class="page-shell flex min-h-16 items-center justify-between gap-4" aria-label="Primary navigation">
			<a class="brand-wordmark text-xl text-primary" href="/" aria-label={ brand.Name + " home" }>{ brand.Name }</a>
			<div class="flex items-center gap-2">
				@ThemeToggle()
				if state.LoginAvailable {
					<a class="btn btn-primary btn-sm" href="/auth/login">Log in</a>
				}
			</div>
		</nav>
	</header>
}

templ DesktopNavigation(brand branding.Brand, state NavigationState) {
	<aside class="app-sidebar hidden lg:flex" aria-label="Application navigation">
		<a class="brand-wordmark px-2 text-xl text-base-content" href="/game-requests" aria-label={ brand.Name + " Game Requests" }>
			<span>LAN</span><span class="text-primary">surfer</span>
		</a>
		@NavigationLinks(state)
		<div class="mt-auto grid gap-3">
			@ViewerPanel(state.Viewer)
			<div class="flex items-center justify-between gap-2 px-2">
				@LogoutControl()
				@ThemeToggle()
			</div>
			@OperatorAttribution("px-2 text-xs text-base-content/65")
		</div>
	</aside>
}

templ MobileNavigation(brand branding.Brand, state NavigationState) {
	<header class="mobile-header lg:hidden">
		<details class="mobile-drawer" data-mobile-navigation>
			<summary class="btn btn-ghost btn-sm" aria-label="Open navigation">
				<span aria-hidden="true">☰</span>
				<span class="brand-wordmark">{ brand.Name }</span>
			</summary>
			<div class="mobile-drawer-backdrop" data-close-navigation></div>
			<nav class="mobile-drawer-panel" aria-label="Mobile navigation">
				<div class="flex items-center justify-between">
					<span class="brand-wordmark text-xl"><span>LAN</span><span class="text-primary">surfer</span></span>
					<button class="btn btn-ghost btn-sm" type="button" data-close-navigation aria-label="Close navigation">×</button>
				</div>
				@NavigationLinks(state)
				<div class="mt-auto grid gap-3">
					@ViewerPanel(state.Viewer)
					<div class="flex items-center justify-between gap-2 px-2">
						@LogoutControl()
						@ThemeToggle()
					</div>
					@OperatorAttribution("px-2 text-xs text-base-content/65")
				</div>
			</nav>
		</details>
	</header>
}

templ NavigationLinks(state NavigationState) {
	<ul class="app-navigation">
		<li>
			<a class={ navigationLinkClass(state.Section == "game-requests") } href="/game-requests" aria-current={ navigationCurrent(state.Section == "game-requests") }>
				<span>Game Requests</span>
				if state.OpenRequests > 0 {
					<span class="data-text count-hot ml-auto text-xs">{ fmt.Sprint(state.OpenRequests) }</span>
				}
			</a>
		</li>
		<li>@NavigationLink("/games", "Games", "games", state.Section)</li>
		<li>@NavigationLink("/games/mine", "My Games", "my-games", state.Section)</li>
		if state.Viewer != nil && state.Viewer.Role == "admin" {
			<li>
				<a class={ navigationLinkClass(state.Section == "administration") } href="/admin/games" aria-current={ navigationCurrent(state.Section == "administration") }>
					<span>Administration</span><span class="status-chip status-chip-host ml-auto">Orga</span>
				</a>
			</li>
		}
	</ul>
}

templ NavigationLink(href, label, section, current string) {
	<a class={ navigationLinkClass(section == current) } href={ templ.SafeURL(href) } aria-current={ navigationCurrent(section == current) }>{ label }</a>
}

templ ViewerPanel(viewer *Viewer) {
	if viewer != nil {
		<a class="viewer-panel" href="/account">
			<span class="avatar-placeholder" aria-hidden="true">{ ViewerInitial(viewer.GameNick) }</span>
			<span class="min-w-0"><strong class="block truncate text-sm">{ viewer.GameNick }</strong><span class="block text-xs font-semibold text-primary">{ viewerRole(viewer.Role) }</span></span>
		</a>
	}
}

templ LogoutControl() {
	<form method="post" action="/auth/logout">
		@CSRFInput()
		<button type="submit" class="btn btn-ghost btn-sm px-0 text-sm text-base-content/70">Log out</button>
	</form>
}

templ ThemeToggle() {
	<button type="button" class="btn btn-ghost btn-sm btn-square" data-theme-toggle aria-label="Use light theme" title="Use light theme"><span data-theme-icon aria-hidden="true">☾</span></button>
}

templ CSRFInput() {
	<input type="hidden" name="csrf_token" value={ webmiddleware.CSRFToken(ctx) }/>
}

// OperatorAttribution renders the fixed "Powered by …" credit that links to the
// operating community's site. class carries the surrounding context's text
// styling, because the sidebar, mobile drawer, and login panel each differ.
templ OperatorAttribution(class string) {
	<p class={ class }>Powered by <a class="link whitespace-nowrap text-base-content/75" href={ branding.OperatorURL } target="_blank" rel="noopener noreferrer">{ branding.OperatorName }</a></p>
}

// FontPreloads starts the webfont requests while the parser is still in the
// head so text is laid out with the brand font instead of reflowing once the
// font arrives. crossorigin matches the CORS mode of font-face requests.
templ FontPreloads(brand branding.Brand) {
	<link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={ templ.SafeURL(brand.Assets.PrimaryFont) }/>
	<link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={ templ.SafeURL(brand.Assets.PrimaryFontItalic) }/>
	<link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={ templ.SafeURL(brand.Assets.DataFont) }/>
}

templ Footer(brand branding.Brand) {
	<footer class="border-t border-base-300 bg-base-200">
		<div class="page-shell flex flex-col gap-1 py-6 text-sm text-base-content/70 sm:flex-row sm:items-center sm:justify-between">
			<p><span class="brand-wordmark text-base-content">{ brand.Name }</span> · Open-source LFG for LAN events.</p>
			<p>{ brand.Tagline }</p>
		</div>
	</footer>
}

func navigationLinkClass(active bool) string {
	if active {
		return "app-navigation-link app-navigation-link-active"
	}
	return "app-navigation-link"
}

func navigationCurrent(active bool) string {
	if active {
		return "page"
	}
	return "false"
}

func ViewerInitial(name string) string {
	name = strings.TrimSpace(name)
	if name == "" {
		return "?"
	}
	runeValue, _ := utf8.DecodeRuneInString(name)
	return strings.ToUpper(string(runeValue))
}

func viewerRole(role string) string {
	if role == "admin" {
		return "Organizer"
	}
	return "Player"
}
