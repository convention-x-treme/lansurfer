package pages

import (
	"github.com/convention-x-treme/lansurfer/internal/gamerequest"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

type SessionInformationForm struct { Mode, EntryID, Key, Value, Error, ErrorField string }
type SessionInformationView struct { RequestID string; Entries []gamerequest.SessionInformationEntry; CanEdit, JoinRequired, Visible bool; Form *SessionInformationForm }

templ GameRequestSessionInformation(view SessionInformationView) {
	if view.Visible {
		<div id="session-information" class="session-information" data-session-information data-refresh-url={ sessionInfoRefreshURL(view) }>
			<div class="session-information-heading">
				<h2 id="session-information-title" class="text-[1.0625rem] font-semibold">Session information</h2>
				if view.CanEdit && view.Form == nil {
					<a class="btn btn-quiet btn-xs" href={ "/game-requests/" + view.RequestID + "?session_add=1" } hx-get={ "/game-requests/" + view.RequestID + "/session-information?session_add=1" } hx-target="#session-information" hx-swap="outerHTML">Add</a>
				}
			</div>
			if view.JoinRequired {
				<p class="session-information-empty mt-2 text-sm text-base-content/70">Join this Game Request to see session information.</p>
			} else {
				if len(view.Entries) > 0 {
					<ul class="session-information-tiles" aria-label="Session information entries">
						for _, entry := range view.Entries {
							<li class="session-information-tile">
								<strong class="session-information-key">{ entry.Key }</strong>
								<span class="session-information-value">{ entry.Value }</span>
								if view.CanEdit {
									<div class="session-information-actions">
										<a class="btn btn-ghost btn-square btn-sm" aria-label={ "Edit " + entry.Key } title={ "Edit " + entry.Key } href={ "/game-requests/" + view.RequestID + "?session_edit=" + entry.ID } hx-get={ "/game-requests/" + view.RequestID + "/session-information?session_edit=" + entry.ID } hx-target="#session-information" hx-swap="outerHTML"><i class="ph ph-pencil-simple" aria-hidden="true"></i></a>
										<form method="post" action={ "/game-requests/" + view.RequestID + "/session-information/" + entry.ID + "/delete" } hx-post={ "/game-requests/" + view.RequestID + "/session-information/" + entry.ID + "/delete" } hx-target="#session-information" hx-swap="outerHTML" data-confirm="Delete this session information?">
											@components.CSRFInput()
											<button class="btn btn-ghost btn-square btn-sm" aria-label={ "Delete " + entry.Key } title={ "Delete " + entry.Key } type="submit"><i class="ph ph-trash" aria-hidden="true"></i></button>
										</form>
									</div>
								}
							</li>
						}
					</ul>
				} else {
					<p class="session-information-empty mt-2 text-sm text-base-content/70">No session information yet.</p>
				}
				if view.Form != nil {
					<form class="session-information-form" data-session-information-form data-session-mode={ view.Form.Mode } data-session-entry-id={ view.Form.EntryID } method="post" action={ sessionFormAction(view) } hx-post={ sessionFormAction(view) } hx-target="#session-information" hx-swap="outerHTML">
						@components.CSRFInput()
						<label>Key<input class="input input-bordered w-full" name="key" value={ view.Form.Key } required aria-invalid={ sessionInformationInvalid(view.Form.ErrorField, "key") } aria-describedby="session-information-error"/></label>
						<label>Value<input class="input input-bordered w-full" name="value" value={ view.Form.Value } required aria-invalid={ sessionInformationInvalid(view.Form.ErrorField, "value") } aria-describedby="session-information-error"/></label>
						<p id="session-information-error" role="alert" class="text-sm text-error">{ view.Form.Error }</p>
						<div class="session-information-form-actions"><button class="btn btn-primary btn-sm" type="submit">Save</button><a class="btn btn-quiet btn-sm" href={ "/game-requests/" + view.RequestID } hx-get={ "/game-requests/" + view.RequestID + "/session-information" } hx-target="#session-information" hx-swap="outerHTML">Cancel</a></div>
					</form>
				}
			}
		</div>
	}
}

func sessionInfoRefreshURL(view SessionInformationView) string {
	url := "/game-requests/" + view.RequestID + "/session-information"
	if view.Form == nil { return url }
	if view.Form.Mode == "add" { return url + "?session_add=1" }
	if view.Form.Mode == "edit" { return url + "?session_edit=" + view.Form.EntryID }
	return url
}

func sessionFormAction(view SessionInformationView) string { if view.Form != nil && view.Form.Mode == "edit" { return "/game-requests/" + view.RequestID + "/session-information/" + view.Form.EntryID }; return "/game-requests/" + view.RequestID + "/session-information" }
func sessionInformationInvalid(errorField, field string) string { if errorField == field { return "true" }; return "false" }
