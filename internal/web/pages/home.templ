package pages

import (
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

templ Home(brand branding.Brand, navigation components.NavigationState) {
	@components.Layout(brand, "Home", navigation) {
		<section class="hero-waterline border-b border-base-300">
			<div class="page-shell grid min-h-[28rem] items-center gap-10 py-16 lg:grid-cols-[1.2fr_0.8fr]">
				<div>
					if navigation.Viewer != nil {
						<div class="badge badge-outline badge-primary mb-5">Signed in as { navigation.Viewer.DisplayName }</div>
					} else {
						<div class="badge badge-outline badge-primary mb-5">Ready to find your next game</div>
					}
					<h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">Find the people who want to play the same game.</h1>
					<p class="mt-6 max-w-2xl text-lg leading-relaxed text-base-content/75">{ brand.Tagline } LANsurfer brings server-rendered, mobile-friendly game discovery to the event floor.</p>
					<div class="mt-8 flex flex-wrap gap-3">
						if navigation.Viewer == nil && navigation.LoginAvailable {
							<a class="btn btn-primary" href="/auth/login">Log in to LANsurfer</a>
						} else if navigation.Viewer != nil {
							<a class="btn btn-primary" href="/game-requests">Browse Game Requests</a>
							<a class="btn btn-outline" href="/game-requests/new">Create Game Request</a>
						} else {
							<a class="btn btn-primary" href="#how-it-works">See how it works</a>
						}
					</div>
				</div>
				<div class="card border border-base-300 bg-base-200 shadow-xl">
					<div class="card-body gap-5">
						<p class="data-text text-sm font-semibold uppercase tracking-widest text-secondary">Built for the LAN</p>
						<h2 class="card-title text-2xl">From “anyone up for it?” to a full group</h2>
						<p class="text-base-content/75">See who is looking for players right now, join with one tap, and watch the player count update live.</p>
						if navigation.Viewer != nil {
							<a class="btn btn-primary" href="/game-requests">Find a group</a>
						} else if navigation.LoginAvailable {
							<a class="btn btn-primary" href="/auth/login">Log in to find a group</a>
						}
					</div>
				</div>
			</div>
		</section>

		<section id="how-it-works" class="page-shell py-16" aria-labelledby="how-it-works-title">
			<div class="max-w-2xl"><p class="data-text text-sm font-semibold uppercase tracking-widest text-secondary">Three quick steps</p><h2 id="how-it-works-title" class="mt-2 text-3xl font-bold">Get a group together</h2></div>
			<ol class="mt-8 grid gap-4 md:grid-cols-3">
				<li class="card border border-base-300 bg-base-200"><div class="card-body"><span class="badge badge-primary data-text">1</span><h3 class="card-title">Follow your games</h3><p class="text-base-content/75">Keep the games you care about close at hand.</p></div></li>
				<li class="card border border-base-300 bg-base-200"><div class="card-body"><span class="badge badge-primary data-text">2</span><h3 class="card-title">Find players</h3><p class="text-base-content/75">Create a Game Request now or schedule it for later.</p></div></li>
				<li class="card border border-base-300 bg-base-200"><div class="card-body"><span class="badge badge-primary data-text">3</span><h3 class="card-title">Join and play</h3><p class="text-base-content/75">Join a request and see the group update live.</p></div></li>
			</ol>
		</section>
	}
}
