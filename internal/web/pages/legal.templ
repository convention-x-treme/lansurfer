package pages

import (
	"context"
	"fmt"
	"io"
	"strconv"

	"github.com/convention-x-treme/lansurfer/internal/platform/legal"
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
	webmiddleware "github.com/convention-x-treme/lansurfer/internal/web/middleware"
	"github.com/yuin/goldmark"
)

// LegalTitle is the heading of each legal document.
func LegalTitle(kind legal.Kind) string {
	switch kind {
	case legal.Terms:
		return "Terms of Service"
	case legal.Privacy:
		return "Privacy Policy"
	default:
		return "Imprint"
	}
}

// legalMarkdown renders administrator Markdown with goldmark's defaults: raw
// HTML is omitted and dangerous link schemes (javascript:, …) are dropped, so
// a legal text cannot inject markup or script into the page.
func legalMarkdown(body string) templ.Component {
	return templ.ComponentFunc(func(_ context.Context, w io.Writer) error {
		return goldmark.Convert([]byte(body), w)
	})
}

// legalProse styles rendered Markdown, which carries no classes of its own.
const legalProse = "grid gap-4 [&_h1]:mt-4 [&_h1]:text-2xl [&_h1]:font-bold [&_h2]:mt-4 [&_h2]:text-xl [&_h2]:font-bold [&_h3]:mt-2 [&_h3]:font-bold [&_p]:text-base-content/80 [&_ul]:grid [&_ul]:list-disc [&_ul]:gap-1 [&_ul]:pl-6 [&_ul]:text-base-content/80 [&_ol]:grid [&_ol]:list-decimal [&_ol]:gap-1 [&_ol]:pl-6 [&_ol]:text-base-content/80 [&_a]:underline [&_a]:underline-offset-2"

templ LegalDocument(brand branding.Brand, navigation components.NavigationState, document legal.Document) {
	@components.Layout(brand, LegalTitle(document.Kind), navigation) {
		<div class="page-shell py-10">
			<article class="grid max-w-3xl gap-6">
				<header>
					<h1 class="text-3xl font-black tracking-tight">{ LegalTitle(document.Kind) }</h1>
					<p class="mt-2 text-sm">Last updated: { document.UpdatedAt.Format("2 January 2006") }</p>
				</header>
				if document.Sample {
					<div role="note" class="alert alert-warning">
						<span>This is LANsurfer's sample text. The operator of this instance has not adapted it yet, so it does not describe this installation.</span>
					</div>
				}
				<div class={ legalProse }>
					@legalMarkdown(document.Body)
				</div>
			</article>
		</div>
	}
}

// AdminLegalForm is one document's editor state; Error and the submitted
// Body come back when a save is rejected.
type AdminLegalForm struct {
	Document legal.Document
	Error    string
}

templ AdminLegal(brand branding.Brand, navigation components.NavigationState, forms []AdminLegalForm, notice components.Notice) {
	@components.Layout(brand, "Legal texts", navigation) {
		<header class="app-topbar">
			<div class="min-w-0">
				<h1 class="app-title">Legal texts</h1>
				<p class="text-sm text-base-content/70">The Terms of Service, Privacy Policy, and Imprint this instance publishes, written in Markdown. Raw HTML is not rendered.</p>
			</div>
		</header>
		<div class="content-page grid gap-6">
			@components.NoticeAlert(notice, "max-w-4xl")
			for _, form := range forms {
				<section id={ string(form.Document.Kind) } class="detail-card grid max-w-4xl gap-3">
					<div class="flex flex-wrap items-center gap-2">
						<h2 class="text-[1.0625rem] font-semibold">{ LegalTitle(form.Document.Kind) }</h2>
						if form.Document.Sample {
							<span class="badge badge-warning">Sample text</span>
						}
						if form.Document.Kind != legal.Imprint || webmiddleware.ImprintEnabled(ctx) {
							<a class="link ml-auto text-sm" href={ templ.SafeURL("/" + string(form.Document.Kind)) }>View public page</a>
						}
					</div>
					if form.Document.Sample {
						<p class="text-sm">Still LANsurfer's generic sample: replace every bracketed placeholder with this installation's facts and have the text legally reviewed. Until you save it, the public page says it is a sample.</p>
					}
					if form.Document.Kind == legal.Imprint && !webmiddleware.ImprintEnabled(ctx) {
						<p class="text-sm text-base-content/70">Not published. Set <code>LANSURFER_IMPRINT_ENABLED=true</code> to serve it at <code>/imprint</code> and link it from the footer.</p>
					}
					if form.Error != "" {
						<div role="alert" class="alert alert-error"><span>{ form.Error }</span></div>
					}
					<form method="post" action={ templ.SafeURL("/admin/legal/" + string(form.Document.Kind)) } class="grid gap-3">
						@components.CSRFInput()
						<label class="sr-only" for={ "legal-" + string(form.Document.Kind) }>{ LegalTitle(form.Document.Kind) } Markdown</label>
						<textarea id={ "legal-" + string(form.Document.Kind) } name="body" class="textarea data-text h-96 w-full" required maxlength={ legalMaxLength } spellcheck="true" aria-describedby={ "legal-" + string(form.Document.Kind) + "-limit" }>{ form.Document.Body }</textarea>
						<div class="flex items-center justify-between gap-3">
							<p id={ "legal-" + string(form.Document.Kind) + "-limit" } class="text-sm text-base-content/70">Up to { legalMaxLengthLabel } characters.</p>
							<button class="btn btn-primary btn-sm" type="submit">Save { LegalTitle(form.Document.Kind) }</button>
						</div>
					</form>
				</section>
			}
		</div>
	}
}

var legalMaxLength = strconv.Itoa(legal.MaxBodyLength)

// legalMaxLengthLabel groups thousands for display, e.g. "20,000".
// ponytail: valid for 1,000–999,999; MaxBodyLength sits well inside.
var legalMaxLengthLabel = fmt.Sprintf("%d,%03d", legal.MaxBodyLength/1000, legal.MaxBodyLength%1000)
