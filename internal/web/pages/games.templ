package pages

import (
	"fmt"

	"github.com/convention-x-treme/lansurfer/internal/game"
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

// GameCatalog is the discovery-first Games page (spec: "2.1 Games is
// discovery-first"). It never asks a player to first understand whether a
// Game is already an authoritative local Game or still exists only in the
// synchronized IGDB index.
templ GameCatalog(brand branding.Brand, navigation components.NavigationState, page game.DiscoveryPage, search, message string) {
	@components.Layout(brand, "Games", navigation) {
		<header class="app-topbar">
			<h1 class="app-title">Games</h1>
			<a class="btn btn-quiet btn-sm" href="/games/mine">My Games</a>
		</header>
		<div class="content-page">
			@GameSearchForm(search)
			@GameCatalogResults(page, search, message, navigation.Viewer)
		</div>
	}
}

// GameSearchForm live-searches as the player types (spec: "3.2 Live
// search"): it debounces briefly, drops a stale in-flight search so it
// cannot land after a newer one, and replaces the URL rather than pushing a
// history entry for every pause. The plain GET submit button is the
// no-JavaScript fallback.
templ GameSearchForm(search string) {
	<form
		class="request-toolbar"
		method="get"
		action="/games"
		hx-get="/games"
		hx-target="#game-catalog-results"
		hx-swap="outerHTML"
		hx-sync="this:replace"
		hx-replace-url="true"
		hx-trigger="submit, input changed delay:300ms from:(#game-search), search from:(#game-search)"
	>
		<label class="sr-only" for="game-search">Search by game name or alias</label>
		<input id="game-search" class="input input-sm request-search" type="search" name="q" value={ search } maxlength="120" placeholder="Search by name or alias, e.g. wc3" autocomplete="off"/>
		<button class="btn btn-quiet btn-sm" type="submit">Search</button>
		if search != "" {
			<a class="btn btn-ghost btn-sm" href="/games">Clear</a>
		}
	</form>
}

// GameCatalogResults renders every player-visible state of one Browse page:
// the too-short-search hint, the no-search discovery state (the local
// catalog plus provider availability), and the >=2-character search-result
// state. It is the htmx live-search swap target, so it alone must carry
// enough of the page to stay correct after a fragment swap.
templ GameCatalogResults(page game.DiscoveryPage, search, message string, viewer *components.Viewer) {
	<div id="game-catalog-results" aria-live="polite">
		if message != "" {
			<div role="alert" class="alert alert-error mb-4"><span>{ message }</span></div>
		}
		if search == "" {
			<div class="mb-6">
				<h2 class="text-[1.0625rem] font-semibold">Find your game</h2>
				<p class="text-sm text-base-content/70">Search the game catalog to follow something you play or start a Game Request.</p>
			</div>
		}
		@GameDiscoveryState(page, search, viewer, GameCatalogCards(page.Items, search == "" || page.SearchTooShort))
	</div>
}

// GameDiscoveryList renders the no-search discovery state. A one-character
// search takes this same path (Browse returns the full unfiltered local
// list alongside SearchTooShort=true), so the "Games on this LAN" heading
// above the list -- distinct from a search-result heading -- is what keeps
// that state unambiguous rather than looking like a filtered result.
templ GameCatalogCards(items []game.DiscoveryItem, showLANHeading bool) {
	if showLANHeading {
		<section>
			<p class="section-label mb-2">Games on this LAN</p>
			<div class="game-grid">
				for _, item := range items {
					@GameCard(item)
				}
			</div>
		</section>
	} else {
		<div class="game-grid">
			for _, item := range items {
				@GameCard(item)
			}
		</div>
	}
}

// GameCatalogAvailability is the provider readiness/no-catalog state (spec:
// "8. Provider availability states"). It only ever appears when there are
// no local Games to show instead, and a catalog that has ever completed a
// baseline (CatalogAvailable) never shows a failure/readiness warning to an
// ordinary player -- only an administrator gets a route into the relevant
// administration surface.
templ GameCatalogAvailability(status game.ProviderStatus, viewer *components.Viewer) {
	if !status.CatalogAvailable {
		if status.State == game.ProviderNotSynced || status.State == game.ProviderSyncing {
			<section class="detail-card">
				<h2 class="text-[1.0625rem] font-semibold">Game discovery is getting ready.</h2>
			</section>
		} else {
			<section class="detail-card">
				<h2 class="text-[1.0625rem] font-semibold">No games are available yet.</h2>
				if viewer != nil && viewer.Role == "admin" {
					<a class="btn btn-quiet btn-sm self-start" href="/admin/igdb">Open IGDB synchronization</a>
				}
			</section>
		}
	}
}

// GameSearchResults renders a >=2-character search: an explicit truncation
// hint when the repository signaled more rows exist than the bounded page
// shows (spec: "3.5 Result limit"), the matching unified cards, or a
// no-results state naming the query.
// GameCard is the one player-facing card shared by materialized and
// unmaterialized discovery results (spec: "4.1 One player-facing Game
// card"). It never renders materialization origin, provider-record
// terminology, or a Local/IGDB badge.
templ GameCard(item game.DiscoveryItem) {
	<article class="game-card">
		@GameIdentity(item.GamePresentation, false)
		<div class="mt-auto flex flex-wrap items-center justify-end gap-2">
			<a class="btn btn-quiet btn-sm" href={ gameRequestAction(item) }>Find Players</a>
			@GameCardFollowControl(item)
		</div>
	</article>
}

// GameCardFollowControl branches on item.LocalGameID, never on item.Reference:
// a materialized row's Reference is not reliably populated by the
// underlying query, but LocalGameID is. An unmaterialized item (LocalGameID
// empty) always has a reliable Reference, since only materialized rows are
// affected. The provider follow form's htmx target stays "this" (the form
// itself) rather than the whole card, so a successful follow swaps in only
// the small GameFollowControl fragment and the richer cover/metadata card
// around it is never replaced by a poorer local re-render.
templ GameCardFollowControl(item game.DiscoveryItem) {
	if item.Subscribed {
		<div class="flex items-center gap-2">
			<span class="status-chip status-chip-joined">Following</span>
			if item.LocalGameID != "" {
				<form method="post" action={ "/games/" + item.LocalGameID + "/unfollow" } hx-post={ "/games/" + item.LocalGameID + "/unfollow" } hx-target="closest div" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button">
					@components.CSRFInput()
					<button class="btn btn-step-back btn-sm" type="submit">Unfollow</button>
				</form>
			}
		</div>
	} else if item.LocalGameID != "" {
		<form method="post" action={ "/games/" + item.LocalGameID + "/follow" } hx-post={ "/games/" + item.LocalGameID + "/follow" } hx-target="this" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button">
			@components.CSRFInput()
			<button class="btn btn-primary btn-sm" type="submit">Follow Game</button>
		</form>
	} else {
		<form method="post" action={ providerFollowAction(item.Reference) } hx-post={ providerFollowAction(item.Reference) } hx-target="this" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button">
			@components.CSRFInput()
			<button class="btn btn-primary btn-sm" type="submit">Follow Game</button>
		</form>
	}
}

templ MyGames(brand branding.Brand, navigation components.NavigationState, games []game.SubscriptionGame) {
	@components.Layout(brand, "My Games", navigation) {
		<header class="app-topbar">
			<h1 class="app-title">My Games</h1>
			<a class="btn btn-primary btn-sm" href="/games">Browse games</a>
		</header>
		<div class="content-page">
			<div class="mb-2 flex items-center justify-between gap-4">
				<p class="section-label">{ followedCountLabel(len(games)) }</p>
			</div>
			<div class="game-grid" aria-live="polite">
				if len(games) == 0 {
					<section class="detail-card">
						<h2 class="text-[1.0625rem] font-semibold">You are not following any games yet</h2>
						<p class="text-sm text-base-content/70">Browse the catalog and follow the games you would like to play.</p>
						<a class="btn btn-primary btn-sm self-start" href="/games">Browse games</a>
					</section>
				}
				for _, item := range games {
					@GameSubscriptionCard(item, true)
				}
			</div>
		</div>
	}
}

templ GameSubscriptionCard(item game.SubscriptionGame, myGames bool) {
	<article class="game-card">
		@GameIdentity(item.GamePresentation, false)
		<div class="mt-auto flex flex-wrap items-center justify-end gap-2">
			if item.Subscribed {
				<a class="btn btn-quiet btn-sm" href={ "/game-requests/new?game_id=" + item.ID }>Find Players</a>
			}
			@GameFollowControl(item.ID, item.Subscribed, myGames)
		</div>
	</article>
}

templ GameFollowControl(gameID string, subscribed, myGames bool) {
	if subscribed && myGames {
		<div class="flex items-center gap-2">
			<span class="status-chip status-chip-joined">Following</span>
			<form method="post" action={ "/games/" + gameID + "/unfollow" } hx-post={ "/games/" + gameID + "/unfollow" } hx-target="closest article" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button">
				@components.CSRFInput()
				<input type="hidden" name="view" value="mine"/>
				<button class="btn btn-step-back btn-sm" type="submit">Unfollow</button>
			</form>
		</div>
	} else if subscribed {
		<div class="flex items-center gap-2">
			<span class="status-chip status-chip-joined">Following</span>
			<form method="post" action={ "/games/" + gameID + "/unfollow" } hx-post={ "/games/" + gameID + "/unfollow" } hx-target="closest div" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button">
				@components.CSRFInput()
				<button class="btn btn-step-back btn-sm" type="submit">Unfollow</button>
			</form>
		</div>
	} else {
		<form method="post" action={ "/games/" + gameID + "/follow" } hx-post={ "/games/" + gameID + "/follow" } hx-target="this" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button">
			@components.CSRFInput()
			<button class="btn btn-primary btn-sm" type="submit">Follow Game</button>
		</form>
	}
}

templ GameCatalogError(brand branding.Brand, navigation components.NavigationState) {
	@components.Layout(brand, "Games unavailable", navigation) {
		<header class="app-topbar">
			<h1 class="app-title">Games</h1>
			<a class="btn btn-primary btn-sm" href="/games">Retry</a>
		</header>
		<div class="content-page">
			<div role="alert" class="alert alert-error"><div><p class="font-bold">Games could not be loaded</p><p>Try the request again.</p></div></div>
		</div>
	}
}

func followedCountLabel(count int) string {
	if count == 1 {
		return "1 game followed"
	}
	return fmt.Sprintf("%d games followed", count)
}

// providerFollowAction builds the provider-follow route from only the
// opaque provider reference already carried on the DiscoveryItem (never
// browser input): provider is always "igdb" in this codebase, and external
// ID is the provider's numeric identity. No other provider metadata is
// included in the request.
func providerFollowAction(ref game.ProviderReference) string {
	return "/games/providers/" + ref.Provider + "/" + ref.ExternalID + "/follow"
}

// gameRequestAction builds the "Find Players" link for one discovery item.
// It branches on LocalGameID rather than Materialized/Reference: an
// already-materialized row reliably carries LocalGameID, while its
// Reference is not always reliably populated by the underlying query. An
// unmaterialized item (LocalGameID empty) always has a reliable Reference,
// carrying only the opaque provider reference (never a name/slug) so the
// create-request handler resolves/materializes the authoritative local Game
// itself.
func gameRequestAction(item game.DiscoveryItem) string {
	return "/game-requests/new?" + gameRequestSelectionQuery(item)
}
