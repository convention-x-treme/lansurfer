package pages

import (
	"strconv"
	"strings"

	"github.com/convention-x-treme/lansurfer/internal/game"
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

templ GameCatalog(brand branding.Brand, navigation components.NavigationState, games []game.DiscoveryItem, search, message string) {
	@components.Layout(brand, "Games", navigation) {
		<section class="page-shell py-10">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div>
					<p class="data-text text-sm font-semibold uppercase tracking-widest text-secondary">Game catalog</p>
					<h1 class="mt-2 text-3xl font-bold">Find your games</h1>
					<p class="mt-2 text-base-content/70">Follow games you are interested in so LANsurfer can personalize what you see.</p>
				</div>
				<a class="btn btn-outline" href="/games/mine">My Games</a>
			</div>
			<form method="get" action="/games" class="mt-8 flex flex-col gap-3 sm:flex-row" hx-get="/games" hx-target="#game-catalog-results" hx-swap="outerHTML" hx-push-url="true">
				<label class="sr-only" for="game-search">Search by game name or alias</label>
				<input id="game-search" class="input input-bordered min-w-0 flex-1" type="search" name="q" value={ search } maxlength="120" placeholder="Search by name or alias, e.g. wc3"/>
				<div class="flex gap-2"><a class="btn btn-ghost" href="/games">Clear</a><button class="btn btn-primary" type="submit">Search</button></div>
			</form>
			<div class="mt-8">
				@GameCatalogResults(games, search, message)
			</div>
		</section>
	}
}

templ GameCatalogResults(games []game.DiscoveryItem, search, message string) {
	<div id="game-catalog-results" aria-live="polite">
		if message != "" {
			<div role="alert" class="alert alert-error mb-5"><span>{ message }</span></div>
		}
		if len(games) == 0 {
			<div class="card border border-base-300 bg-base-200"><div class="card-body"><h2 class="card-title">No games found</h2>
				if search == "" {
					<p>There are no active games in the catalog yet.</p>
				} else {
					<p>Try a different game name or alias.</p>
				}
			</div></div>
		}
		<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
			for _, item := range games {
				@GameDiscoveryCard(item)
			}
		</div>
	</div>
}

// GameDiscoveryCard renders one Browse result. A materialized item is
// already an authoritative local Game, so it renders with the usual
// follow/unfollow controls. An unmaterialized provider item is read-only
// display in this task: name plus type/platform/release disambiguation and
// a remote cover derived only from CoverImageID. No provider name, slug, or
// other metadata is ever posted back to the server from this card; only the
// opaque provider reference could ever be used for a future action.
templ GameDiscoveryCard(item game.DiscoveryItem) {
	if item.Materialized {
		@GameSubscriptionCard(game.SubscriptionGame{ID: item.LocalGameID, Name: item.Name, Slug: item.Slug, Subscribed: item.Subscribed}, false)
	} else {
		@ProviderDiscoveryCard(item)
	}
}

templ ProviderDiscoveryCard(item game.DiscoveryItem) {
	<article class="card border border-base-300 bg-base-200 shadow-sm">
		<div class="card-body">
			<div class="flex gap-4">
				if item.CoverImageID != "" {
					<img class="h-24 w-16 flex-none rounded object-cover bg-base-300" src={ providerCoverURL(item.CoverImageID) } alt="" referrerpolicy="no-referrer" loading="lazy"/>
				}
				<div class="min-w-0">
					<h2 class="card-title text-2xl">{ item.Name }</h2>
					<p class="data-text mt-1 text-sm text-base-content/60">{ providerDisambiguation(item) }</p>
					<span class="badge badge-ghost mt-2">Not yet in LANsurfer catalog</span>
				</div>
			</div>
		</div>
	</article>
}

templ MyGames(brand branding.Brand, navigation components.NavigationState, games []game.SubscriptionGame) {
	@components.Layout(brand, "My Games", navigation) {
		<section class="page-shell py-10">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div><p class="data-text text-sm font-semibold uppercase tracking-widest text-secondary">Personalized games</p><h1 class="mt-2 text-3xl font-bold">My Games</h1><p class="mt-2 text-base-content/70">Games you follow appear here.</p></div>
				<a class="btn btn-primary" href="/games">Browse games</a>
			</div>
			<div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3" aria-live="polite">
				if len(games) == 0 {
					<div class="card border border-base-300 bg-base-200 sm:col-span-2"><div class="card-body"><h2 class="card-title">You are not following any games yet</h2><p>Browse the catalog and follow the games you would like to play.</p><div class="card-actions"><a class="btn btn-primary btn-sm" href="/games">Browse games</a></div></div></div>
				}
				for _, item := range games {
					@GameSubscriptionCard(item, true)
				}
			</div>
		</section>
	}
}

templ GameSubscriptionCard(item game.SubscriptionGame, myGames bool) {
	<article class="card border border-base-300 bg-base-200 shadow-sm">
		<div class="card-body"><div><h2 class="card-title text-2xl">{ item.Name }</h2><p class="data-text mt-1 text-sm text-base-content/60">{ item.Slug }</p></div><div class="card-actions mt-3 justify-end">
			if item.Subscribed {
				<a class="btn btn-primary btn-sm" href={ "/game-requests/new?game_id=" + item.ID }>Find Players</a>
			}
			@GameFollowControl(item.ID, item.Subscribed, myGames)
		</div></div>
	</article>
}

templ GameFollowControl(gameID string, subscribed, myGames bool) {
	if subscribed && myGames {
		<div class="flex items-center gap-2">
			<span class="badge badge-primary">Following</span>
			<form method="post" action={ "/games/" + gameID + "/unfollow" } hx-post={ "/games/" + gameID + "/unfollow" } hx-target="closest article" hx-swap="outerHTML">
				@components.CSRFInput()
				<input type="hidden" name="view" value="mine"/>
				<button class="btn btn-outline btn-sm" type="submit">Unfollow</button>
			</form>
		</div>
	} else if subscribed {
		<div class="flex items-center gap-2">
			<span class="badge badge-primary">Following</span>
			<form method="post" action={ "/games/" + gameID + "/unfollow" } hx-post={ "/games/" + gameID + "/unfollow" } hx-target="closest div" hx-swap="outerHTML">
				@components.CSRFInput()
				<button class="btn btn-outline btn-sm" type="submit">Unfollow</button>
			</form>
		</div>
	} else {
		<form method="post" action={ "/games/" + gameID + "/follow" } hx-post={ "/games/" + gameID + "/follow" } hx-target="this" hx-swap="outerHTML">
			@components.CSRFInput()
			<button class="btn btn-primary btn-sm" type="submit">Follow Game</button>
		</form>
	}
}

templ GameCatalogError(brand branding.Brand, navigation components.NavigationState) {
	@components.Layout(brand, "Games unavailable", navigation) {
		<section class="page-shell py-16"><div role="alert" class="alert alert-error"><div><h1 class="font-bold">Games could not be loaded</h1><p>Try the request again.</p></div></div></section>
	}
}

// providerCoverURL constructs the approved images.igdb.com cover URL from
// only the persisted cover_image_id (spec: "Covers"). It never accepts or
// echoes any other provider-supplied metadata; the CSP img-src allowlist and
// Referrer-Policy: no-referrer safeguards live in internal/web/middleware.
func providerCoverURL(coverImageID string) string {
	return "https://images.igdb.com/igdb/image/upload/t_cover_small/" + coverImageID + ".jpg"
}

// providerDisambiguation renders type/platform/release context so provider
// search results without a unique display name can still be told apart
// (spec: "Local Game name uniqueness must change").
func providerDisambiguation(item game.DiscoveryItem) string {
	parts := make([]string, 0, 3)
	if item.GameType != "" {
		parts = append(parts, item.GameType)
	}
	if len(item.PlatformNames) > 0 {
		parts = append(parts, strings.Join(item.PlatformNames, ", "))
	}
	if item.FirstReleaseDate != nil {
		parts = append(parts, strconv.Itoa(item.FirstReleaseDate.Year()))
	}
	return strings.Join(parts, " · ")
}
