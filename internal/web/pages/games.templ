package pages

import (
	"fmt"
	"net/url"

	"github.com/convention-x-treme/lansurfer/internal/game"
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

// GameCatalog is the single Games screen (spec: "2.1 Games is
// discovery-first"). It never asks a player to first understand whether a
// Game is already an authoritative local Game or still exists only in the
// synchronized IGDB index, and it is also the only Games screen: what used
// to be a separate "My Games" page is the "Followed only" filter here, so a
// player narrows one catalog instead of navigating between two lists that
// showed the same cards.
templ GameCatalog(brand branding.Brand, navigation components.NavigationState, page game.DiscoveryPage, search string, followedOnly bool, message string) {
	@components.Layout(brand, "Games", navigation) {
		<header class="app-topbar">
			<h1 class="app-title sr-only">Games</h1>
			@GameSearchForm(search, followedOnly)
			<a class="btn btn-primary btn-sm" href="/game-requests/new">Create Game Request</a>
		</header>
		<div class="content-page">
			@GameCatalogResults(brand, page, search, followedOnly, message, navigation.Viewer)
		</div>
	}
}

// GameSearchForm lives in the top bar and applies itself: there is no Search
// button to press and no Clear button to find, because both states the
// buttons produced are already one keystroke or one click away in the
// controls themselves.
//
// Typing live-searches (spec: "3.2 Live search") -- it debounces briefly so
// a pause rather than a keystroke issues the request, drops a stale
// in-flight search so it cannot land after a newer one, and replaces the URL
// rather than pushing a history entry per pause. Ticking "Followed only"
// applies immediately for the same reason.
//
// Without scripting the form still submits: this is a GET form with one
// text field, so Enter submits it natively, and the noscript button is what
// applies the checkbox, which nothing else would otherwise submit.
templ GameSearchForm(search string, followedOnly bool) {
	<form
		class="topbar-filters"
		method="get"
		action="/games"
		hx-get="/games"
		hx-target="#game-catalog-results"
		hx-swap="outerHTML"
		hx-sync="this:replace"
		hx-replace-url="true"
		hx-trigger="submit, change from:(.filter-toggle input), input changed delay:300ms from:(#game-search), search from:(#game-search)"
	>
		<label class="sr-only" for="game-search">Search by game name or alias</label>
		<input id="game-search" class="input input-sm request-search" type="search" name="q" value={ search } maxlength="120" placeholder="Search by name or alias, e.g. wc3" autocomplete="off"/>
		<label class="filter-toggle"><input class="checkbox checkbox-sm" type="checkbox" name="followed" value="1" checked?={ followedOnly }/><span>Followed only</span></label>
		<noscript><button class="btn btn-quiet btn-sm" type="submit">Apply</button></noscript>
	</form>
}

// GameCatalogResults renders every player-visible state of one Browse page:
// the too-short-search hint, the no-search discovery state (the local
// catalog plus provider availability), and the >=2-character search-result
// state. It is the htmx live-search swap target, so it alone must carry
// enough of the page to stay correct after a fragment swap.
templ GameCatalogResults(brand branding.Brand, page game.DiscoveryPage, search string, followedOnly bool, message string, viewer *components.Viewer) {
	<div id="game-catalog-results" aria-live="polite">
		if message != "" {
			<div role="alert" class="alert alert-error mb-4"><span>{ message }</span></div>
		}
		if len(page.Items) > 0 {
			<p class="section-label mb-2">{ catalogCountLabel(page.Items, followedOnly) }</p>
		}
		@GameDiscoveryState(page, search, viewer, GameCatalogCards(page.Items, followedOnly), GameCatalogEmpty(brand, search, followedOnly))
	</div>
}

// GameCatalogCards is the card grid itself. The "Games on this LAN" heading
// the no-search state used to carry is gone: the count line above the grid
// already says what is being listed, and it says it in every state rather
// than only the unfiltered one.
templ GameCatalogCards(items []game.DiscoveryItem, followedOnly bool) {
	if len(items) > 0 {
		<div class="game-grid">
			for _, item := range items {
				@GameCard(item, followedOnly)
			}
		</div>
	}
}

// GameCatalogEmpty is the Games screen's "nothing to show" panel, in place
// of a bare "0 results". Its three cases are named separately because the
// way out of each differs: an untouched screen on a usable but empty
// catalog invites a search, following nothing yet invites a follow, and a
// search or filter that matched nothing invites widening it.
templ GameCatalogEmpty(brand branding.Brand, search string, followedOnly bool) {
	if search == "" && !followedOnly {
		<section class="detail-card">
			<h2 class="text-[1.0625rem] font-semibold">Find your game</h2>
			<p class="text-sm text-base-content/70">Search the game catalog to follow something you play or start a Game Request.</p>
		</section>
	} else {
		<section class="request-empty" aria-labelledby="empty-games-title">
			<img src={ brand.Assets.Mascot } alt=""/>
			<div>
				if followedOnly && search == "" {
					<h2 id="empty-games-title" class="text-2xl font-bold">You follow nothing yet.</h2>
					<p class="mt-2 max-w-xl text-base-content/70">Follow a game and every new Game Request for it reaches you. That is all following a game does.</p>
					<a class="btn btn-primary btn-sm mt-5" href="/games">Browse every game</a>
				} else {
					<h2 id="empty-games-title" class="text-2xl font-bold">No game matches that.</h2>
					<p class="mt-2 max-w-xl text-base-content/70">Search covers a game's name and its aliases. Try a single word, or clear the filter to search the whole catalog.</p>
					<a class="btn btn-quiet btn-sm mt-5" href="/games">Clear search and filters</a>
				}
			</div>
		</section>
	}
}

// GameCatalogAvailability is the provider readiness/no-catalog state (spec:
// "8. Provider availability states"). It only ever appears when there are
// no local Games to show instead, and a catalog that has ever completed a
// baseline (CatalogAvailable) never shows a failure/readiness warning to an
// ordinary player -- only an administrator gets a route into the relevant
// administration surface.
templ GameCatalogAvailability(status game.ProviderStatus, viewer *components.Viewer) {
	if !status.CatalogAvailable {
		if status.State == game.ProviderNotSynced || status.State == game.ProviderSyncing {
			<section class="detail-card">
				<h2 class="text-[1.0625rem] font-semibold">Game discovery is getting ready.</h2>
			</section>
		} else {
			<section class="detail-card">
				<h2 class="text-[1.0625rem] font-semibold">No games are available yet.</h2>
				if viewer != nil && viewer.Role == "admin" {
					<a class="btn btn-quiet btn-sm self-start" href="/admin/igdb">Open IGDB synchronization</a>
				}
			</section>
		}
	}
}

// GameCard is the one player-facing card shared by materialized and
// unmaterialized discovery results (spec: "4.1 One player-facing Game
// card"). It never renders materialization origin, provider-record
// terminology, or a Local/IGDB badge.
//
// The whole card is the follow control's htmx swap target, because following
// changes the cover tag and the card border as well as the button; swapping
// only the button would leave a card claiming a follow state it no longer
// has. The handler re-reads the item before re-rendering, so the swapped
// card keeps its cover and metadata rather than degrading to a poorer
// re-render.
templ GameCard(item game.DiscoveryItem, followedOnly bool) {
	<article class={ "game-card", templ.KV("game-card-followed", item.Subscribed) }>
		<div class="game-card-cover">
			if item.CoverImageID != "" {
				<img class="game-card-cover-image" src={ providerCoverLargeURL(item.CoverImageID) } alt="" referrerpolicy="no-referrer" loading="lazy" data-cover-fallback="true"/>
				<span class="game-card-cover-fallback" aria-hidden="true" hidden>{ components.GameAbbreviation(item.Name) }</span>
			} else {
				<span class="game-card-cover-fallback" aria-hidden="true">{ components.GameAbbreviation(item.Name) }</span>
			}
			if item.Subscribed {
				<span class="game-card-tag">Following</span>
			}
		</div>
		<div class="game-card-body">
			<div class="flex items-baseline gap-2">
				<h2 class="game-card-name">{ item.Name }</h2>
				<span class="data-text game-card-short" aria-hidden="true">{ components.GameAbbreviation(item.Name) }</span>
			</div>
			<p class="game-card-meta">{ presentationSecondary(item.GamePresentation) }</p>
			<div class="game-card-actions">
				<a class="btn btn-quiet btn-sm" href={ gameRequestAction(item) }>Find Players</a>
				@GameCardFollowControl(item, followedOnly)
			</div>
		</div>
	</article>
}

// GameCardFollowControl branches on item.LocalGameID, never on item.Reference:
// a materialized row's Reference is not reliably populated by the
// underlying query, but LocalGameID is. An unmaterialized item (LocalGameID
// empty) always has a reliable Reference, since only materialized rows are
// affected.
//
// Unfollow is an outline button rather than a destructive one: it costs the
// player nothing they cannot redo in one click, so it never reads as danger.
// The "Following" state itself is named on the cover tag, so the button says
// only what pressing it does.
templ GameCardFollowControl(item game.DiscoveryItem, followedOnly bool) {
	if item.Subscribed && item.LocalGameID != "" {
		<form class="game-card-follow" method="post" action={ "/games/" + item.LocalGameID + "/unfollow" } hx-post={ "/games/" + item.LocalGameID + "/unfollow" } hx-target="closest article" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button">
			@components.CSRFInput()
			@followedViewInput(followedOnly)
			<button class="btn btn-quiet btn-sm" type="submit">Unfollow</button>
		</form>
	} else if item.Subscribed {
		<span class="status-chip status-chip-joined">Following</span>
	} else if item.LocalGameID != "" {
		<form class="game-card-follow" method="post" action={ "/games/" + item.LocalGameID + "/follow" } hx-post={ "/games/" + item.LocalGameID + "/follow" } hx-target="closest article" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button">
			@components.CSRFInput()
			@followedViewInput(followedOnly)
			<button class="btn btn-primary btn-sm" type="submit">Follow Game</button>
		</form>
	} else {
		<form class="game-card-follow" method="post" action={ providerFollowAction(item.Reference) } hx-post={ providerFollowAction(item.Reference) } hx-target="closest article" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button">
			@components.CSRFInput()
			@followedViewInput(followedOnly)
			<button class="btn btn-primary btn-sm" type="submit">Follow Game</button>
		</form>
	}
}

// followedViewInput carries the current screen's filter through a follow or
// unfollow so the no-JavaScript redirect lands back on the list the player
// was actually looking at. The htmx path ignores it and swaps the one card.
templ followedViewInput(followedOnly bool) {
	if followedOnly {
		<input type="hidden" name="followed" value="1"/>
	}
}

templ GameCatalogError(brand branding.Brand, navigation components.NavigationState) {
	@components.Layout(brand, "Games unavailable", navigation) {
		<header class="app-topbar">
			<h1 class="app-title">Games</h1>
			<a class="btn btn-primary btn-sm" href="/games">Retry</a>
		</header>
		<div class="content-page">
			<div role="alert" class="alert alert-error"><div><p class="font-bold">Games could not be loaded</p><p>Try the request again.</p></div></div>
		</div>
	}
}

// catalogCountLabel states what the grid is showing, in the terms the filter
// itself uses. The followed total is counted from the rendered cards rather
// than from the navigation totals, so the line can never disagree with what
// is on screen.
func catalogCountLabel(items []game.DiscoveryItem, followedOnly bool) string {
	if followedOnly {
		if len(items) == 1 {
			return "1 game followed"
		}
		return fmt.Sprintf("%d games followed", len(items))
	}
	followed := 0
	for _, item := range items {
		if item.Subscribed {
			followed++
		}
	}
	noun := "games"
	if len(items) == 1 {
		noun = "game"
	}
	return fmt.Sprintf("%d %s · %d followed", len(items), noun, followed)
}

// providerFollowAction builds the provider-follow route from only the
// opaque provider reference already carried on the DiscoveryItem (never
// browser input): provider is always "igdb" in this codebase, and external
// ID is the provider's numeric identity. No other provider metadata is
// included in the request.
func providerFollowAction(ref game.ProviderReference) string {
	return "/games/providers/" + ref.Provider + "/" + ref.ExternalID + "/follow"
}

// gameRequestAction builds the "Find Players" link for one discovery item.
// It branches on LocalGameID rather than Materialized/Reference: an
// already-materialized row reliably carries LocalGameID, while its
// Reference is not always reliably populated by the underlying query. An
// unmaterialized item (LocalGameID empty) always has a reliable Reference,
// carrying only the opaque provider reference (never a name/slug) so the
// create-request handler resolves/materializes the authoritative local Game
// itself.
func gameRequestAction(item game.DiscoveryItem) string {
	return "/game-requests/new?" + gameRequestSelectionQuery(item)
}

// CatalogURL builds a link back to the Games screen with one filter state,
// so the navigation and the follow redirects all name the same URLs the
// screen itself produces.
func CatalogURL(followedOnly bool) string {
	if !followedOnly {
		return "/games"
	}
	return "/games?" + url.Values{"followed": {"1"}}.Encode()
}
