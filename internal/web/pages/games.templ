package pages

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/convention-x-treme/lansurfer/internal/game"
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

templ GameCatalog(brand branding.Brand, navigation components.NavigationState, games []game.DiscoveryItem, search, message string) {
	@components.Layout(brand, "Games", navigation) {
		<header class="app-topbar">
			<h1 class="app-title">Games</h1>
			<a class="btn btn-quiet btn-sm" href="/games/mine">My Games</a>
		</header>
		<div class="content-page">
			<form class="request-toolbar" method="get" action="/games" hx-get="/games" hx-target="#game-catalog-results" hx-swap="outerHTML" hx-push-url="true">
				<label class="sr-only" for="game-search">Search by game name or alias</label>
				<input id="game-search" class="input input-sm request-search" type="search" name="q" value={ search } maxlength="120" placeholder="Search by name or alias, e.g. wc3"/>
				<button class="btn btn-quiet btn-sm" type="submit">Search</button>
				if search != "" {
					<a class="btn btn-ghost btn-sm" href="/games">Clear</a>
				}
			</form>
			@GameCatalogResults(games, search, message)
		</div>
	}
}

templ GameCatalogResults(games []game.DiscoveryItem, search, message string) {
	<div id="game-catalog-results" aria-live="polite">
		if message != "" {
			<div role="alert" class="alert alert-error mb-4"><span>{ message }</span></div>
		}
		<div class="mb-2 flex items-center justify-between gap-4">
			<p class="section-label">{ gameCountLabel(len(games)) }</p>
		</div>
		if len(games) == 0 {
			<section class="detail-card">
				<h2 class="text-[1.0625rem] font-semibold">No games found</h2>
				if search == "" {
					<p class="text-sm text-base-content/70">There are no active games in the catalog yet.</p>
				} else {
					<p class="text-sm text-base-content/70">Try a different game name or alias.</p>
				}
			</section>
		} else {
			<div class="game-grid">
				for _, item := range games {
					@GameDiscoveryCard(item)
				}
			</div>
		}
	</div>
}

// GameDiscoveryCard renders one Browse result. A materialized item is
// already an authoritative local Game, so it renders with the usual
// follow/unfollow controls. An unmaterialized provider item shows read-only
// display metadata (name plus type/platform/release disambiguation and a
// remote cover derived only from CoverImageID) plus a follow action. No
// provider name, slug, or other metadata is ever posted back to the server
// from this card; only the opaque provider reference (provider + external
// ID) travels, in the follow form's URL path.
templ GameDiscoveryCard(item game.DiscoveryItem) {
	if item.Materialized {
		@GameSubscriptionCard(game.SubscriptionGame{ID: item.LocalGameID, Name: item.Name, Slug: item.Slug, Subscribed: item.Subscribed}, false)
	} else {
		@ProviderDiscoveryCard(item)
	}
}

templ ProviderDiscoveryCard(item game.DiscoveryItem) {
	<article class="game-card">
		<div class="flex items-center gap-3">
			if item.CoverImageID != "" {
				<img class="h-12 w-9 flex-none rounded object-cover bg-base-300" src={ providerCoverURL(item.CoverImageID) } alt="" referrerpolicy="no-referrer" loading="lazy"/>
			} else {
				<span class="game-abbreviation" aria-hidden="true">{ gameAbbreviation(item.Name) }</span>
			}
			<span class="min-w-0">
				<strong class="block truncate text-base font-semibold">{ item.Name }</strong>
				<span class="data-text block truncate text-xs text-base-content/65">{ providerDisambiguation(item) }</span>
			</span>
		</div>
		<div class="mt-auto flex flex-wrap items-center justify-end gap-2">
			<span class="status-chip">Not yet in LANsurfer catalog</span>
			<a class="btn btn-quiet btn-sm" href={ providerGameRequestAction(item.Reference) }>Find Players</a>
			<form method="post" action={ providerFollowAction(item.Reference) } hx-post={ providerFollowAction(item.Reference) } hx-target="this" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button">
				@components.CSRFInput()
				<button class="btn btn-primary btn-sm" type="submit">Follow Game</button>
			</form>
		</div>
	</article>
}

templ MyGames(brand branding.Brand, navigation components.NavigationState, games []game.SubscriptionGame) {
	@components.Layout(brand, "My Games", navigation) {
		<header class="app-topbar">
			<h1 class="app-title">My Games</h1>
			<a class="btn btn-primary btn-sm" href="/games">Browse games</a>
		</header>
		<div class="content-page">
			<div class="mb-2 flex items-center justify-between gap-4">
				<p class="section-label">{ followedCountLabel(len(games)) }</p>
			</div>
			<div class="game-grid" aria-live="polite">
				if len(games) == 0 {
					<section class="detail-card">
						<h2 class="text-[1.0625rem] font-semibold">You are not following any games yet</h2>
						<p class="text-sm text-base-content/70">Browse the catalog and follow the games you would like to play.</p>
						<a class="btn btn-primary btn-sm self-start" href="/games">Browse games</a>
					</section>
				}
				for _, item := range games {
					@GameSubscriptionCard(item, true)
				}
			</div>
		</div>
	}
}

templ GameSubscriptionCard(item game.SubscriptionGame, myGames bool) {
	<article class="game-card">
		<div class="flex items-center gap-3">
			<span class="game-abbreviation" aria-hidden="true">{ gameAbbreviation(item.Name) }</span>
			<span class="min-w-0">
				<strong class="block truncate text-base font-semibold">{ item.Name }</strong>
				<span class="data-text block truncate text-xs text-base-content/65">{ item.Slug }</span>
			</span>
		</div>
		<div class="mt-auto flex flex-wrap items-center justify-end gap-2">
			if item.Subscribed {
				<a class="btn btn-quiet btn-sm" href={ "/game-requests/new?game_id=" + item.ID }>Find Players</a>
			}
			@GameFollowControl(item.ID, item.Subscribed, myGames)
		</div>
	</article>
}

templ GameFollowControl(gameID string, subscribed, myGames bool) {
	if subscribed && myGames {
		<div class="flex items-center gap-2">
			<span class="status-chip status-chip-joined">Following</span>
			<form method="post" action={ "/games/" + gameID + "/unfollow" } hx-post={ "/games/" + gameID + "/unfollow" } hx-target="closest article" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button">
				@components.CSRFInput()
				<input type="hidden" name="view" value="mine"/>
				<button class="btn btn-step-back btn-sm" type="submit">Unfollow</button>
			</form>
		</div>
	} else if subscribed {
		<div class="flex items-center gap-2">
			<span class="status-chip status-chip-joined">Following</span>
			<form method="post" action={ "/games/" + gameID + "/unfollow" } hx-post={ "/games/" + gameID + "/unfollow" } hx-target="closest div" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button">
				@components.CSRFInput()
				<button class="btn btn-step-back btn-sm" type="submit">Unfollow</button>
			</form>
		</div>
	} else {
		<form method="post" action={ "/games/" + gameID + "/follow" } hx-post={ "/games/" + gameID + "/follow" } hx-target="this" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="find button">
			@components.CSRFInput()
			<button class="btn btn-primary btn-sm" type="submit">Follow Game</button>
		</form>
	}
}

templ GameCatalogError(brand branding.Brand, navigation components.NavigationState) {
	@components.Layout(brand, "Games unavailable", navigation) {
		<header class="app-topbar">
			<h1 class="app-title">Games</h1>
			<a class="btn btn-primary btn-sm" href="/games">Retry</a>
		</header>
		<div class="content-page">
			<div role="alert" class="alert alert-error"><div><p class="font-bold">Games could not be loaded</p><p>Try the request again.</p></div></div>
		</div>
	}
}

func followedCountLabel(count int) string {
	if count == 1 {
		return "1 game followed"
	}
	return fmt.Sprintf("%d games followed", count)
}

func gameCountLabel(count int) string {
	if count == 1 {
		return "1 game"
	}
	return fmt.Sprintf("%d games", count)
}

// providerCoverURL constructs the approved images.igdb.com cover URL from
// only the persisted cover_image_id (spec: "Covers"). It never accepts or
// echoes any other provider-supplied metadata; the CSP img-src allowlist and
// Referrer-Policy: no-referrer safeguards live in internal/web/middleware.
func providerCoverURL(coverImageID string) string {
	return "https://images.igdb.com/igdb/image/upload/t_cover_small/" + coverImageID + ".jpg"
}

// providerFollowAction builds the provider-follow route from only the
// opaque provider reference already carried on the DiscoveryItem (never
// browser input): provider is always "igdb" in this codebase, and external
// ID is the provider's numeric identity. No other provider metadata is
// included in the request.
func providerFollowAction(ref game.ProviderReference) string {
	return "/games/providers/" + ref.Provider + "/" + ref.ExternalID + "/follow"
}

// providerGameRequestAction builds the "Find Players" link for an
// unmaterialized provider discovery result, carrying only the opaque
// provider reference (never a name/slug) so the create-request handler
// resolves/materializes the authoritative local Game itself.
func providerGameRequestAction(ref game.ProviderReference) string {
	return "/game-requests/new?provider=" + ref.Provider + "&external_id=" + ref.ExternalID
}

// providerDisambiguation renders type/platform/release context so provider
// search results without a unique display name can still be told apart
// (spec: "Local Game name uniqueness must change").
func providerDisambiguation(item game.DiscoveryItem) string {
	parts := make([]string, 0, 3)
	if item.GameType != "" {
		parts = append(parts, item.GameType)
	}
	if len(item.PlatformNames) > 0 {
		parts = append(parts, strings.Join(item.PlatformNames, ", "))
	}
	if item.FirstReleaseDate != nil {
		parts = append(parts, strconv.Itoa(item.FirstReleaseDate.Year()))
	}
	return strings.Join(parts, " · ")
}
