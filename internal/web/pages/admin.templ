package pages

import (
	"strconv"
	"strings"
	"time"
	"unicode/utf8"

	"github.com/convention-x-treme/lansurfer/internal/game"
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

templ AdminGames(brand branding.Brand, navigation components.NavigationState, games []game.Game, search, formError, notice string) {
	@components.Layout(brand, "Manage Games", navigation) {
		<header class="app-topbar">
			<h1 class="app-title">Manage Games</h1>
			<div class="flex gap-2">
				<a class="btn btn-quiet btn-sm" href="/admin/igdb">IGDB Sync</a>
				<a class="btn btn-quiet btn-sm" href="/admin/pwa">PWA</a>
			</div>
		</header>
		<div class="content-page">
			<p class="mb-5 max-w-2xl text-sm text-base-content/70">Maintain the local games available for Looking for Group. This LANsurfer installation is the event; Game Requests do not need any further setup.</p>
			if formError != "" {
				<div role="alert" class="alert alert-error mb-4"><span>{ formError }</span></div>
			}
			if notice != "" {
				<div role="status" class="alert alert-info mb-4"><span>{ notice }</span></div>
			}
			<form class="request-toolbar" method="get" action="/admin/games">
				<label class="sr-only" for="admin-game-search">Search by game name or alias</label>
				<input id="admin-game-search" class="input input-sm request-search" type="search" name="q" value={ search } maxlength="120" placeholder="Search by name or alias"/>
				<button class="btn btn-quiet btn-sm" type="submit">Search</button>
				if search != "" {
					<a class="btn btn-ghost btn-sm" href="/admin/games">Clear</a>
				}
			</form>
			<div class="grid items-start gap-6 xl:grid-cols-[minmax(18rem,0.55fr)_minmax(0,1.45fr)]">
				<section class="grid gap-2">
					<p class="section-label">Add game</p>
					<form method="post" action="/admin/games" class="detail-card">
						@components.CSRFInput()
						@GameFields("", "")
						<div class="flex justify-end"><button class="btn btn-primary btn-sm" type="submit">Add game</button></div>
					</form>
				</section>
				<section class="grid gap-2">
					<p class="section-label">Catalog games</p>
					<div class="grid gap-3">
						if len(games) == 0 {
							<div class="detail-card"><h2 class="text-[1.0625rem] font-semibold">No games found</h2><p class="text-sm text-base-content/70">Add a game or try a different name or alias.</p></div>
						}
						for _, item := range games {
							@AdminGameCard(item)
						}
					</div>
				</section>
			</div>
		</div>
	}
}

templ AdminGameCard(item game.Game) {
	<article class="game-card">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div><h2 class="text-[1.0625rem] font-semibold">{ item.Name }</h2><p class="data-text text-xs text-base-content/65">{ item.Slug }</p></div>
			if item.Active {
				<span class="status-chip status-chip-open">Active</span>
			} else {
				<span class="status-chip">Inactive</span>
			}
		</div>
		<form method="post" action={ "/admin/games/" + item.ID } class="mt-3 grid gap-4 sm:grid-cols-2">
			@components.CSRFInput()
			@GameFields(item.Name, item.Slug)
			<div class="sm:col-span-2 flex flex-wrap justify-end gap-2">
				<button class="btn btn-quiet btn-sm" type="submit">Save game</button>
			</div>
		</form>
		<form method="post" action={ "/admin/games/" + item.ID + "/active" } class="flex justify-end" data-confirm={ gameActiveConfirmation(item.Active) }>
			@components.CSRFInput()
			if item.Active {
				<input type="hidden" name="active" value="false"/><button class="btn btn-step-back btn-sm" type="submit">Deactivate game</button>
			} else {
				<input type="hidden" name="active" value="true"/><button class="btn btn-primary btn-sm" type="submit">Activate game</button>
			}
		</form>
		<div class="divider my-1">Catalog identity</div>
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				if item.IGDBExternalID == "" {
					<p class="text-sm font-medium">Local-only</p>
					<p class="text-xs text-base-content/65">No IGDB record linked</p>
				} else {
					<p class="text-sm font-medium">IGDB #{ item.IGDBExternalID }</p>
					if item.IGDBEnriched {
						<p class="text-xs text-base-content/65">Enrichment snapshot available</p>
					} else {
						<p class="text-xs text-warning">Linked without enrichment</p>
					}
				}
			</div>
			<div class="flex flex-wrap gap-2">
				if item.IGDBExternalID == "" {
					<a class="btn btn-quiet btn-sm" href={ "/admin/games/" + item.ID + "/igdb" }>Link IGDB</a>
				} else {
					<a class="btn btn-quiet btn-sm" href={ "/admin/games/" + item.ID + "/igdb" }>Manage IGDB link</a>
				}
				<a class="btn btn-quiet btn-sm" href={ "/admin/games/" + item.ID + "/merge" }>Merge duplicate</a>
			</div>
		</div>
		@AdminIGDBMetadata(item.IGDBSummary, item.IGDBGenreNames, item.IGDBGameModeNames, item.IGDBMultiplayerModes)
		<div class="divider my-1">Aliases</div>
		<div class="flex flex-wrap gap-2">
			for _, alias := range item.Aliases {
				<form method="post" action={ "/admin/games/" + item.ID + "/aliases/" + alias.ID + "/remove" } data-confirm={ "Remove the alias " + alias.Value + "?" }>
					@components.CSRFInput()
					<button class="badge badge-outline h-auto min-h-11 gap-1 py-2" type="submit" aria-label={ "Remove alias " + alias.Value }>{ alias.Value } <span aria-hidden="true">×</span></button>
				</form>
			}
			if len(item.Aliases) == 0 {
				<span class="text-sm text-base-content/70">No aliases</span>
			}
		</div>
		<form method="post" action={ "/admin/games/" + item.ID + "/aliases" } class="flex flex-col gap-2 sm:flex-row">
			@components.CSRFInput()
			<label class="sr-only" for={ "alias-" + item.ID }>New alias</label>
			<input id={ "alias-" + item.ID } class="input input-bordered input-sm flex-1" name="alias" maxlength="120" placeholder="Add search alias" required/>
			<button class="btn btn-quiet btn-sm" type="submit">Add alias</button>
		</form>
		<div class="divider my-1">Permanent deletion</div>
		@AdminGameDelete(item)
	</article>
}

templ AdminGameDelete(item game.Game) {
	if item.GameRequestCount > 0 {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<p class="max-w-xl text-sm text-base-content/70">This game has Game Requests and cannot be deleted. Deactivate or merge it instead.</p>
			<button class="btn btn-danger btn-sm" type="button" disabled>Delete permanently</button>
		</div>
	} else if item.SubscriptionCount > 0 {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<p class="max-w-xl text-sm text-base-content/70">This game is followed by users. Merge or remove those relationships before deleting.</p>
			<button class="btn btn-danger btn-sm" type="button" disabled>Delete permanently</button>
		</div>
	} else {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<p class="max-w-xl text-sm text-base-content/70">Unused game. Permanent deletion also removes its aliases and provider link.</p>
			<form method="post" action={ "/admin/games/" + item.ID + "/delete" } data-confirm={ "Permanently delete " + item.Name + "? This cannot be undone." }>
				@components.CSRFInput()
				<button class="btn btn-danger btn-sm" type="submit">Delete permanently</button>
			</form>
		</div>
	}
}

templ GameFields(name, slug string) {
	<label class="form-control"><span class="label"><span class="label-text">Name</span></span><input class="input input-bordered w-full" name="name" value={ name } maxlength="120" required/></label>
	<label class="form-control"><span class="label"><span class="label-text">Slug</span></span><input class="input input-bordered w-full data-text" name="slug" value={ slug } maxlength="120" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="counter-strike-2" required/></label>
}

templ AdminGameIGDB(brand branding.Brand, navigation components.NavigationState, item game.Game, results []game.AdminProviderGame, search, formError string) {
	@components.Layout(brand, "Manage IGDB Link", navigation) {
		<header class="app-topbar"><a class="link count-open text-sm font-semibold no-underline" href="/admin/games">← Manage games</a></header>
		<div class="content-page">
			<div class="max-w-4xl">
				<h1 class="app-title">IGDB link for { item.Name }</h1>
				<p class="mt-1 text-sm text-base-content/70">The local Game ID, name, and slug stay authoritative. Provider metadata is always reloaded server-side.</p>
				if formError != "" {
					<div role="alert" class="alert alert-error mt-4"><span>{ formError }</span></div>
				}
				<section class="detail-card mt-5">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<div>
							<h2 class="text-[1.0625rem] font-semibold">Current identity</h2>
							if item.IGDBExternalID == "" {
								<p class="text-sm text-base-content/70">Local-only · not linked</p>
							} else {
								<p class="data-text text-sm">IGDB #{ item.IGDBExternalID }</p>
							}
						</div>
						if item.IGDBExternalID != "" {
							<form method="post" action={ "/admin/games/" + item.ID + "/igdb/unlink" } data-confirm="Unlink this IGDB record? The local Game, aliases, followers, and Game Requests will remain.">
								@components.CSRFInput()
								<button class="btn btn-step-back btn-sm" type="submit">Unlink IGDB</button>
							</form>
						}
					</div>
				</section>
				if item.IGDBExternalID == "" {
					<section class="mt-6 grid gap-3">
						<div><h2 class="text-[1.0625rem] font-semibold">Find IGDB record</h2><p class="text-sm text-base-content/70">Search the active synchronized catalog by name or IGDB ID.</p></div>
						<form method="get" action={ "/admin/games/" + item.ID + "/igdb" } class="request-toolbar">
							<label class="sr-only" for="igdb-link-search">Search IGDB</label>
							<input id="igdb-link-search" class="input input-sm request-search" type="search" name="q" value={ search } maxlength="120" placeholder="Game name or IGDB ID" required/>
							<button class="btn btn-primary btn-sm" type="submit">Search IGDB</button>
						</form>
						if search != "" && len(results) == 0 {
							<div class="detail-card"><h3 class="font-semibold">No IGDB records found</h3><p class="text-sm text-base-content/70">Try another name or run a synchronization from IGDB Sync.</p></div>
						}
						for _, result := range results {
							@AdminIGDBLinkResult(item, result)
						}
					</section>
				} else {
					<p class="mt-4 text-sm text-base-content/70">To change the IGDB identity, unlink the current record first, then select the replacement.</p>
				}
			</div>
		</div>
	}
}

templ AdminIGDBLinkResult(target game.Game, result game.AdminProviderGame) {
	<article class="detail-card">
		<div class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-4">
			<div class="relative aspect-[3/4] w-[clamp(72px,12vw,100px)] max-w-[100px] overflow-hidden rounded bg-base-300">
				if result.CoverImageID != "" {
					<img class="h-full w-full object-cover" src={ providerCoverLargeURL(result.CoverImageID) } alt="" referrerpolicy="no-referrer" loading="lazy" data-cover-fallback="true"/>
					<span class="absolute inset-0 grid place-items-center font-mono text-lg font-semibold text-base-content/70" aria-hidden="true" hidden>{ components.GameAbbreviation(result.Name) }</span>
				} else {
					<span class="absolute inset-0 grid place-items-center font-mono text-lg font-semibold text-base-content/70" aria-hidden="true">{ components.GameAbbreviation(result.Name) }</span>
				}
			</div>
			<div class="min-w-0 self-center">
				<h3 class="break-words text-base font-semibold">{ result.Name }</h3>
				if metadata := presentationMetadata(adminProviderPresentation(result)); metadata != "" {
					<p class="mt-1 break-words text-sm text-base-content/70">{ metadata }</p>
				}
				<p class="data-text mt-1 break-words text-xs text-base-content/65">IGDB #{ result.ExternalID }</p>
			@AdminIGDBMetadata(result.Summary, result.GenreNames, result.GameModeNames, result.MultiplayerModes)
			</div>
			if result.LinkedGameID == "" {
				<form class="justify-self-end" method="post" action={ "/admin/games/" + target.ID + "/igdb" }>
					@components.CSRFInput()
					<input type="hidden" name="external_id" value={ result.ExternalID }/>
					<button class="btn btn-primary btn-sm whitespace-nowrap" type="submit">Link this record</button>
				</form>
			} else if result.LinkedGameID == target.ID {
				<span class="badge badge-primary">Already linked</span>
			} else {
				<div class="justify-self-end text-right">
					<p class="text-sm text-base-content/70">Linked to { result.LinkedGameName }</p>
					<a class="btn btn-quiet btn-sm mt-2" href={ "/admin/games/" + target.ID + "/merge?source=" + result.LinkedGameID + "&notice=igdb-link-conflict" }>Review merge</a>
				</div>
			}
		</div>
	</article>
}

func adminProviderPresentation(result game.AdminProviderGame) game.GamePresentation {
	return game.GamePresentation{
		Name: result.Name, GameType: result.GameType, PlatformNames: result.PlatformNames,
		FirstReleaseDate: result.FirstReleaseDate, CoverImageID: result.CoverImageID,
	}
}

// AdminIGDBMetadata renders the synchronized IGDB metadata (issue #46) as a
// functional inspection block: summary, genre and game mode badges, and one
// line per platform-specific multiplayer mode. It renders nothing when no
// metadata is present, so local-only Games and missing enrichment snapshots
// need no special casing at the call sites.
templ AdminIGDBMetadata(summary string, genreNames, gameModeNames []string, modes []game.MultiplayerMode) {
	if summary != "" || len(genreNames) > 0 || len(gameModeNames) > 0 || len(modes) > 0 {
		<div class="mt-2 grid gap-1">
			if summary != "" {
				<p class="break-words text-xs text-base-content/70">{ adminMetadataSummary(summary) }</p>
			}
			if len(genreNames) > 0 || len(gameModeNames) > 0 {
				<div class="flex flex-wrap gap-1">
					for _, name := range genreNames {
						<span class="badge badge-ghost badge-sm">{ name }</span>
					}
					for _, name := range gameModeNames {
						<span class="badge badge-outline badge-sm">{ name }</span>
					}
				</div>
			}
			if len(modes) > 0 {
				<ul class="grid gap-1">
					for _, mode := range modes {
						<li class="break-words text-xs text-base-content/70">{ multiplayerModeText(mode) }</li>
					}
				</ul>
			}
		</div>
	}
}

func adminMetadataSummary(summary string) string {
	value := strings.Join(strings.Fields(summary), " ")
	if utf8.RuneCountInString(value) <= 400 {
		return value
	}
	return string([]rune(value)[:400]) + "…"
}

// multiplayerModeText describes one platform-specific multiplayer mode in
// operator-facing prose. Absent player limits are omitted rather than shown
// as zero; they were never reported by IGDB.
func multiplayerModeText(mode game.MultiplayerMode) string {
	label := mode.PlatformName
	if label == "" {
		if mode.PlatformIGDBID > 0 {
			label = "IGDB platform #" + strconv.FormatInt(mode.PlatformIGDBID, 10)
		} else {
			label = "Platform unspecified"
		}
	}
	var parts []string
	if mode.CampaignCoop {
		parts = append(parts, "campaign co-op")
	}
	if mode.DropIn {
		parts = append(parts, "drop-in")
	}
	if mode.LanCoop {
		parts = append(parts, "LAN co-op")
	}
	if mode.OfflineCoop {
		parts = append(parts, "offline co-op")
	}
	if mode.OfflineCoopMax != nil {
		parts = append(parts, "offline co-op max "+strconv.Itoa(*mode.OfflineCoopMax))
	}
	if mode.OfflineMax != nil {
		parts = append(parts, "offline max "+strconv.Itoa(*mode.OfflineMax))
	}
	if mode.OnlineCoop {
		parts = append(parts, "online co-op")
	}
	if mode.OnlineCoopMax != nil {
		parts = append(parts, "online co-op max "+strconv.Itoa(*mode.OnlineCoopMax))
	}
	if mode.OnlineMax != nil {
		parts = append(parts, "online max "+strconv.Itoa(*mode.OnlineMax))
	}
	if mode.SplitScreen {
		parts = append(parts, "split-screen")
	}
	if mode.SplitScreenOnline {
		parts = append(parts, "split-screen online")
	}
	if len(parts) == 0 {
		return label
	}
	return label + ": " + strings.Join(parts, " · ")
}

templ AdminGameMerge(brand branding.Brand, navigation components.NavigationState, target, source game.Game, games []game.Game, sourceID, formError, notice string) {
	@components.Layout(brand, "Merge Games", navigation) {
		<header class="app-topbar"><a class="link count-open text-sm font-semibold no-underline" href="/admin/games">← Manage games</a></header>
		<div class="content-page">
			<div class="max-w-4xl">
				<h1 class="app-title">Merge duplicate Game</h1>
				<p class="mt-1 text-sm text-base-content/70">{ target.Name } is the target. It keeps its local ID, name, slug, and active state.</p>
				if notice != "" {
					<div role="status" class="alert alert-info mt-4"><span>{ notice }</span></div>
				}
				if formError != "" {
					<div role="alert" class="alert alert-error mt-4"><span>{ formError }</span></div>
				}
				<section class="detail-card mt-5">
					<h2 class="text-[1.0625rem] font-semibold">Choose source Game</h2>
					<p class="text-sm text-base-content/70">The source is removed after its Game Requests, followers, aliases, and IGDB identity move to the target.</p>
					<form method="get" action={ "/admin/games/" + target.ID + "/merge" } class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end">
						<label class="form-control flex-1"><span class="label"><span class="label-text">Source Game</span></span>
							<select class="select select-bordered w-full" name="source" required>
								<option value="">Choose duplicate</option>
								for _, candidate := range games {
									if candidate.ID != target.ID {
										<option value={ candidate.ID } selected?={ candidate.ID == sourceID }>{ candidate.Name } · { candidate.Slug }</option>
									}
								}
							</select>
						</label>
						<button class="btn btn-quiet" type="submit">Review merge</button>
					</form>
				</section>
				if source.ID != "" {
					<section class="detail-card mt-4">
						<h2 class="text-[1.0625rem] font-semibold">Review</h2>
						<dl class="mt-3 grid gap-4 sm:grid-cols-2">
							<div><dt class="text-sm text-base-content/60">Source · removed</dt><dd class="font-semibold">{ source.Name }</dd><dd class="data-text text-xs">{ source.Slug }</dd><dd class="mt-1 text-sm text-base-content/70">{ gameRelationshipSummary(source) }</dd></div>
							<div><dt class="text-sm text-base-content/60">Target · kept</dt><dd class="font-semibold">{ target.Name }</dd><dd class="data-text text-xs">{ target.Slug }</dd><dd class="mt-1 text-sm text-base-content/70">{ gameRelationshipSummary(target) }</dd></div>
						</dl>
						if source.IGDBExternalID != "" && target.IGDBExternalID != "" {
							<div role="alert" class="alert alert-warning mt-4"><span>Both Games have different IGDB links. Unlink the incorrect record before merging.</span></div>
						} else {
							<form method="post" action={ "/admin/games/" + target.ID + "/merge" } class="mt-5 flex justify-end" data-confirm={ "Merge " + source.Name + " into " + target.Name + "? The source Game will be permanently removed." }>
								@components.CSRFInput()
								<input type="hidden" name="source_id" value={ source.ID }/>
								<button class="btn btn-danger" type="submit">Merge and remove source</button>
							</form>
						}
					</section>
				}
			</div>
		</div>
	}
}

func gameRelationshipSummary(item game.Game) string {
	parts := []string{strconv.FormatInt(item.GameRequestCount, 10) + " Game Requests", strconv.FormatInt(item.SubscriptionCount, 10) + " followers"}
	if item.IGDBExternalID == "" { parts = append(parts, "local-only") } else { parts = append(parts, "IGDB #" + item.IGDBExternalID) }
	return strings.Join(parts, " · ")
}

templ AdminIGDB(brand branding.Brand, navigation components.NavigationState, status game.ProviderStatus, notice string) {
	@components.Layout(brand, "IGDB Synchronization", navigation) {
		<header class="app-topbar">
			<h1 class="app-title">IGDB synchronization</h1>
			<div class="flex gap-2">
				<a class="btn btn-quiet btn-sm" href="/admin/games">Manage games</a>
				<a class="btn btn-quiet btn-sm" href="/admin/pwa">PWA</a>
			</div>
		</header>
		<div class="content-page">
			<p class="mb-5 max-w-2xl text-sm text-base-content/70">Review the local IGDB discovery index and its background refresh.</p>
			if notice != "" {
				<div role="status" class="alert alert-info mb-4"><span>{ notice }</span></div>
			}
			<section class="detail-card">
				<div class="flex flex-wrap items-center justify-between gap-3">
					<h2 class="text-[1.0625rem] font-semibold">Status</h2>
					@igdbStatusBadge(status.State)
				</div>
				<dl class="mt-2 grid gap-4 sm:grid-cols-3">
					<div>
						<dt class="text-sm text-base-content/60">Last attempt</dt>
						<dd class="data-text">{ igdbTimestamp(status.LastAttempt) }</dd>
					</div>
					<div>
						<dt class="text-sm text-base-content/60">Last success</dt>
						<dd class="data-text">{ igdbTimestamp(status.LastSuccess) }</dd>
					</div>
					<div>
						<dt class="text-sm text-base-content/60">Indexed records</dt>
						<dd class="data-text">{ strconv.FormatInt(status.RecordCount, 10) }</dd>
					</div>
				</dl>
				if status.LastError != "" {
					<div role="alert" class="alert alert-error mt-2"><span>{ status.LastError }</span></div>
				}
				if status.State != game.ProviderDisabled && status.State != game.ProviderSyncing {
					<form method="post" action="/admin/igdb/sync" class="flex justify-end mt-2">
						@components.CSRFInput()
						<button class="btn btn-primary btn-sm" type="submit">Sync now</button>
					</form>
				}
			</section>
		</div>
	}
}

templ igdbStatusBadge(state game.ProviderState) {
	if state == game.ProviderCurrent {
		<span class="badge badge-primary">Current</span>
	} else if state == game.ProviderSyncing {
		<span class="badge badge-info">Syncing</span>
	} else if state == game.ProviderFailed {
		<span class="badge badge-error">Failed</span>
	} else if state == game.ProviderStale {
		<span class="badge badge-warning">Stale</span>
	} else if state == game.ProviderDisabled {
		<span class="badge badge-ghost">Disabled</span>
	} else {
		<span class="badge badge-outline">Not synced</span>
	}
}

templ AdminError(brand branding.Brand, navigation components.NavigationState) {
	@components.Layout(brand, "Administration error", navigation) {
		<header class="app-topbar"><h1 class="app-title">Administration</h1></header>
		<div class="content-page"><div role="alert" class="alert alert-error"><div><p class="font-bold">Administration could not be loaded</p><p>Try the request again.</p></div></div></div>
	}
}

// PWADiagnostics carries the server-known facts the /admin/pwa page renders
// unconditionally. Browser-only facts (secure context, registration state,
// controller, last error) are filled in by admin-pwa.ts and read "Not
// available without JavaScript" until then.
type PWADiagnostics struct {
	InstanceName     string
	BaseURL          string
	ManifestURL      string
	ServiceWorkerURL string
	SecureContext    bool
}

templ AdminPWA(brand branding.Brand, navigation components.NavigationState, diagnostics PWADiagnostics) {
	@components.Layout(brand, "PWA Diagnostics", navigation) {
		<header class="app-topbar">
			<h1 class="app-title">PWA diagnostics</h1>
			<div class="flex gap-2">
				<a class="btn btn-quiet btn-sm" href="/admin/games">Manage games</a>
				<a class="btn btn-quiet btn-sm" href="/admin/igdb">IGDB Sync</a>
			</div>
		</header>
		<div class="content-page">
			<p class="mb-5 max-w-2xl text-sm text-base-content/70">Read-only facts about this installation's manifest, service worker, and secure-context status. Nothing here is stored or shown to players.</p>
			<section class="detail-card">
				<h2 class="text-[1.0625rem] font-semibold">Server</h2>
				<dl class="mt-2 grid gap-4 sm:grid-cols-2">
					<div><dt class="text-sm text-base-content/60">Instance name</dt><dd class="data-text">{ diagnostics.InstanceName }</dd></div>
					<div><dt class="text-sm text-base-content/60">Base URL</dt><dd class="data-text">{ diagnostics.BaseURL }</dd></div>
					<div><dt class="text-sm text-base-content/60">Manifest URL</dt><dd class="data-text">{ diagnostics.ManifestURL }</dd></div>
					<div><dt class="text-sm text-base-content/60">Service worker URL</dt><dd class="data-text">{ diagnostics.ServiceWorkerURL }</dd></div>
					<div><dt class="text-sm text-base-content/60">Expected secure context</dt><dd class="data-text">{ secureContextLabel(diagnostics.SecureContext) }</dd></div>
				</dl>
			</section>
			<section class="detail-card mt-4" data-pwa-diagnostics>
				<h2 class="text-[1.0625rem] font-semibold">Browser</h2>
				<dl class="mt-2 grid gap-4 sm:grid-cols-2">
					<div><dt class="text-sm text-base-content/60">Diagnostics ran</dt><dd class="data-text" data-fact="diagnostics-ran">No</dd></div>
					<div><dt class="text-sm text-base-content/60">window.isSecureContext</dt><dd class="data-text" data-fact="secure-context">Not available without JavaScript</dd></div>
					<div><dt class="text-sm text-base-content/60">Service worker supported</dt><dd class="data-text" data-fact="supported">Not available without JavaScript</dd></div>
					<div><dt class="text-sm text-base-content/60">Registration</dt><dd class="data-text" data-fact="registration">Not available without JavaScript</dd></div>
					<div><dt class="text-sm text-base-content/60">Controller</dt><dd class="data-text" data-fact="controller">Not available without JavaScript</dd></div>
					<div><dt class="text-sm text-base-content/60">Last registration error</dt><dd class="data-text" data-fact="error">Not available without JavaScript</dd></div>
				</dl>
			</section>
		</div>
		<script src={ brand.Assets.AdminPWADiagnostics } defer></script>
	}
}

func secureContextLabel(secure bool) string {
	if secure {
		return "Yes"
	}
	return "No (HTTPS, or a loopback/localhost origin, is required for PWA installation and Web Push)"
}

func igdbTimestamp(value *time.Time) string {
	if value == nil {
		return "Never"
	}
	return value.UTC().Format("2006-01-02T15:04Z")
}

func gameActiveConfirmation(active bool) string {
	if active {
		return "Deactivate this game? Existing Game Requests are not changed."
	}
	return ""
}
