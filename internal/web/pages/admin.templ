package pages

import (
	"time"
	"github.com/convention-x-treme/lansurfer/internal/event"
	"github.com/convention-x-treme/lansurfer/internal/game"
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

templ AdminEvents(brand branding.Brand, navigation components.NavigationState, events []event.Event, formError, notice string) {
	@components.Layout(brand, "Manage Events", navigation) {
		<section class="page-shell py-10">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div>
					<p class="data-text text-sm font-semibold uppercase tracking-widest text-secondary">Administration</p>
					<h1 class="mt-2 text-3xl font-bold">Events</h1>
					<p class="mt-2 text-base-content/70">Keep historical events and select the one currently used by LANsurfer.</p>
				</div>
				<a class="btn btn-ghost" href="/admin/games">Manage games</a>
			</div>
			if formError != "" {
				<div role="alert" class="alert alert-error mt-6"><span>{ formError }</span></div>
			}
			if notice != "" {
				<div role="status" class="alert alert-info mt-6"><span>{ notice }</span></div>
			}
			<div class="mt-8 grid gap-8 lg:grid-cols-[minmax(18rem,0.7fr)_minmax(0,1.3fr)]">
				<form method="post" action="/admin/events" class="card h-fit border border-base-300 bg-base-200 shadow-sm">
					@components.CSRFInput()
					<div class="card-body">
						<h2 class="card-title">Create event</h2>
						@EventFields("", time.Time{}, time.Time{})
						<div class="card-actions justify-end"><button class="btn btn-primary" type="submit">Create event</button></div>
					</div>
				</form>
				<div class="space-y-4">
					if len(events) == 0 {
						<div class="card border border-base-300 bg-base-200"><div class="card-body"><h2 class="card-title">No events yet</h2><p>Create the LAN event you want to prepare.</p></div></div>
					}
					for _, item := range events {
						<article class="card border border-base-300 bg-base-200 shadow-sm">
							<div class="card-body">
								<div class="flex flex-wrap items-center justify-between gap-3">
									<h2 class="card-title">{ item.Name }</h2>
									if item.IsCurrent {
										<span class="badge badge-primary">Current event</span>
									} else {
										<form method="post" action={ "/admin/events/" + item.ID + "/current" }>@components.CSRFInput()<button class="btn btn-outline btn-sm" type="submit">Make current</button></form>
									}
								</div>
								<form method="post" action={ "/admin/events/" + item.ID } class="mt-3 grid gap-4 sm:grid-cols-2">
									@components.CSRFInput()
									@EventFields(item.Name, item.StartsAt, item.EndsAt)
									<div class="sm:col-span-2 flex justify-end"><button class="btn btn-outline btn-sm" type="submit">Save event</button></div>
								</form>
							</div>
						</article>
					}
				</div>
			</div>
		</section>
	}
}

templ EventFields(name string, startsAt, endsAt time.Time) {
	<label class="form-control sm:col-span-2"><span class="label"><span class="label-text">Name</span></span><input class="input input-bordered w-full" name="name" value={ name } maxlength="120" required/></label>
	<label class="form-control"><span class="label"><span class="label-text">Starts at (UTC)</span></span><input class="input input-bordered w-full data-text" type="datetime-local" name="starts_at" value={ adminDateTime(startsAt) } required/></label>
	<label class="form-control"><span class="label"><span class="label-text">Ends at (UTC)</span></span><input class="input input-bordered w-full data-text" type="datetime-local" name="ends_at" value={ adminDateTime(endsAt) } required/></label>
}

templ AdminGames(brand branding.Brand, navigation components.NavigationState, games []game.Game, search, formError, notice string) {
	@components.Layout(brand, "Manage Games", navigation) {
		<section class="page-shell py-10">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div>
					<p class="data-text text-sm font-semibold uppercase tracking-widest text-secondary">Administration</p>
					<h1 class="mt-2 text-3xl font-bold">Game catalog</h1>
					<p class="mt-2 text-base-content/70">Maintain the local games available for Looking for Group.</p>
				</div>
				<a class="btn btn-ghost" href="/admin/events">Manage events</a>
			</div>
			if formError != "" {
				<div role="alert" class="alert alert-error mt-6"><span>{ formError }</span></div>
			}
			if notice != "" {
				<div role="status" class="alert alert-info mt-6"><span>{ notice }</span></div>
			}
			<div class="mt-8 grid gap-8 xl:grid-cols-[minmax(18rem,0.55fr)_minmax(0,1.45fr)]">
				<div class="space-y-5">
					<form method="post" action="/admin/games" class="card border border-base-300 bg-base-200 shadow-sm">
						@components.CSRFInput()
						<div class="card-body">
							<h2 class="card-title">Add game</h2>
							@GameFields("", "")
							<div class="card-actions justify-end"><button class="btn btn-primary" type="submit">Add game</button></div>
						</div>
					</form>
					<form method="get" action="/admin/games" class="card border border-base-300 bg-base-200 shadow-sm">
						<div class="card-body">
							<h2 class="card-title">Search catalog</h2>
							<label class="form-control"><span class="label"><span class="label-text">Name or alias</span></span><input class="input input-bordered" type="search" name="q" value={ search } maxlength="120" placeholder="e.g. wc3"/></label>
							<div class="card-actions justify-end"><a class="btn btn-ghost" href="/admin/games">Clear</a><button class="btn btn-outline" type="submit">Search</button></div>
						</div>
					</form>
				</div>
				<div class="space-y-4">
					if len(games) == 0 {
						<div class="card border border-base-300 bg-base-200"><div class="card-body"><h2 class="card-title">No games found</h2><p>Add a game or try a different name or alias.</p></div></div>
					}
					for _, item := range games {
						@AdminGameCard(item)
					}
				</div>
			</div>
		</section>
	}
}

templ AdminGameCard(item game.Game) {
	<article class="card border border-base-300 bg-base-200 shadow-sm">
		<div class="card-body">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div><h2 class="card-title">{ item.Name }</h2><p class="data-text text-sm text-base-content/60">{ item.Slug }</p></div>
				if item.Active {
					<span class="badge badge-primary">Active</span>
				} else {
					<span class="badge badge-ghost">Inactive</span>
				}
			</div>
			<form method="post" action={ "/admin/games/" + item.ID } class="mt-3 grid gap-4 sm:grid-cols-2">
				@components.CSRFInput()
				@GameFields(item.Name, item.Slug)
				<div class="sm:col-span-2 flex flex-wrap justify-end gap-2">
					<button class="btn btn-outline btn-sm" type="submit">Save game</button>
				</div>
			</form>
			<form method="post" action={ "/admin/games/" + item.ID + "/active" } class="flex justify-end" data-confirm={ gameActiveConfirmation(item.Active) }>
				@components.CSRFInput()
				if item.Active {
					<input type="hidden" name="active" value="false"/><button class="btn btn-error btn-sm" type="submit">Deactivate game</button>
				} else {
					<input type="hidden" name="active" value="true"/><button class="btn btn-primary btn-sm" type="submit">Activate game</button>
				}
			</form>
			<div class="divider my-1">Aliases</div>
			<div class="flex flex-wrap gap-2">
				for _, alias := range item.Aliases {
					<form method="post" action={ "/admin/games/" + item.ID + "/aliases/" + alias.ID + "/remove" } data-confirm={ "Remove the alias " + alias.Value + "?" }>
						@components.CSRFInput()
						<button class="badge badge-outline h-auto min-h-11 gap-1 py-2" type="submit" aria-label={ "Remove alias " + alias.Value }>{ alias.Value } <span aria-hidden="true">×</span></button>
					</form>
				}
				if len(item.Aliases) == 0 {
					<span class="text-sm text-base-content/60">No aliases</span>
				}
			</div>
			<form method="post" action={ "/admin/games/" + item.ID + "/aliases" } class="flex flex-col gap-2 sm:flex-row">
				@components.CSRFInput()
				<label class="sr-only" for={ "alias-" + item.ID }>New alias</label>
				<input id={ "alias-" + item.ID } class="input input-bordered input-sm flex-1" name="alias" maxlength="120" placeholder="Add search alias" required/>
				<button class="btn btn-outline btn-sm" type="submit">Add alias</button>
			</form>
		</div>
	</article>
}

templ GameFields(name, slug string) {
	<label class="form-control"><span class="label"><span class="label-text">Name</span></span><input class="input input-bordered w-full" name="name" value={ name } maxlength="120" required/></label>
	<label class="form-control"><span class="label"><span class="label-text">Slug</span></span><input class="input input-bordered w-full data-text" name="slug" value={ slug } maxlength="120" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="counter-strike-2" required/></label>
}

templ AdminError(brand branding.Brand, navigation components.NavigationState) {
	@components.Layout(brand, "Administration error", navigation) {
		<section class="page-shell py-16"><div role="alert" class="alert alert-error"><div><h1 class="font-bold">Administration could not be loaded</h1><p>Try the request again.</p></div></div></section>
	}
}

func adminDateTime(value time.Time) string {
	if value.IsZero() { return "" }
	return value.UTC().Format("2006-01-02T15:04")
}

func gameActiveConfirmation(active bool) string {
	if active { return "Deactivate this game? Existing Game Requests are not changed." }
	return ""
}
