package pages

import (
	"strconv"
	"strings"
	"time"

	"github.com/convention-x-treme/lansurfer/internal/game"
	"github.com/convention-x-treme/lansurfer/internal/notification"
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

templ AdminGameIGDB(brand branding.Brand, navigation components.NavigationState, item game.Game, results []game.AdminProviderGame, search, formError string) {
	@components.Layout(brand, "Manage IGDB Link", navigation) {
		<header class="app-topbar">
			<div class="min-w-0">
				<h1 class="app-title">IGDB link for { item.Name }</h1>
				<p class="text-sm text-base-content/70">The local Game ID, name, and slug stay authoritative.</p>
			</div>
			<a class="btn btn-quiet btn-sm" href="/admin/games"><i class="ph ph-arrow-left" aria-hidden="true"></i>Back to catalog</a>
		</header>
		<div class="content-page">
			<div class="max-w-4xl">
				if formError != "" {
					<div role="alert" class="alert alert-error mb-4"><span>{ formError }</span></div>
				}
				<section class="detail-card">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<div>
							<h2 class="text-[1.0625rem] font-semibold">Current identity</h2>
							if item.IGDBExternalID == "" {
								<p class="text-sm text-base-content/70">Local-only · not linked</p>
							} else {
								<p class="data-text text-sm">IGDB #{ item.IGDBExternalID }</p>
							}
						</div>
						if item.IGDBExternalID != "" {
							<form method="post" action={ "/admin/games/" + item.ID + "/igdb/unlink" } data-confirm="Unlink this IGDB record? The local Game, aliases, followers, and Game Requests will remain.">
								@components.CSRFInput()
								<button class="btn btn-step-back btn-sm" type="submit"><i class="ph ph-link-break" aria-hidden="true"></i>Unlink IGDB</button>
							</form>
						}
					</div>
				</section>
				if item.IGDBExternalID == "" {
					<section class="mt-4 grid gap-3">
						<div><h2 class="text-[1.0625rem] font-semibold">Find IGDB record</h2><p class="text-sm text-base-content/70">Search the active synchronized catalog by name or IGDB ID.</p></div>
						<form
							class="request-toolbar"
							method="get"
							action={ "/admin/games/" + item.ID + "/igdb" }
							hx-get={ "/admin/games/" + item.ID + "/igdb" }
							hx-target="#igdb-link-results"
							hx-swap="outerHTML"
							hx-sync="this:replace"
							hx-replace-url="true"
							hx-trigger="submit, input changed delay:300ms from:(#igdb-link-search), search from:(#igdb-link-search)"
						>
							<label class="sr-only" for="igdb-link-search">Search IGDB</label>
							<input id="igdb-link-search" class="input input-sm request-search" type="search" name="q" value={ search } maxlength="120" placeholder="Game name or IGDB ID" autocomplete="off" required/>
							<noscript><button class="btn btn-primary btn-sm" type="submit"><i class="ph ph-magnifying-glass" aria-hidden="true"></i>Search IGDB</button></noscript>
						</form>
						@AdminIGDBLinkResults(item, results, search)
					</section>
				} else {
					<p class="mt-4 text-sm text-base-content/70">To change the IGDB identity, unlink the current record first, then select the replacement.</p>
				}
			</div>
		</div>
	}
}

// AdminIGDBLinkResults is the live-search swap target on the link screen, so
// it carries the no-match state as well as the candidates themselves.
templ AdminIGDBLinkResults(target game.Game, results []game.AdminProviderGame, search string) {
	<div id="igdb-link-results" class="catalog-list" aria-live="polite">
		if search != "" && len(results) == 0 {
			<div class="detail-card"><h3 class="font-semibold">No IGDB records found</h3><p class="text-sm text-base-content/70">Try another name or run a synchronization from IGDB sync.</p></div>
		}
		for _, result := range results {
			@AdminIGDBLinkResult(target, result)
		}
	</div>
}

// AdminIGDBLinkResult is one provider candidate. It uses the product's own
// cover tile and row vocabulary rather than a layout of its own, so a
// record reads here the way the same Game reads on every other screen.
templ AdminIGDBLinkResult(target game.Game, result game.AdminProviderGame) {
	<article class="catalog-entry catalog-entry-static">
		<div class="catalog-summary">
			<span class="catalog-cover">
				@CoverArt(result.CoverImageID, result.Name, false)
			</span>
			<div class="catalog-entry-body">
				<h3 class="catalog-entry-title">{ result.Name }</h3>
				<p class="catalog-entry-meta">
					<span class="data-text">IGDB #{ result.ExternalID }</span>
				</p>
				@AdminIGDBMetadata(adminProviderFacts(result))
			</div>
			if result.LinkedGameID == "" {
				<div class="catalog-candidate-actions">
					<form method="post" action={ "/admin/games/" + target.ID + "/igdb" }>
						@components.CSRFInput()
						<input type="hidden" name="external_id" value={ result.ExternalID }/>
						<button class="btn btn-primary btn-sm whitespace-nowrap" type="submit"><i class="ph ph-link" aria-hidden="true"></i>Link this record</button>
					</form>
					if result.Slug != "" {
						<a class="btn btn-quiet btn-sm whitespace-nowrap" href={ igdbGameURL(result.Slug) } target="_blank" rel="noopener noreferrer">
							Open on IGDB
							<span class="sr-only">(opens in a new tab)</span>
							<i class="ph ph-arrow-square-out external-mark" aria-hidden="true"></i>
						</a>
					}
				</div>
			} else if result.LinkedGameID == target.ID {
				<span class="status-chip status-chip-open">Already linked</span>
			} else {
				<div class="text-right">
					<p class="text-sm text-base-content/70">Linked to { result.LinkedGameName }</p>
					<a class="btn btn-quiet btn-sm mt-2" href={ "/admin/games/" + target.ID + "/merge?source=" + result.LinkedGameID + "&notice=igdb-link-conflict" }><i class="ph ph-git-merge" aria-hidden="true"></i>Review merge</a>
				</div>
			}
		</div>
	</article>
}

// AdminGameFacts is one IGDB enrichment snapshot as an administration
// surface states it. The two callers carry different halves of it -- a
// local Game keeps no type/platform/release columns, a provider candidate
// has no local identity -- so the zero value of every field is a fact that
// simply is not known and renders as nothing.
type AdminGameFacts struct {
	Summary          string
	GameType         string
	PlatformNames    []string
	FirstReleaseDate *time.Time
	GenreNames       []string
	GameModeNames    []string
	MultiplayerModes []game.MultiplayerMode
}

func adminGameFacts(item game.Game) AdminGameFacts {
	return AdminGameFacts{
		Summary: item.IGDBSummary, GenreNames: item.IGDBGenreNames,
		GameModeNames: item.IGDBGameModeNames, MultiplayerModes: item.IGDBMultiplayerModes,
	}
}

func adminProviderFacts(result game.AdminProviderGame) AdminGameFacts {
	return AdminGameFacts{
		Summary: result.Summary, GameType: result.GameType, PlatformNames: result.PlatformNames,
		FirstReleaseDate: result.FirstReleaseDate, GenreNames: result.GenreNames,
		GameModeNames: result.GameModeNames, MultiplayerModes: result.MultiplayerModes,
	}
}

func (f AdminGameFacts) empty() bool {
	return f.Summary == "" && f.GameType == "" && len(f.PlatformNames) == 0 && f.FirstReleaseDate == nil &&
		len(f.GenreNames) == 0 && len(f.GameModeNames) == 0 && len(f.MultiplayerModes) == 0
}

// AdminIGDBMetadata renders the synchronized IGDB metadata (issue #46) as an
// inspection block: the whole stored summary as prose, then one labelled
// row per kind of fact. The summary is not truncated here the way a player
// card truncates it -- this surface exists to inspect the snapshot, and a
// cut sentence is the one thing an operator cannot check. Genre, game mode, platform and release used to share
// one undifferentiated strip of badges and one 13px line per platform, which
// stated everything and separated nothing. It renders nothing when no
// metadata is present, so local-only Games and missing enrichment snapshots
// need no special casing at the call sites.
templ AdminIGDBMetadata(facts AdminGameFacts) {
	if !facts.empty() {
		<div class="igdb-facts">
			if facts.Summary != "" {
				<p class="igdb-summary">{ facts.Summary }</p>
			}
			if facts.GameType != "" {
				@igdbFact("Type") {
					<span class="igdb-value">{ facts.GameType }</span>
				}
			}
			if len(facts.GenreNames) > 0 {
				@igdbFact("Genres") {
					for _, name := range facts.GenreNames {
						<span class="igdb-chip">{ name }</span>
					}
				}
			}
			if len(facts.GameModeNames) > 0 {
				@igdbFact("Modes") {
					for _, name := range facts.GameModeNames {
						<span class="igdb-chip">{ name }</span>
					}
				}
			}
			if len(facts.PlatformNames) > 0 {
				@igdbFact("Platforms") {
					<span class="igdb-value">{ strings.Join(facts.PlatformNames, ", ") }</span>
				}
			}
			if facts.FirstReleaseDate != nil {
				@igdbFact("Released") {
					<span class="data-text igdb-value">{ strconv.Itoa(facts.FirstReleaseDate.Year()) }</span>
				}
			}
			if len(facts.MultiplayerModes) > 0 {
				@igdbFact("Multiplayer") {
					<ul class="igdb-platforms">
						for _, mode := range facts.MultiplayerModes {
							<li class="igdb-platform">
								<span class="igdb-platform-name">{ multiplayerPlatformLabel(mode) }</span>
								<span class="igdb-platform-values">
									for _, capability := range multiplayerCapabilities(mode) {
										<span class="igdb-chip">{ capability }</span>
									}
									for _, limit := range multiplayerLimits(mode) {
										<span class="igdb-chip igdb-chip-limit">{ limit }</span>
									}
									if len(multiplayerCapabilities(mode)) == 0 && len(multiplayerLimits(mode)) == 0 {
										<span class="igdb-value">No multiplayer detail reported</span>
									}
								</span>
							</li>
						}
					</ul>
				}
			}
		</div>
	}
}

// igdbFact is one labelled row. The label is a fixed-basis flex item rather
// than a grid column, so every row aligns without a breakpoint and the
// values wrap under it on a narrow panel.
templ igdbFact(label string) {
	<div class="igdb-fact">
		<span class="igdb-fact-label">{ label }</span>
		<span class="igdb-fact-values">
			{ children... }
		</span>
	</div>
}

// multiplayerPlatformLabel names the platform one multiplayer mode belongs
// to, falling back to the raw provider platform ID when IGDB reported no
// name for it.
func multiplayerPlatformLabel(mode game.MultiplayerMode) string {
	if mode.PlatformName != "" {
		return mode.PlatformName
	}
	if mode.PlatformIGDBID > 0 {
		return "IGDB platform #" + strconv.FormatInt(mode.PlatformIGDBID, 10)
	}
	return "Platform unspecified"
}

// multiplayerCapabilities lists what one platform supports, each capability
// carrying its own reported player cap. IGDB reports the caps in separate
// fields from the flags, and listing them separately produced a run of bare
// numbers ("online co-op max 8 online max 12") that had to be matched back
// to the capability they belonged to by hand.
func multiplayerCapabilities(mode game.MultiplayerMode) []string {
	var parts []string
	if mode.CampaignCoop {
		parts = append(parts, "Campaign co-op")
	}
	if mode.DropIn {
		parts = append(parts, "Drop-in")
	}
	if mode.LanCoop {
		parts = append(parts, "LAN co-op")
	}
	if mode.OfflineCoop {
		parts = append(parts, withPlayerCap("Offline co-op", mode.OfflineCoopMax))
	}
	if mode.OnlineCoop {
		parts = append(parts, withPlayerCap("Online co-op", mode.OnlineCoopMax))
	}
	if mode.SplitScreen {
		parts = append(parts, "Split-screen")
	}
	if mode.SplitScreenOnline {
		parts = append(parts, "Split-screen online")
	}
	return parts
}

// multiplayerLimits lists the platform's overall player caps, which belong
// to no single capability. An absent cap is omitted rather than shown as
// zero; it was never reported.
func multiplayerLimits(mode game.MultiplayerMode) []string {
	var parts []string
	if mode.OnlineMax != nil {
		parts = append(parts, "Up to "+strconv.Itoa(*mode.OnlineMax)+" online")
	}
	if mode.OfflineMax != nil {
		parts = append(parts, "Up to "+strconv.Itoa(*mode.OfflineMax)+" offline")
	}
	return parts
}

func withPlayerCap(capability string, max *int) string {
	if max == nil {
		return capability
	}
	return capability + " (max " + strconv.Itoa(*max) + ")"
}

templ AdminGameMerge(brand branding.Brand, navigation components.NavigationState, target, source game.Game, games []game.Game, sourceID, formError string, notice components.Notice) {
	@components.Layout(brand, "Merge Games", navigation) {
		<header class="app-topbar">
			<div class="min-w-0">
				<h1 class="app-title">Merge duplicate Game</h1>
				<p class="text-sm text-base-content/70">{ target.Name } is the target. It keeps its local ID, name, slug, and active state.</p>
			</div>
			<a class="btn btn-quiet btn-sm" href="/admin/games"><i class="ph ph-arrow-left" aria-hidden="true"></i>Back to catalog</a>
		</header>
		<div class="content-page">
			<div class="max-w-4xl">
					@components.NoticeAlert(notice, "mb-4")
				if formError != "" {
					<div role="alert" class="alert alert-error mb-4"><span>{ formError }</span></div>
				}
				<section class="detail-card">
					<h2 class="text-[1.0625rem] font-semibold">Choose source Game</h2>
					<p class="text-sm text-base-content/70">The source is removed after its Game Requests, followers, aliases, and IGDB identity move to the target.</p>
					<form method="get" action={ "/admin/games/" + target.ID + "/merge" } class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-end">
						<label class="form-control flex-1"><span class="label"><span class="label-text">Source Game</span></span>
							<select class="select select-bordered w-full" name="source" required>
								<option value="">Choose duplicate</option>
								for _, candidate := range games {
									if candidate.ID != target.ID {
										<option value={ candidate.ID } selected?={ candidate.ID == sourceID }>{ candidate.Name } · { candidate.Slug }</option>
									}
								}
							</select>
						</label>
						<button class="btn btn-quiet" type="submit"><i class="ph ph-git-merge" aria-hidden="true"></i>Review merge</button>
					</form>
				</section>
				if source.ID != "" {
					<section class="detail-card mt-4">
						<h2 class="text-[1.0625rem] font-semibold">Review</h2>
						<dl class="grid gap-4 sm:grid-cols-2">
							<div><dt class="text-sm text-base-content/60">Source · removed</dt><dd class="font-semibold">{ source.Name }</dd><dd class="data-text text-xs">{ source.Slug }</dd><dd class="mt-1 text-sm text-base-content/70">{ gameRelationshipSummary(source) }</dd></div>
							<div><dt class="text-sm text-base-content/60">Target · kept</dt><dd class="font-semibold">{ target.Name }</dd><dd class="data-text text-xs">{ target.Slug }</dd><dd class="mt-1 text-sm text-base-content/70">{ gameRelationshipSummary(target) }</dd></div>
						</dl>
						if source.IGDBExternalID != "" && target.IGDBExternalID != "" {
							<div role="alert" class="alert alert-warning"><span>Both Games have different IGDB links. Unlink the incorrect record before merging.</span></div>
						} else {
							<form method="post" action={ "/admin/games/" + target.ID + "/merge" } class="flex justify-end" data-confirm={ "Merge " + source.Name + " into " + target.Name + "? The source Game will be permanently removed." }>
								@components.CSRFInput()
								<input type="hidden" name="source_id" value={ source.ID }/>
								<button class="btn btn-danger" type="submit"><i class="ph ph-git-merge" aria-hidden="true"></i>Merge and remove source</button>
							</form>
						}
					</section>
				}
			</div>
		</div>
	}
}

func gameRelationshipSummary(item game.Game) string {
	parts := []string{strconv.FormatInt(item.GameRequestCount, 10) + " Game Requests", strconv.FormatInt(item.SubscriptionCount, 10) + " followers"}
	if item.IGDBExternalID == "" {
		parts = append(parts, "local-only")
	} else {
		parts = append(parts, "IGDB #"+item.IGDBExternalID)
	}
	return strings.Join(parts, " · ")
}

templ AdminIGDB(brand branding.Brand, navigation components.NavigationState, status game.ProviderStatus, notice components.Notice) {
	@components.Layout(brand, "IGDB Synchronization", navigation) {
		<header class="app-topbar">
			<div class="min-w-0">
				<h1 class="app-title">IGDB synchronization</h1>
				<p class="text-sm text-base-content/70">The local discovery index players search, and its background refresh.</p>
			</div>
		</header>
		<div class="content-page">
			<div class="max-w-4xl">
					@components.NoticeAlert(notice, "mb-4")
				@AdminIGDBStatus(status)
			</div>
		</div>
	}
}

// AdminIGDBStatus is the status card on /admin/igdb and the fragment
// GET /admin/igdb/status returns. While a sync is in progress it polls that
// route; the response replaces this very element, and the settled state
// renders without the polling attributes, so the loop stops by itself once
// the sync finishes. No client script and no separate stop condition.
templ AdminIGDBStatus(status game.ProviderStatus) {
	<section id="igdb-status" class="detail-card" { syncStatusAttributes(status.State)... }>
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h2 class="text-[1.0625rem] font-semibold">Status</h2>
			@igdbStatusBadge(status.State)
		</div>
		<dl class="grid gap-4 sm:grid-cols-3">
			<div>
				<dt class="text-sm text-base-content/60">Last attempt</dt>
				<dd class="data-text">{ igdbTimestamp(status.LastAttempt) }</dd>
			</div>
			<div>
				<dt class="text-sm text-base-content/60">Last success</dt>
				<dd class="data-text">{ igdbTimestamp(status.LastSuccess) }</dd>
			</div>
			<div>
				<dt class="text-sm text-base-content/60">Indexed records</dt>
				<dd class="data-text">{ strconv.FormatInt(status.RecordCount, 10) }</dd>
			</div>
			if status.State == game.ProviderSyncing {
				<div>
					<dt class="text-sm text-base-content/60">Staged in this sync</dt>
					<dd class="data-text">{ strconv.FormatInt(status.StagedRecords, 10) }</dd>
				</div>
			}
		</dl>
		if status.LastError != "" {
			<div role="alert" class="alert alert-error"><span>{ status.LastError }</span></div>
		}
		if status.State != game.ProviderDisabled && status.State != game.ProviderSyncing {
			<form method="post" action="/admin/igdb/sync" class="flex justify-end">
				@components.CSRFInput()
				<button class="btn btn-primary btn-sm" type="submit"><i class="ph ph-arrows-clockwise" aria-hidden="true"></i>Sync now</button>
			</form>
		}
	</section>
}

// syncStatusAttributes makes the status card reload itself while a sync is in
// progress. The polling element is the element the response replaces, so the
// state that no longer carries these attributes is also the state that stops
// polling. aria-live is added only then, so a settled card never re-announces
// itself on an ordinary page load.
func syncStatusAttributes(state game.ProviderState) templ.Attributes {
	if state == game.ProviderSyncing {
		return templ.Attributes{
			"aria-live":  "polite",
			"hx-get":     "/admin/igdb/status",
			"hx-trigger": "every 2s",
			"hx-swap":    "outerHTML",
		}
	}
	return nil
}

templ igdbStatusBadge(state game.ProviderState) {
	if state == game.ProviderCurrent {
		<span class="badge badge-primary">Current</span>
	} else if state == game.ProviderSyncing {
		<span class="badge badge-info">Syncing</span>
	} else if state == game.ProviderFailed {
		<span class="badge badge-error">Failed</span>
	} else if state == game.ProviderStale {
		<span class="badge badge-warning">Stale</span>
	} else if state == game.ProviderDisabled {
		<span class="badge badge-ghost">Disabled</span>
	} else {
		<span class="badge badge-outline">Not synced</span>
	}
}

templ AdminError(brand branding.Brand, navigation components.NavigationState) {
	@components.Layout(brand, "Administration error", navigation) {
		<header class="app-topbar"><h1 class="app-title">Administration</h1></header>
		<div class="content-page"><div role="alert" class="alert alert-error"><div><p class="font-bold">Administration could not be loaded</p><p>Try the request again.</p></div></div></div>
	}
}

// PWADiagnostics carries the server-known facts the /admin/pwa page renders
// unconditionally. Browser-only facts (secure context, registration state,
// controller, last error) are filled in by admin-pwa.ts and read "Not
// available without JavaScript" until then.
type PWADiagnostics struct {
	InstanceName     string
	BaseURL          string
	ManifestURL      string
	ServiceWorkerURL string
	SecureContext    bool
}

templ AdminPWA(brand branding.Brand, navigation components.NavigationState, diagnostics PWADiagnostics) {
	@components.Layout(brand, "PWA Diagnostics", navigation) {
		<header class="app-topbar">
			<div class="min-w-0">
				<h1 class="app-title">PWA diagnostics</h1>
				<p class="text-sm text-base-content/70">Read-only facts about this installation. Nothing here is stored or shown to players.</p>
			</div>
		</header>
		<div class="content-page">
			<div class="grid max-w-5xl gap-4 xl:grid-cols-2">
				<section class="detail-card">
					<h2 class="text-[1.0625rem] font-semibold">Server</h2>
					<dl class="grid gap-4 sm:grid-cols-2">
						<div><dt class="text-sm text-base-content/60">Instance name</dt><dd class="data-text break-words">{ diagnostics.InstanceName }</dd></div>
						<div><dt class="text-sm text-base-content/60">Base URL</dt><dd class="data-text break-words">{ diagnostics.BaseURL }</dd></div>
						<div><dt class="text-sm text-base-content/60">Manifest URL</dt><dd class="data-text break-words">{ diagnostics.ManifestURL }</dd></div>
						<div><dt class="text-sm text-base-content/60">Service worker URL</dt><dd class="data-text break-words">{ diagnostics.ServiceWorkerURL }</dd></div>
						<div class="sm:col-span-2"><dt class="text-sm text-base-content/60">Expected secure context</dt><dd class="data-text">{ secureContextLabel(diagnostics.SecureContext) }</dd></div>
					</dl>
				</section>
				<section class="detail-card" data-pwa-diagnostics>
					<h2 class="text-[1.0625rem] font-semibold">Browser</h2>
					<dl class="grid gap-4 sm:grid-cols-2">
						<div><dt class="text-sm text-base-content/60">Diagnostics ran</dt><dd class="data-text" data-fact="diagnostics-ran">No</dd></div>
						<div><dt class="text-sm text-base-content/60">window.isSecureContext</dt><dd class="data-text" data-fact="secure-context">Not available without JavaScript</dd></div>
						<div><dt class="text-sm text-base-content/60">Service worker supported</dt><dd class="data-text" data-fact="supported">Not available without JavaScript</dd></div>
						<div><dt class="text-sm text-base-content/60">Registration</dt><dd class="data-text" data-fact="registration">Not available without JavaScript</dd></div>
						<div><dt class="text-sm text-base-content/60">Controller</dt><dd class="data-text" data-fact="controller">Not available without JavaScript</dd></div>
						<div><dt class="text-sm text-base-content/60">Last registration error</dt><dd class="data-text" data-fact="error">Not available without JavaScript</dd></div>
					</dl>
				</section>
			</div>
		</div>
		<script src={ brand.Assets.AdminPWADiagnostics } defer></script>
	}
}

func secureContextLabel(secure bool) string {
	if secure {
		return "Yes"
	}
	return "No (HTTPS, or a loopback/localhost origin, is required for PWA installation and Web Push)"
}

func igdbTimestamp(value *time.Time) string {
	if value == nil {
		return "Never"
	}
	return value.UTC().Format("2006-01-02T15:04Z")
}
templ AdminDiscordDelivery(brand branding.Brand, navigation components.NavigationState, destination notification.DiscordDestination, notice components.Notice) {
	@components.Layout(brand, "Discord delivery", navigation) {
		<header class="app-topbar">
			<div class="min-w-0">
				<h1 class="app-title">Discord delivery</h1>
				<p class="text-sm text-base-content/70">Configure the instance destination for Game Request notifications. Discord login stays separate.</p>
			</div>
		</header>
		<div class="content-page">
			<div class="max-w-4xl">
					@components.NoticeAlert(notice, "mb-4")
				if destination.State == notification.DiscordDestinationConnected {
					<section class="detail-card">
						<div class="flex flex-wrap items-center justify-between gap-3">
							<div>
								<h2 class="text-[1.0625rem] font-semibold">Connected</h2>
								if destination.WebhookName != "" {
									<p>{ destination.WebhookName }</p>
								}
							</div>
							<span class="status-chip status-chip-open">Connected</span>
						</div>
						<dl class="mt-4 grid gap-4 sm:grid-cols-2">
							<div><dt class="text-sm text-base-content/60">Guild ID</dt><dd class="data-text break-all">{ destination.GuildID }</dd></div>
							<div><dt class="text-sm text-base-content/60">Channel ID</dt><dd class="data-text break-all">{ destination.ChannelID }</dd></div>
							<div><dt class="text-sm text-base-content/60">Connected</dt><dd><time class="data-text" datetime={ destination.ConnectedAt.Format(time.RFC3339) }>{ destination.ConnectedAt.UTC().Format(time.RFC3339) }</time></dd></div>
						</dl>
						<div class="mt-4 flex flex-wrap justify-end gap-2">
							<form method="post" action="/admin/discord/reconnect">
								@components.CSRFInput()
								<button class="btn btn-quiet btn-sm" type="submit"><i class="ph ph-arrows-clockwise" aria-hidden="true"></i>Reconnect</button>
							</form>
							<form method="post" action="/admin/discord/disconnect" data-confirm="Disconnect this Discord destination? Existing messages stay in Discord.">
								@components.CSRFInput()
								<button class="btn btn-danger btn-sm" type="submit"><i class="ph ph-plugs" aria-hidden="true"></i>Disconnect</button>
							</form>
						</div>
					</section>
				} else if destination.State == notification.DiscordDestinationBroken {
					<section class="detail-card">
						<div class="flex flex-wrap items-center justify-between gap-3">
							<div>
								<h2 class="text-[1.0625rem] font-semibold">Broken</h2>
								<p role="alert" class="text-sm text-error">Reconnect is required.</p>
								if destination.WebhookName != "" {
									<p>{ destination.WebhookName }</p>
								}
							</div>
							<span class="status-chip status-chip-cancelled">Broken</span>
						</div>
						<dl class="mt-4 grid gap-4 sm:grid-cols-2">
							<div><dt class="text-sm text-base-content/60">Guild ID</dt><dd class="data-text break-all">{ destination.GuildID }</dd></div>
							<div><dt class="text-sm text-base-content/60">Channel ID</dt><dd class="data-text break-all">{ destination.ChannelID }</dd></div>
							<div><dt class="text-sm text-base-content/60">Broken</dt><dd><time class="data-text" datetime={ destination.BrokenAt.Format(time.RFC3339) }>{ destination.BrokenAt.UTC().Format(time.RFC3339) }</time></dd></div>
							if destination.BrokenReason != "" {
								<div class="sm:col-span-2"><dt class="text-sm text-base-content/60">Reason</dt><dd>{ destination.BrokenReason }</dd></div>
							}
						</dl>
						<div class="mt-4 flex flex-wrap justify-end gap-2">
							<form method="post" action="/admin/discord/reconnect">
								@components.CSRFInput()
								<button class="btn btn-primary btn-sm" type="submit"><i class="ph ph-arrows-clockwise" aria-hidden="true"></i>Reconnect</button>
							</form>
							<form method="post" action="/admin/discord/disconnect" data-confirm="Disconnect this Discord destination? Existing messages stay in Discord.">
								@components.CSRFInput()
								<button class="btn btn-danger btn-sm" type="submit"><i class="ph ph-plugs" aria-hidden="true"></i>Disconnect</button>
							</form>
						</div>
					</section>
				} else {
					<section class="detail-card">
						<h2 class="text-[1.0625rem] font-semibold">Not configured</h2>
						<p class="mt-1 text-sm text-base-content/70">Connect a Discord destination to deliver Game Request notifications.</p>
						<form method="post" action="/admin/discord/connect" class="mt-4 flex justify-end">
							@components.CSRFInput()
							<button class="btn btn-primary btn-sm" type="submit"><i class="ph ph-plugs-connected" aria-hidden="true"></i>Connect</button>
						</form>
					</section>
				}
			</div>
		</div>
	}
}
