package pages

import (
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

templ AdminMetrics(brand branding.Brand, navigation components.NavigationState, configured bool, key string) {
	@components.Layout(brand, "Metrics", navigation) {
		<header class="app-topbar">
			<div class="min-w-0">
				<h1 class="app-title">Metrics</h1>
				<p class="text-sm text-base-content/70">Allow Prometheus to scrape aggregate operational and product metrics.</p>
			</div>
		</header>
		<div class="content-page">
			<section class="detail-card max-w-4xl">
				<h2 class="text-[1.0625rem] font-semibold">Metrics API Key</h2>
				if key != "" {
					<div role="status" class="mt-4">
						<p class="font-semibold">Save this key now. It will not be shown again.</p>
						<label class="mt-3 block text-sm" for="metrics-api-key">New Metrics API Key</label>
						<input id="metrics-api-key" class="input data-text mt-1 w-full" type="text" value={ key } readonly autocomplete="off" spellcheck="false"/>
						<p class="mt-2 text-sm text-base-content/70">Any previous key is invalid. Update your Prometheus credentials file.</p>
					</div>
				} else if configured {
					<p class="mt-2 text-sm">Enabled. One Metrics API Key is active; its value cannot be retrieved.</p>
				} else {
					<p class="mt-2 text-sm">Disabled. Generate a key to enable authenticated scraping.</p>
				}
				<p class="mt-4 text-sm text-base-content/70">Send <code>Authorization: Bearer &lt;metrics-api-key&gt;</code> to <code>GET /metrics</code> over HTTPS. This key grants metrics access only.</p>
				<form method="post" action="/admin/metrics/key" class="mt-4 flex justify-end" data-confirm={ metricsRotationConfirmation(configured) }>
					@components.CSRFInput()
					<button class="btn btn-primary btn-sm" type="submit">
						if configured {
							Rotate Metrics API Key
						} else {
							Generate Metrics API Key
						}
					</button>
				</form>
			</section>
		</div>
	}
}

func metricsRotationConfirmation(configured bool) string {
	if configured {
		return "Rotate the Metrics API Key? The current key will stop working immediately."
	}
	return ""
}
