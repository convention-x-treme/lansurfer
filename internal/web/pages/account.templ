package pages

import (
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

// AccountIdentityRow is one linked provider identity as shown to its own
// owner. PrivateName/PrivateEmail are provider-account metadata, never
// public identity, and this page is the only surface that renders them.
type AccountIdentityRow struct {
	Kind         string
	Label        string
	PrivateName  string
	PrivateEmail string
	CanUnlink    bool
	UnlinkPath   string
	// ID, HasAvatar, and AvatarSelected drive the avatar source choice.
	ID             string
	HasAvatar      bool
	AvatarSelected bool
}

// AccountProviderOption offers a configured provider the account has not
// linked yet.
type AccountProviderOption struct {
	Kind  string
	Label string
	Href  string
}

templ Account(brand branding.Brand, navigation components.NavigationState, currentGameNick, avatarKey string, identities []AccountIdentityRow, linkable []AccountProviderOption, linkError bool, gameNickInput, gameNickError string) {
	@components.Layout(brand, "Account", navigation) {
		<header class="app-topbar">
			<h1 class="app-title">Account</h1>
			<a class="btn btn-quiet btn-sm" href="/account/notifications"><i class="ph ph-bell" aria-hidden="true"></i>Notification settings</a>
		</header>
		<div class="content-page account-page">
			if linkError {
				<div role="alert" class="alert alert-error">
					<span>That sign-in method could not be linked. It may already belong to a different LANsurfer account.</span>
				</div>
			}
			<div class="account-identity">
				@components.Avatar("avatar-placeholder account-avatar", currentGameNick, avatarKey)
				<div class="min-w-0">
					<p class="account-identity-nick">{ currentGameNick }</p>
					<p class="text-sm text-base-content/70">How other players see you on Game Requests and request activity.</p>
				</div>
			</div>
			<section class="account-section" aria-labelledby="account-game-nick">
				<div class="account-section-intro">
					<h2 id="account-game-nick" class="account-section-title">Game Nick</h2>
					<p>Your public name. Unique on this LANsurfer, ignoring letter case.</p>
				</div>
				<form method="post" action="/account/game-nick" class="grid max-w-sm gap-3">
					@components.CSRFInput()
					<input class="input input-bordered w-full" type="text" name="game_nick" aria-labelledby="account-game-nick" value={ accountGameNickValue(gameNickInput, currentGameNick) } maxlength="32" required/>
					if gameNickError != "" {
						<div role="alert" class="alert alert-error text-sm">
							<span>{ gameNickError }</span>
						</div>
					}
					<button class="btn btn-primary btn-sm w-fit" type="submit">Rename</button>
				</form>
			</section>
			<section class="account-section" aria-labelledby="account-avatar">
				<div class="account-section-intro">
					<h2 id="account-avatar" class="account-section-title">Avatar</h2>
					<p>Pictures come from a linked sign-in method and are served by LANsurfer.</p>
				</div>
				<form method="post" action="/account/avatar" class="grid max-w-sm gap-3">
					@components.CSRFInput()
					<fieldset class="account-choices">
						<legend class="sr-only">Avatar source</legend>
						for _, identity := range identities {
							<label class="account-choice">
								<input class="radio radio-sm" type="radio" name="identity" value={ identity.ID } checked?={ identity.AvatarSelected } disabled?={ !identity.HasAvatar }/>
								<span class="icon-label"><i class={ providerIcon(identity.Kind) } aria-hidden="true"></i>{ identity.Label }</span>
								if !identity.HasAvatar {
									<span class="ml-auto text-xs text-base-content/60">No picture</span>
								}
							</label>
						}
						<label class="account-choice">
							<input class="radio radio-sm" type="radio" name="identity" value="default" checked?={ avatarKey == "" }/>
							<span>Default <span class="text-base-content/60">(Game Nick initial)</span></span>
						</label>
					</fieldset>
					<button class="btn btn-primary btn-sm w-fit" type="submit">Save avatar</button>
				</form>
			</section>
			<section class="account-section" aria-labelledby="account-sign-in">
				<div class="account-section-intro">
					<h2 id="account-sign-in" class="account-section-title">Sign-in methods</h2>
					<p>Provider names and emails are visible only to you.</p>
				</div>
				<div class="grid max-w-lg gap-3">
					<ul class="account-choices">
						for _, identity := range identities {
							<li class="account-identity-row">
								<div class="min-w-0">
									<p class="icon-label font-semibold"><i class={ providerIcon(identity.Kind) } aria-hidden="true"></i>{ identity.Label }</p>
									if identity.PrivateName != "" {
										<p class="truncate text-xs text-base-content/70">{ identity.PrivateName }</p>
									}
									if identity.PrivateEmail != "" {
										<p class="truncate text-xs text-base-content/70">{ identity.PrivateEmail }</p>
									}
								</div>
								if identity.CanUnlink {
									<form method="post" action={ templ.SafeURL(identity.UnlinkPath) }>
										@components.CSRFInput()
										<button class="btn btn-ghost btn-sm" type="submit"><i class="ph ph-link-break" aria-hidden="true"></i>Unlink</button>
									</form>
								} else {
									<span class="shrink-0 text-xs text-base-content/60">Only sign-in method</span>
								}
							</li>
						}
					</ul>
					if len(linkable) > 0 {
						<div class="flex flex-wrap gap-2">
							for _, option := range linkable {
								<form method="post" action={ templ.SafeURL(option.Href) }>
									@components.CSRFInput()
									<button class="btn btn-quiet btn-sm" type="submit"><i class={ providerIcon(option.Kind) } aria-hidden="true"></i>Link { option.Label }</button>
								</form>
							}
						</div>
					}
				</div>
			</section>
		</div>
	}
}

func accountGameNickValue(input, current string) string {
	if input != "" {
		return input
	}
	return current
}
