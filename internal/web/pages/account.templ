package pages

import (
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

// AccountIdentityRow is one linked provider identity as shown to its own
// owner. PrivateName/PrivateEmail are provider-account metadata, never
// public identity, and this page is the only surface that renders them.
type AccountIdentityRow struct {
	Label        string
	PrivateName  string
	PrivateEmail string
	CanUnlink    bool
	UnlinkPath   string
}

// AccountProviderOption offers a configured provider the account has not
// linked yet.
type AccountProviderOption struct {
	Label string
	Href  string
}

templ Account(brand branding.Brand, navigation components.NavigationState, currentGameNick string, identities []AccountIdentityRow, linkable []AccountProviderOption, linkError bool, gameNickInput, gameNickError string) {
	@components.Layout(brand, "Account", navigation) {
		<header class="app-topbar">
			<h1 class="app-title">Account</h1>
		</header>
		<div class="content-page grid gap-6">
			if linkError {
				<div role="alert" class="alert alert-error">
					<span>That sign-in method could not be linked. It may already belong to a different LANsurfer account.</span>
				</div>
			}
			<section class="auth-panel">
				<h2 class="text-xl font-bold">Game Nick</h2>
				<p class="mt-1 text-sm text-base-content/70">Your public name on Game Requests and request activity.</p>
				<form method="post" action="/account/game-nick" class="mt-4 grid max-w-sm gap-3">
					@components.CSRFInput()
					<input class="input input-bordered w-full" type="text" name="game_nick" value={ accountGameNickValue(gameNickInput, currentGameNick) } maxlength="32" required/>
					if gameNickError != "" {
						<div role="alert" class="alert alert-error text-sm">
							<span>{ gameNickError }</span>
						</div>
					}
					<button class="btn btn-primary btn-sm w-fit" type="submit">Rename</button>
				</form>
			</section>
			<section class="auth-panel">
				<h2 class="text-xl font-bold">Linked sign-in methods</h2>
				<ul class="mt-4 grid gap-3">
					for _, identity := range identities {
						<li class="flex items-center justify-between gap-3 rounded-field border border-base-300 p-3">
							<div class="min-w-0">
								<p class="font-semibold">{ identity.Label }</p>
								if identity.PrivateName != "" {
									<p class="truncate text-xs text-base-content/70">{ identity.PrivateName }</p>
								}
								if identity.PrivateEmail != "" {
									<p class="truncate text-xs text-base-content/70">{ identity.PrivateEmail }</p>
								}
							</div>
							if identity.CanUnlink {
								<form method="post" action={ templ.SafeURL(identity.UnlinkPath) }>
									@components.CSRFInput()
									<button class="btn btn-ghost btn-sm" type="submit">Unlink</button>
								</form>
							} else {
								<span class="text-xs text-base-content/50">Only sign-in method</span>
							}
						</li>
					}
				</ul>
				if len(linkable) > 0 {
					<div class="mt-4 grid gap-2">
						for _, option := range linkable {
							<form method="post" action={ templ.SafeURL(option.Href) }>
								@components.CSRFInput()
								<button class="btn btn-quiet btn-sm w-full justify-start" type="submit">Link { option.Label }</button>
							</form>
						}
					</div>
				}
			</section>
		</div>
	}
}

func accountGameNickValue(input, current string) string {
	if input != "" {
		return input
	}
	return current
}
