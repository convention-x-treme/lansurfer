package pages

import (
	"strconv"
	"strings"

	"github.com/convention-x-treme/lansurfer/internal/game"
)

// GameIdentity is the shared player-facing rendering of one Game's name,
// cover/abbreviation, and disambiguating metadata. It renders identically
// whether the underlying Game is already an authoritative local Game or
// still exists only in the synchronized IGDB index (spec: "4.1 One
// player-facing Game card") -- it never renders a materialization-origin
// label. compact selects the tight single-line presentation used in list
// rows (cover when known, else the abbreviation tile, plus name only); the
// full presentation adds a cover/abbreviation tile at card size plus a
// metadata line underneath the name.
templ GameIdentity(p game.GamePresentation, compact bool) {
	if compact {
		if p.CoverImageID != "" {
			<img class="h-[2.125rem] w-[2.125rem] flex-none rounded object-cover bg-base-300" src={ providerCoverURL(p.CoverImageID) } alt="" referrerpolicy="no-referrer" loading="lazy" data-cover-fallback="true"/>
			<span class="game-abbreviation" aria-hidden="true" hidden>{ gameAbbreviation(p.Name) }</span>
		} else {
			<span class="game-abbreviation" aria-hidden="true">{ gameAbbreviation(p.Name) }</span>
		}
		<span class="min-w-0 truncate font-semibold">{ p.Name }</span>
	} else {
		<div class="flex items-center gap-3">
			if p.CoverImageID != "" {
				<img class="h-12 w-9 flex-none rounded object-cover bg-base-300" src={ providerCoverURL(p.CoverImageID) } alt="" referrerpolicy="no-referrer" loading="lazy" data-cover-fallback="true"/>
				<span class="game-abbreviation" aria-hidden="true" hidden>{ gameAbbreviation(p.Name) }</span>
			} else {
				<span class="game-abbreviation" aria-hidden="true">{ gameAbbreviation(p.Name) }</span>
			}
			<span class="min-w-0">
				<strong class="block truncate text-base font-semibold">{ p.Name }</strong>
				<span class="data-text block truncate text-xs text-base-content/65">{ presentationSecondary(p) }</span>
			</span>
		</div>
	}
}

// providerCoverURL constructs the approved images.igdb.com cover URL from
// only the persisted cover_image_id (spec: "Covers"). It never accepts or
// echoes any other provider-supplied metadata; the CSP img-src allowlist and
// Referrer-Policy: no-referrer safeguards live in internal/web/middleware.
func providerCoverURL(coverImageID string) string {
	return "https://images.igdb.com/igdb/image/upload/t_cover_small/" + coverImageID + ".jpg"
}

// presentationSecondary renders type/platform/release disambiguation when
// enrichment is known (spec: "4.2 Same-name Games"), falling back to the
// local slug for a Game that has never been materialized through IGDB.
func presentationSecondary(p game.GamePresentation) string {
	if metadata := presentationMetadata(p); metadata != "" {
		return metadata
	}
	return p.Slug
}

func presentationMetadata(p game.GamePresentation) string {
	parts := make([]string, 0, 3)
	if p.GameType != "" {
		parts = append(parts, p.GameType)
	}
	if len(p.PlatformNames) > 0 {
		parts = append(parts, strings.Join(p.PlatformNames, ", "))
	}
	if p.FirstReleaseDate != nil {
		parts = append(parts, strconv.Itoa(p.FirstReleaseDate.Year()))
	}
	return strings.Join(parts, " · ")
}
