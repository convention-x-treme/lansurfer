package pages

import (
	"fmt"
	"net/url"
	"strings"
	"time"
	"unicode"

	"github.com/convention-x-treme/lansurfer/internal/game"
	"github.com/convention-x-treme/lansurfer/internal/gamerequest"
	requestquery "github.com/convention-x-treme/lansurfer/internal/query/gamerequest"
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

type GameRequestForm struct {
	GameID         string
	Provider       string
	ExternalID     string
	MaxPlayers     string
	StartPreset    string
	StartDate      string
	StartTime      string
	StartsAt       string
	TimezoneOffset string
	Description    string
}

templ GameRequestList(brand branding.Brand, navigation components.NavigationState, filter requestquery.Filter, requests []requestquery.Request, trending []requestquery.TrendingGame, openRequests int64, message, notice string) {
	@components.Layout(brand, "Game Requests", navigationWithCount(navigation, openRequests)) {
		<header class="app-topbar">
			<div class="min-w-0">
				<h1 class="app-title">Game Requests</h1>
				@RequestStats(requests, false)
			</div>
			<a class="btn btn-primary btn-sm" href="/game-requests/new">Create Game Request</a>
		</header>
		<div class="request-shell">
			<div class="request-main">
				if notice != "" {
					<div role="status" class="alert alert-info mb-4"><span>{ notice }</span></div>
				}
				@RequestFilters(filter)
				@GameRequestListContent(brand, requests, filter, navigation.Viewer, "", false, nil, message)
			</div>
			<aside class="request-rail" aria-label="Game Request summary">
				@TrendingSection(trending, false)
			</aside>
		</div>
	}
}

// RequestFilters submits normally without scripting and swaps only the list
// with htmx, so discovery stays server-rendered either way. Typing filters
// directly after a short pause; the button is the no-scripting submit path.
//
// The URL is replaced rather than pushed: a debounced keystroke that pushed
// history would bury the previous page under one entry per pause. hx-sync drops
// an in-flight search when the next one starts, so the list cannot settle on a
// stale response that arrived late.
templ RequestFilters(filter requestquery.Filter) {
	<form
		class="request-toolbar"
		method="get"
		action="/game-requests"
		hx-get="/game-requests"
		hx-target="#game-request-list"
		hx-swap="outerHTML"
		hx-replace-url="true"
		hx-sync="this:replace"
		hx-trigger="submit, change from:(.filter-toggle input), input changed delay:300ms from:(#request-search), search from:(#request-search)"
	>
		<label class="sr-only" for="request-search">Search Game Requests by game name or alias</label>
		<input id="request-search" class="input input-sm request-search" type="search" name="q" value={ filter.Search } maxlength="120" placeholder="Search by name or alias, e.g. wc3" autocomplete="off"/>
		<label class="filter-toggle"><input class="checkbox checkbox-sm" type="checkbox" name="followed" value="1" checked?={ filter.FollowedOnly }/><span>My Games</span></label>
		<label class="filter-toggle"><input class="checkbox checkbox-sm" type="checkbox" name="open_places" value="1" checked?={ filter.OpenPlacesOnly }/><span>Free places</span></label>
		<button class="btn btn-quiet btn-sm" type="submit">Filter</button>
	</form>
}

// RequestStats is swapped out of band by the list refresh, so the counts and the
// timestamp in the top bar stay in step with the rows below them. htmx resolves
// an out-of-band swap through the id of the element carrying the attribute, so
// the attribute belongs on this element rather than on a wrapper around it.
templ RequestStats(requests []requestquery.Request, oob bool) {
	<p id="request-stats" class="mt-1 text-sm text-base-content/70" { outOfBand(oob)... }><span class="data-text count-open font-bold">{ fmt.Sprint(playersInRequests(requests)) }</span>{ playersInRequestsLabel(requests) }<span class="data-text">{ updatedLabel() }</span></p>
}

// TrendingSection ranks games from Game Request activity inside the window the
// read model states. A quiet period leaves it sparse or empty on purpose.
templ TrendingSection(trending []requestquery.TrendingGame, oob bool) {
	<section id="trending-rail" class="rail-section" { outOfBand(oob)... }>
		<div class="flex items-baseline justify-between gap-3"><h2 class="text-[0.9375rem] font-semibold">Trending</h2><span class="data-text text-xs text-base-content/65">{ trendingWindowLabel() }</span></div>
		if len(trending) == 0 {
			<p class="text-sm text-base-content/70">No Game Request activity in the last { trendingHours() }. It stays quiet until something happens.</p>
		} else {
			<ul class="grid gap-3">
				for _, entry := range trending {
					<li class="flex items-center justify-between gap-3">
						<a class="link min-w-0 truncate text-sm font-semibold text-base-content/80 no-underline" href={ templ.SafeURL("/game-requests?q=" + url.QueryEscape(entry.GameName)) }>{ entry.GameName }</a>
						<span class={ trendingCountClass(entry.ActivityCount) } aria-label={ trendingAccessibleLabel(entry) }>{ fmt.Sprint(entry.ActivityCount) }</span>
					</li>
				}
			</ul>
		}
		<a class="link text-sm text-primary no-underline" href="/games">Browse games</a>
	</section>
}

templ GameRequestListContent(brand branding.Brand, requests []requestquery.Request, filter requestquery.Filter, viewer *components.Viewer, highlightedID string, refresh bool, trending []requestquery.TrendingGame, message string) {
	if refresh {
		@RequestStats(requests, true)
		if trending != nil {
			@TrendingSection(trending, true)
		}
	}
	<div id="game-request-list" data-game-request-list data-filter-query={ filterQuery(filter) } aria-live="polite" aria-busy="false">
		if message != "" {
			<div role="alert" class="alert alert-error mb-4"><span>{ message }</span></div>
		}
		<div class="request-list-skeleton" aria-hidden="true">
			for range 3 {
				<div class="request-skeleton-row"><span></span><span></span><span></span></div>
			}
		</div>
		<div class="request-list-content">
			if len(requests) == 0 && filter.Active() {
				<section class="request-empty" aria-labelledby="empty-request-title">
					<img src={ brand.Assets.Mascot } alt=""/>
					<div>
						<h2 id="empty-request-title" class="text-2xl font-bold">No Game Request matches that.</h2>
						<p class="mt-2 max-w-xl text-base-content/70">Try a different name or alias, or clear the filters to see everything open.</p>
						<a class="btn btn-quiet btn-sm mt-5" href="/game-requests">Clear filters</a>
					</div>
				</section>
			} else if len(requests) == 0 {
				<section class="request-empty" aria-labelledby="empty-request-title">
					<img src={ brand.Assets.Mascot } alt=""/>
					<div>
						<h2 id="empty-request-title" class="text-2xl font-bold">Quiet out there. Start something?</h2>
						<p class="mt-2 max-w-xl text-base-content/70">No open requests right now. Post one so other players can join.</p>
						<a class="btn btn-primary btn-sm mt-5" href="/game-requests/new">Create Game Request</a>
					</div>
				</section>
			} else {
				<div class="mb-2 flex items-center justify-between gap-4">
					<p class="section-label">
						{ openRequestsLabel(len(requests), filter) }
						if filter.Active() {
							<a class="link ml-2 font-semibold text-primary no-underline" href="/game-requests">Clear filters</a>
						}
					</p>
					<p class="data-text hidden text-xs text-base-content/65 sm:block" aria-hidden="true">places · start</p>
					<span class="sr-only">Player places and start times follow each game name.</span>
				</div>
				<div class="request-list">
					for _, request := range requests {
						@GameRequestRow(request, viewerID(viewer), highlightedID)
					}
				</div>
			}
		</div>
	</div>
	if gameName, followed := followedHighlight(requests, highlightedID); followed {
		<div hx-swap-oob="beforeend:#live-notices" role="status" class="alert alert-info" data-live-toast data-visibility-target={ highlightedID }>
			<span>New Game Request for { gameName }.</span>
			<button type="button" class="btn btn-ghost btn-sm" data-dismiss-live-toast aria-label="Dismiss notification">Dismiss</button>
		</div>
	}
}

templ GameRequestRow(request requestquery.Request, viewerID, highlightedID string) {
	<article id={ "game-request-" + request.ID } class={ gameRequestRowClass(request, highlightedID) } data-game-request-id={ request.ID }>
		<a class="request-row-main" href={ "/game-requests/" + request.ID }>
			@GameIdentity(request.Game, true)
			if request.CreatorID == viewerID {
				<span class="status-chip status-chip-host">Host</span>
			} else if request.ViewerJoined {
				<span class="status-chip status-chip-joined">Joined</span>
			} else if lastPlace(request) {
				<span class="status-chip status-chip-last">Last place</span>
			} else if requestFull(request) {
				<span class="status-chip">Full</span>
			}
		</a>
		<span class={ playerCountClass(request) } aria-label={ playerCountAccessible(request) }>{ playerCount(request) }</span>
		<time class={ startTimeClass(request.StartsAt) } datetime={ request.StartsAt.Format(time.RFC3339) }>{ startLabel(request.StartsAt) }</time>
		<div class="request-row-action">
			if request.Status != gamerequest.StatusOpen {
				<span class="action-static">{ requestActionLabel(request) }</span>
			} else if request.CreatorID == viewerID {
				<a class="btn btn-quiet btn-sm" href={ "/game-requests/" + request.ID }>View</a>
			} else if request.ViewerJoined {
				<form method="post" action={ "/game-requests/" + request.ID + "/leave" } hx-post={ "/game-requests/" + request.ID + "/leave" } hx-target="closest article" hx-swap="outerHTML" hx-sync="closest article:drop" hx-disabled-elt="find button">
					@components.CSRFInput()
					<input type="hidden" name="return_to" value="list"/>
					<button class="btn btn-step-back btn-sm" type="submit">Leave</button>
				</form>
			} else if requestFull(request) {
				<span class="action-static">Full</span>
			} else {
				<form method="post" action={ "/game-requests/" + request.ID + "/join" } hx-post={ "/game-requests/" + request.ID + "/join" } hx-target="closest article" hx-swap="outerHTML" hx-sync="closest article:drop" hx-disabled-elt="find button">
					@components.CSRFInput()
					<input type="hidden" name="return_to" value="list"/>
					<button class={ joinButtonClass(request) } type="submit">Join</button>
				</form>
			}
		</div>
	</article>
}

// NewGameRequest is the Game Request composer (Task 7): discovery-first,
// exactly like /games (Task 4), rather than a dropdown of pre-existing
// Games. It never materializes a provider Game itself -- selected already
// carries whatever discovery.Select found (page.SearchTooShort/HasMore rules
// from Task 3), and only the final validated Create POST ever calls
// GameResolver.Resolve.
//
// showDetails controls #game-request-details independently of selected:
// New() only ever shows it once selected != nil, but a failed Create POST
// (Task 7 Step 9) keeps every already-typed request detail visible (and
// showDetails true) even when the previously selected provider Game just
// became unavailable and selected is nil again, so the player can pick a
// replacement without retyping max players/start/description.
templ NewGameRequest(brand branding.Brand, navigation components.NavigationState, page game.DiscoveryPage, selected *game.DiscoveryItem, showDetails bool, search string, form GameRequestForm, message string) {
	@components.Layout(brand, "Create Game Request", navigation) {
		<header class="app-topbar">
			<a class="link count-open text-sm font-semibold no-underline" href="/game-requests">← Game Requests</a>
		</header>
		<div class="content-page">
			<div class="composer-panel">
				<div><h1 class="app-title">Who's up for a round?</h1><p class="mt-1 text-sm text-base-content/70">Pick a game, a start time, and how many players can join.</p></div>
				if message != "" {
					<div role="alert" class="alert alert-error mt-5"><span>{ message }</span></div>
				}
				if selected != nil {
					@GameRequestSelectedGame(*selected)
				}
				if showDetails {
					<form method="post" action="/game-requests" class="mt-6 grid gap-6">
						@components.CSRFInput()
						if selected != nil {
							@GameRequestGameFields(*selected, false)
						}
						@GameRequestDetailsFields(form)
						<div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end"><a class="btn btn-ghost" href="/game-requests">Cancel</a><button class="btn btn-primary sm:min-w-64" type="submit">Create Game Request</button></div>
					</form>
				}
				if selected == nil {
					<div class="mt-6 mb-2">
						<h2 class="text-[1.0625rem] font-semibold">Find your game</h2>
						<p class="text-sm text-base-content/70">Search the game catalog to start a Game Request.</p>
					</div>
					@GameRequestDiscoverySearchForm(search, false)
					@GameRequestDiscovery(page, search, false)
				}
			</div>
		</div>
	}
}

// GameRequestSelectedGame is the composer's read-only display of the
// currently selected Game (either an authoritative local Game or an
// unmaterialized provider result, rendered identically via GameIdentity --
// spec: "4.1 One player-facing Game card"). Its nested "Change game" panel
// is the only place the composer's ajax reselection (GameRequestDiscovery
// with changeGame=true, Selection's htmx swap) is ever reachable, so
// #game-request-game-fields and #game-request-details already exist by the
// time any of those controls can fire.
templ GameRequestSelectedGame(item game.DiscoveryItem) {
	<div id="game-request-selected-game" class="detail-card">
		<p class="section-label">Game</p>
		@GameIdentity(item.GamePresentation, false)
		<details class="mt-3" data-change-game>
			<summary class="btn btn-quiet btn-sm">Change game</summary>
			<div class="mt-4 grid gap-4">
				@GameRequestDiscoverySearchForm("", true)
				@GameRequestDiscovery(game.DiscoveryPage{}, "", true)
			</div>
		</details>
	</div>
}

// GameRequestGameFields carries the composer's selected identity into the
// POST body: either the authoritative local Game ID, or the opaque provider
// reference alone (never a browser-supplied name/slug -- the final Create
// POST resolves/materializes the Game itself, exactly like /games' provider
// follow). oob marks the out-of-band replacement Selection sends when
// swapping in a new choice from the "Change game" panel.
templ GameRequestGameFields(item game.DiscoveryItem, oob bool) {
	<div id="game-request-game-fields" { outOfBand(oob)... }>
		if item.LocalGameID != "" {
			<input type="hidden" name="game_id" value={ item.LocalGameID }/>
		} else {
			<input type="hidden" name="provider" value={ item.Reference.Provider }/>
			<input type="hidden" name="external_id" value={ item.Reference.ExternalID }/>
		}
	</div>
}

// GameRequestDetailsFields is the request-local fields the composer's own
// Select/Discovery flow never touches (Task 7 Step 7): a "Change game"
// selection swap explicitly excludes #game-request-details, which is what
// keeps whatever the player already typed here exactly as it is in the
// browser.
templ GameRequestDetailsFields(form GameRequestForm) {
	<div id="game-request-details" class="grid gap-6">
		<div class="grid gap-6 md:grid-cols-[10rem_minmax(0,1fr)]">
			<label class="grid content-start gap-2"><span class="label-text font-medium">Max players</span><input class="input input-bordered data-text w-full text-lg" type="number" name="max_players" min="1" max="2147483647" inputmode="numeric" value={ form.MaxPlayers } placeholder="No limit"/></label>
			<fieldset class="grid gap-3" data-start-options>
				<legend class="label-text mb-2 font-medium">Start</legend>
				<div class="flex flex-wrap gap-2">
					@StartChoice("now", "Now", form.StartPreset)
					@StartChoice("15", "in 15 min", form.StartPreset)
					@StartChoice("30", "in 30 min", form.StartPreset)
					@StartChoice("60", "in 1 h", form.StartPreset)
					@StartChoice("custom", "Pick date & time", form.StartPreset)
				</div>
				<div class="custom-start-fields gap-3 rounded-md bg-base-100 p-4 sm:grid-cols-2" data-custom-start>
					<label class="grid gap-2"><span class="section-label">Date</span><input class="input input-bordered data-text w-full" type="date" name="start_date" value={ form.StartDate }/></label>
					<label class="grid gap-2"><span class="section-label">Time</span><input class="input input-bordered data-text w-full" type="time" name="start_time" value={ form.StartTime }/></label>
				</div>
			</fieldset>
		</div>
		<input type="hidden" name="timezone_offset" value={ form.TimezoneOffset } data-timezone-offset/>
		<label class="grid gap-2"><span class="label-text font-medium">Description <span class="font-normal text-base-content/65">(optional)</span></span><textarea class="textarea textarea-bordered min-h-28 w-full" name="description" maxlength="1000" placeholder="Anything players should know" data-description>{ form.Description }</textarea><span class="flex justify-between gap-4 text-xs text-base-content/65"><span>Leave max players empty for an open round.</span><span class="data-text" data-description-count>{ fmt.Sprintf("%d / 1000", len([]rune(form.Description))) }</span></span></label>
	</div>
}

// GameRequestDiscoverySearchForm is the composer's own search box, reusing
// Games' live-search interaction model (Task 4's GameSearchForm) rather than
// reinventing it. ajax selects between the composer's own first-pick search
// (a plain no-scripting GET back to the full New page) and the "Change game"
// search (a live htmx search of the dedicated discovery fragment, Task 7
// Step 6) -- the same 300ms debounce/replace-URL rules either way.
templ GameRequestDiscoverySearchForm(search string, ajax bool) {
	if ajax {
		<form
			class="request-toolbar"
			method="get"
			action="/game-requests/new/discovery"
			hx-get="/game-requests/new/discovery"
			hx-target="#game-request-discovery"
			hx-swap="outerHTML"
			hx-sync="this:replace"
			hx-replace-url="true"
			hx-trigger="submit, input changed delay:300ms from:(#game-request-change-search), search from:(#game-request-change-search)"
		>
			<label class="sr-only" for="game-request-change-search">Search by game name or alias</label>
			<input id="game-request-change-search" class="input input-sm request-search" type="search" name="q" value={ search } maxlength="120" placeholder="Search by name or alias, e.g. wc3" autocomplete="off"/>
			<button class="btn btn-quiet btn-sm" type="submit">Search</button>
		</form>
	} else {
		<form class="request-toolbar" method="get" action="/game-requests/new">
			<label class="sr-only" for="game-request-search">Search by game name or alias</label>
			<input id="game-request-search" class="input input-sm request-search" type="search" name="q" value={ search } maxlength="120" placeholder="Search by name or alias, e.g. wc3" autocomplete="off"/>
			<button class="btn btn-quiet btn-sm" type="submit">Search</button>
		</form>
	}
}

// GameRequestDiscovery renders the composer's shared discovery results,
// with the same page-state/copy rules as Games' GameCatalogResults (Task 4)
// -- reused rather than reinvented. changeGame selects the card action: false
// (the composer's own first-pick list) links a plain full-page href to
// /game-requests/new, exactly like Games' "Find Players" action; true (the
// "Change game" search, always rendered by the dedicated
// /game-requests/new/discovery fragment) additionally wires an htmx
// selection swap, so re-picking a game there never reloads the page and
// never disturbs #game-request-details.
templ GameRequestDiscovery(page game.DiscoveryPage, search string, changeGame bool) {
	<div id="game-request-discovery" aria-live="polite">
		if page.SearchTooShort {
			<p class="text-sm text-base-content/70 mb-4">Type at least 2 characters to search.</p>
		}
		if search == "" || page.SearchTooShort {
			@GameRequestDiscoveryList(page, changeGame)
		} else {
			@GameRequestSearchResults(page, search, changeGame)
		}
	</div>
}

templ GameRequestDiscoveryList(page game.DiscoveryPage, changeGame bool) {
	if len(page.Items) > 0 {
		<div class="game-grid">
			for _, item := range page.Items {
				@GameRequestDiscoveryCard(item, changeGame)
			}
		</div>
	} else {
		@GameCatalogAvailability(page.ProviderStatus, nil)
	}
}

templ GameRequestSearchResults(page game.DiscoveryPage, search string, changeGame bool) {
	if page.HasMore {
		<p class="text-sm text-base-content/70 mb-4">Too many matches — refine your search.</p>
	}
	if len(page.Items) == 0 {
		<section class="detail-card">
			<h2 class="text-[1.0625rem] font-semibold">{ fmt.Sprintf("No games found for %q", search) }</h2>
		</section>
	} else {
		<div class="game-grid">
			for _, item := range page.Items {
				@GameRequestDiscoveryCard(item, changeGame)
			}
		</div>
	}
}

// GameRequestDiscoveryCard branches on item.LocalGameID rather than
// item.Reference/Materialized -- an already-materialized row's Reference is
// not always reliably populated by the underlying query (Task 3's known
// nondeterminism), while LocalGameID is -- exactly like Games'
// gameRequestAction (Task 4).
templ GameRequestDiscoveryCard(item game.DiscoveryItem, changeGame bool) {
	<article class="game-card">
		@GameIdentity(item.GamePresentation, false)
		<div class="mt-auto flex justify-end">
			if changeGame {
				<a class="btn btn-primary btn-sm" href={ gameRequestComposerURL(item) } hx-get={ gameRequestSelectionURL(item) } hx-target="#game-request-selected-game" hx-swap="outerHTML" hx-sync="this:replace">Select</a>
			} else {
				<a class="btn btn-primary btn-sm" href={ gameRequestComposerURL(item) }>Select</a>
			}
		</div>
	</article>
}

// GameRequestSelectionSwap is Selection's htmx response body (Task 7 Step
// 7): the replacement selected-game display plus the out-of-band hidden
// identity fields, and nothing else -- deliberately never
// #game-request-details, which is what leaves the request-detail fields the
// player already typed completely undisturbed in the browser.
templ GameRequestSelectionSwap(item game.DiscoveryItem) {
	@GameRequestSelectedGame(item)
	@GameRequestGameFields(item, true)
}

templ StartChoice(value, label, selected string) {
	<label class="start-choice"><input class="sr-only" type="radio" name="start_preset" value={ value } checked?={ startPreset(selected) == value }/><span>{ label }</span></label>
}

templ GameRequestDetail(brand branding.Brand, navigation components.NavigationState, request requestquery.Request, viewerID, message, notice string) {
	@components.Layout(brand, request.Game.Name, navigation) {
		<header class="app-topbar">
			<div class="flex flex-wrap items-center gap-x-4 gap-y-1">
				<a class="link count-open text-sm font-semibold no-underline" href="/game-requests">← Game Requests</a>
				if !request.CreatedAt.IsZero() {
					<span class="text-xs text-base-content/70">{ "created " }<span class="data-text">{ clockLabel(request.CreatedAt) }</span></span>
				}
			</div>
			@DetailStamp(false)
		</header>
		<div class="content-page">
			if notice != "" {
				<div role="status" class="alert alert-info mb-4"><span>{ notice }</span></div>
			}
			if message != "" {
				<div role="alert" class="alert alert-error mb-4"><span>{ message }</span></div>
			}
			@GameRequestDetailContent(request, viewerID, false)
		</div>
	}
}

// DetailStamp is swapped out of band by the detail refresh so the top bar keeps
// pace with the counters, player list, and activity below it.
templ DetailStamp(oob bool) {
	<p id="detail-stamp" class="text-xs text-base-content/70" { outOfBand(oob)... }>{ "updated " }<span class="data-text">{ updatedLabel() }</span></p>
}

templ GameRequestDetailContent(request requestquery.Request, viewerID string, refresh bool) {
	if refresh {
		@DetailStamp(true)
	}
	<div id="game-request-detail" data-game-request-detail data-game-request-id={ request.ID } class="detail-shell">
		<div class="detail-main">
			<article class="detail-hero">
				<div class="flex flex-wrap items-start gap-4">
					<h1 class="sr-only">{ request.Game.Name }</h1>
					<div class="min-w-[12rem] flex-1">
						<div class="flex flex-wrap items-center gap-2.5">
							@GameIdentity(request.Game, false)
							<span class={ detailStatusChipClass(request) }>{ statusLabel(request.Status) }</span>
						</div>
						<p class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-base-content/70 [&>span]:whitespace-nowrap">
							<strong class={ detailCountClass(request) }>{ playerCount(request) }</strong>
							<span>players</span>
							<span aria-hidden="true">·</span>
							<span>{ startLongLabel(request.StartsAt) }</span>
						</p>
					</div>
					<div class="flex w-full flex-wrap items-center gap-2.5 sm:w-auto">
						if request.Status == gamerequest.StatusOpen && request.CreatorID != viewerID && request.ViewerJoined {
							<form method="post" action={ "/game-requests/" + request.ID + "/leave" }>@components.CSRFInput()
<button class="btn btn-step-back" type="submit">Leave</button></form>
						} else if request.Status == gamerequest.StatusOpen && request.CreatorID != viewerID && !requestFull(request) {
							<form method="post" action={ "/game-requests/" + request.ID + "/join" }>@components.CSRFInput()
<button class={ detailJoinButtonClass(request) } type="submit">Join</button></form>
						}
						<button class="btn btn-quiet btn-square" type="button" data-copy-link aria-label="Copy link to this Game Request" title="Copy link">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.5-1.5"></path></svg>
						</button>
					</div>
				</div>
				<div class="mt-4 border-t border-base-300 pt-4">
					<p class="section-label">Description</p>
					if request.Description == "" {
						<p class="mt-2 text-base-content/65">No description.</p>
					} else {
						<p class="mt-2 max-w-[48rem] whitespace-pre-wrap leading-relaxed text-base-content/80">{ request.Description }</p>
					}
				</div>
			</article>
			<section class="detail-card flex-1" aria-labelledby="players-title">
				<div class="flex flex-wrap items-baseline justify-between gap-3">
					<h2 id="players-title" class="text-[1.0625rem] font-semibold">Players</h2>
					<p class="data-text text-xs text-base-content/70">{ placesSummary(request) }</p>
				</div>
				<ul class="grid">
					for _, member := range request.Members {
						<li class="member-row">
							<span class={ memberAvatarClass(member, request) } aria-hidden="true">{ components.ViewerInitial(member.DisplayName) }</span>
							<span class="min-w-0 flex-1 truncate font-semibold">{ member.DisplayName }</span>
							if member.ID == request.CreatorID {
								<span class="status-chip status-chip-host">Host</span>
							}
							if !activityTime(member, request).IsZero() {
								<time class="member-time" datetime={ activityTime(member, request).Format(time.RFC3339) }>{ memberTimeLabel(member, request) }</time>
							}
						</li>
					}
					if lastPlace(request) {
						<li class="last-place-row">
							<span class="avatar-placeholder avatar-placeholder-outline" aria-hidden="true">+</span>
							<strong class="flex-1">Last place open</strong>
							<span class="text-xs text-base-content/65">joins update live</span>
						</li>
					}
				</ul>
			</section>
		</div>
		<aside class="detail-rail" aria-label="Game Request context">
			if request.Status == gamerequest.StatusOpen && request.CreatorID == viewerID {
				<section class="detail-card detail-card-accent">
					<p class="section-label">Host actions</p>
					<form method="post" action={ "/game-requests/" + request.ID + "/close" } data-confirm="Close this Game Request? Players will no longer be able to join.">@components.CSRFInput()
<button class="btn btn-step-back btn-sm w-full" type="submit">Close for new players</button></form>
					<form method="post" action={ "/game-requests/" + request.ID + "/cancel" } data-confirm="Cancel this Game Request? This cannot be reopened.">@components.CSRFInput()
<button class="btn btn-danger btn-sm w-full" type="submit">Cancel Game Request</button></form>
					<p class="text-xs leading-relaxed text-base-content/65">Visible to the host only. Cancelling asks once and notifies every player.</p>
				</section>
			}
			<section class="detail-card">
				<p class="section-label">Game</p>
				<p class="text-[1.0625rem] font-semibold">{ request.Game.Name }</p>
				<div class="flex items-center justify-between gap-3 text-xs text-base-content/70">
					<span>In My Games</span>
					if request.ViewerSubscribed {
						<span class="count-open font-semibold">followed</span>
					} else {
						<span>not followed</span>
					}
				</div>
				<a class="link count-open text-sm font-semibold no-underline" href={ templ.SafeURL("/game-requests?q=" + url.QueryEscape(request.Game.Name)) }>More rounds of this game →</a>
			</section>
			<section class="detail-card flex-1">
				<p class="section-label">Activity</p>
				if len(request.Activity) == 0 {
					<p class="text-sm text-base-content/70">No activity recorded yet.</p>
				} else {
					<ol class="grid gap-3">
						for _, entry := range request.Activity {
							<li class="flex gap-3">
								if !entry.OccurredAt.IsZero() {
									<time class="data-text w-12 flex-none text-xs text-base-content/70" datetime={ entry.OccurredAt.Format(time.RFC3339) }>{ clockLabel(entry.OccurredAt) }</time>
								}
								<span class="flex-1 text-sm text-base-content/80">{ activityLabel(entry) }</span>
							</li>
						}
					</ol>
				}
				<p class="mt-auto text-xs leading-relaxed text-base-content/65">Counter, player list and activity update without a reload. Leaving removes a player from the round, not from this history.</p>
			</section>
		</aside>
	</div>
}

templ GameRequestError(brand branding.Brand, navigation components.NavigationState) {
	@components.Layout(brand, "Game Requests unavailable", navigation) {
		<header class="app-topbar"><h1 class="app-title">Game Requests</h1></header>
		<section class="content-page"><div role="alert" class="alert alert-error"><div><p class="font-bold">Game Requests could not be loaded</p><p>Try the request again.</p></div><a class="btn btn-quiet btn-sm" href="/game-requests">Retry</a></div></section>
	}
}

// gameRequestComposerURL builds the full-page composer selection URL for one
// discovery item -- the composer's own first-pick "Select" action, and the
// no-scripting fallback href alongside changeGame's htmx action.
func gameRequestComposerURL(item game.DiscoveryItem) string {
	if item.LocalGameID != "" {
		return "/game-requests/new?game_id=" + url.QueryEscape(item.LocalGameID)
	}
	return "/game-requests/new?provider=" + url.QueryEscape(item.Reference.Provider) +
		"&external_id=" + url.QueryEscape(item.Reference.ExternalID)
}

// gameRequestSelectionURL builds the read-only Selection fragment URL (Task
// 7 Step 7) for one discovery item, used only by the "Change game" panel's
// htmx selection swap.
func gameRequestSelectionURL(item game.DiscoveryItem) string {
	if item.LocalGameID != "" {
		return "/game-requests/new/selection?game_id=" + url.QueryEscape(item.LocalGameID)
	}
	return "/game-requests/new/selection?provider=" + url.QueryEscape(item.Reference.Provider) +
		"&external_id=" + url.QueryEscape(item.Reference.ExternalID)
}

templ GameRequestActionError(message string) {
	<div role="alert" class="alert alert-error" data-live-toast><span>{ message }</span><button type="button" class="btn btn-ghost btn-sm" data-dismiss-live-toast aria-label="Dismiss error">Dismiss</button></div>
}

func requestFull(request requestquery.Request) bool {
	return request.MaxPlayers != nil && request.MemberCount >= int64(*request.MaxPlayers)
}

func lastPlace(request requestquery.Request) bool {
	return request.MaxPlayers != nil && request.Status == gamerequest.StatusOpen && request.MemberCount+1 == int64(*request.MaxPlayers)
}

func playerCount(request requestquery.Request) string {
	if request.MaxPlayers == nil {
		return fmt.Sprintf("%d/∞", request.MemberCount)
	}
	return fmt.Sprintf("%d/%d", request.MemberCount, *request.MaxPlayers)
}

func playerCountAccessible(request requestquery.Request) string {
	if request.MaxPlayers == nil {
		return fmt.Sprintf("%d players, no limit", request.MemberCount)
	}
	return fmt.Sprintf("%d of %d players", request.MemberCount, *request.MaxPlayers)
}

func playerCountClass(request requestquery.Request) string {
	// A cancelled or closed request has no open places, so its counter must not
	// keep the colour that means "places left".
	if requestFull(request) || request.Status != gamerequest.StatusOpen {
		return "place-counter count-muted"
	}
	if lastPlace(request) {
		return "place-counter count-last"
	}
	return "place-counter count-open"
}

func joinButtonClass(request requestquery.Request) string {
	if lastPlace(request) {
		return "btn btn-urgent btn-sm"
	}
	return "btn btn-primary btn-sm"
}

// detailJoinButtonClass carries the same action level as the list row. Sea Foam
// is a label colour in docs/BRANDING.md, not an action fill.
func detailJoinButtonClass(request requestquery.Request) string {
	if lastPlace(request) {
		return "btn btn-urgent"
	}
	return "btn btn-primary"
}

func gameRequestRowClass(request requestquery.Request, highlightedID string) string {
	classes := "request-row"
	if request.ID == highlightedID {
		classes += " request-row-incoming"
	}
	if request.ViewerJoined {
		classes += " request-row-joined"
	}
	if lastPlace(request) {
		classes += " request-row-last"
	}
	if requestFull(request) || request.Status != gamerequest.StatusOpen {
		classes += " request-row-closed"
	}
	return classes
}

func statusLabel(status gamerequest.Status) string {
	text := string(status)
	if text == "" {
		return ""
	}
	return strings.ToUpper(text[:1]) + text[1:]
}

func detailStatusChipClass(request requestquery.Request) string {
	switch request.Status {
	case gamerequest.StatusCancelled:
		return "status-chip status-chip-cancelled"
	case gamerequest.StatusOpen:
		return "status-chip status-chip-open"
	default:
		return "status-chip"
	}
}

// detailCountClass keeps the hero counter at the kit's larger size while it
// carries the same urgency colours as the list.
func detailCountClass(request requestquery.Request) string {
	if requestFull(request) || request.Status != gamerequest.StatusOpen {
		return "place-counter place-counter-lg count-muted"
	}
	if lastPlace(request) {
		return "place-counter place-counter-lg count-last"
	}
	return "place-counter place-counter-lg count-open"
}

func memberAvatarClass(member requestquery.Member, request requestquery.Request) string {
	if member.ID == request.CreatorID {
		return "avatar-placeholder"
	}
	return "avatar-placeholder avatar-placeholder-member"
}

// activityLabel names a durable activity entry with the actor's public name.
func activityLabel(entry requestquery.Activity) string {
	switch entry.Kind {
	case gamerequest.ActivityCreated:
		return entry.ActorName + " created the request"
	case gamerequest.ActivityJoined:
		return entry.ActorName + " joined"
	case gamerequest.ActivityLeft:
		return entry.ActorName + " left"
	case gamerequest.ActivityClosed:
		return entry.ActorName + " closed the request for new players"
	case gamerequest.ActivityCancelled:
		return entry.ActorName + " cancelled the request"
	default:
		return entry.ActorName
	}
}

func startTimeClass(time.Time) string {
	return "data-text text-xs text-base-content/70"
}

func startLabel(startsAt time.Time) string {
	remaining := time.Until(startsAt)
	if remaining <= 2*time.Minute {
		return "now"
	}
	if remaining < time.Hour {
		return fmt.Sprintf("in %d min", max(1, int(remaining.Round(time.Minute)/time.Minute)))
	}
	if remaining < 24*time.Hour {
		return fmt.Sprintf("in %d h", max(1, int(remaining.Round(time.Hour)/time.Hour)))
	}
	return startsAt.Local().Format("Jan 2")
}

func startLongLabel(startsAt time.Time) string {
	if startsAt.Before(time.Now().Add(2 * time.Minute)) {
		return "starts now"
	}
	return "starts " + startLabel(startsAt)
}

// An unknown time is not rendered at all; an em dash in its place is a
// placeholder, and placeholders are not UI.
func clockLabel(value time.Time) string {
	if value.IsZero() {
		return ""
	}
	return value.Local().Format("15:04")
}

func outOfBand(oob bool) templ.Attributes {
	if oob {
		return templ.Attributes{"hx-swap-oob": "true"}
	}
	return nil
}

func gameAbbreviation(name string) string {
	words := strings.Fields(name)
	if len(words) == 0 {
		return "?"
	}
	if len(words) == 1 {
		runes := []rune(words[0])
		if len(runes) > 3 {
			runes = runes[:3]
		}
		return strings.ToUpper(string(runes))
	}
	result := make([]rune, 0, 3)
	for _, word := range words {
		if roman := romanDigit(word); roman != 0 {
			result = append(result, roman)
		} else {
			for _, value := range word {
				if unicode.IsLetter(value) || unicode.IsDigit(value) {
					result = append(result, unicode.ToUpper(value))
					break
				}
			}
		}
		if len(result) == 3 {
			break
		}
	}
	return string(result)
}

func romanDigit(word string) rune {
	switch strings.ToUpper(strings.TrimSpace(word)) {
	case "I":
		return '1'
	case "II":
		return '2'
	case "III":
		return '3'
	case "IV":
		return '4'
	case "V":
		return '5'
	default:
		return 0
	}
}

// navigationWithCount carries how many Game Requests are open on the whole
// installation, not how many the current filter matched. The badge sits in the
// shell beside every section, so a number that changed meaning with the
// viewer's filter would read as the instance suddenly going quiet.
func navigationWithCount(navigation components.NavigationState, openRequests int64) components.NavigationState {
	navigation.OpenRequests = openRequests
	return navigation
}

func updatedLabel() string {
	return time.Now().Local().Format("15:04:05")
}

// trendingWindowLabel states the window the ranking covers, as the product
// requires. Both come from the read model's own constant.
func trendingWindowLabel() string {
	return "last " + trendingHours()
}

func trendingHours() string {
	return fmt.Sprintf("%d hours", int(requestquery.TrendingWindow/time.Hour))
}

func trendingAccessibleLabel(entry requestquery.TrendingGame) string {
	if entry.RequestCount == 1 {
		return fmt.Sprintf("%d activity entries across 1 Game Request", entry.ActivityCount)
	}
	return fmt.Sprintf("%d activity entries across %d Game Requests", entry.ActivityCount, entry.RequestCount)
}

func trendingCountClass(count int64) string {
	if count >= 3 {
		return "data-text text-xs font-bold count-hot"
	}
	return "data-text text-xs font-bold count-open"
}

// openRequestsLabel says whether the list is showing everything or a filtered
// selection, so a short list never reads as "nothing is happening".
func openRequestsLabel(count int, filter requestquery.Filter) string {
	if filter.Active() {
		if count == 1 {
			return "1 matching open request"
		}
		return fmt.Sprintf("%d matching open requests", count)
	}
	if count == 1 {
		return "1 open request"
	}
	return fmt.Sprintf("%d open requests", count)
}

// filterQuery hands the active filters to app.ts so a live refresh reloads the
// same selection the player is looking at.
func filterQuery(filter requestquery.Filter) string {
	values := url.Values{}
	if filter.Search != "" {
		values.Set("q", filter.Search)
	}
	if filter.FollowedOnly {
		values.Set("followed", "1")
	}
	if filter.OpenPlacesOnly {
		values.Set("open_places", "1")
	}
	return values.Encode()
}

// playersInRequestsLabel joins the counter to the timestamp beside it. The
// count itself is rendered separately so it keeps the data typeface.
func playersInRequestsLabel(requests []requestquery.Request) string {
	if playersInRequests(requests) == 1 {
		return " player in open requests · updated "
	}
	return " players in open requests · updated "
}

func playersInRequests(requests []requestquery.Request) int64 {
	var total int64
	for _, request := range requests {
		total += request.MemberCount
	}
	return total
}

func followedHighlight(requests []requestquery.Request, highlightedID string) (string, bool) {
	for _, request := range requests {
		if request.ID == highlightedID && request.ViewerSubscribed {
			return request.Game.Name, true
		}
	}
	return "", false
}

func viewerID(viewer *components.Viewer) string {
	if viewer == nil {
		return ""
	}
	return viewer.ID
}

func startPreset(value string) string {
	if value == "" {
		return "now"
	}
	return value
}

func placesSummary(request requestquery.Request) string {
	if request.MaxPlayers == nil {
		return fmt.Sprintf("%d players · open round", request.MemberCount)
	}
	left := int64(*request.MaxPlayers) - request.MemberCount
	if left < 0 {
		left = 0
	}
	if left == 1 {
		return fmt.Sprintf("%d of %d · 1 place left", request.MemberCount, *request.MaxPlayers)
	}
	return fmt.Sprintf("%d of %d · %d places left", request.MemberCount, *request.MaxPlayers, left)
}

// activityTime is when the player's current membership started: the creator's
// own row carries the request's creation time.
func activityTime(member requestquery.Member, request requestquery.Request) time.Time {
	if member.ID == request.CreatorID {
		return request.CreatedAt
	}
	return member.JoinedAt
}

func memberTimeLabel(member requestquery.Member, request requestquery.Request) string {
	if member.ID == request.CreatorID {
		return "created " + clockLabel(request.CreatedAt)
	}
	return "joined " + clockLabel(member.JoinedAt)
}

func requestActionLabel(request requestquery.Request) string {
	if request.Status == gamerequest.StatusCancelled {
		return "Cancelled"
	}
	return "Closed"
}
