package pages

import (
	"fmt"
	"slices"
	"strings"
	"time"
	"unicode"

	"github.com/convention-x-treme/lansurfer/internal/gamerequest"
	requestquery "github.com/convention-x-treme/lansurfer/internal/query/gamerequest"
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

type GameRequestForm struct {
	GameID string
	MaxPlayers string
	StartPreset string
	StartDate string
	StartTime string
	StartsAt string
	TimezoneOffset string
	Description string
}

templ GameRequestList(brand branding.Brand, navigation components.NavigationState, event requestquery.EventContext, requests []requestquery.Request, notice string) {
	@components.Layout(brand, "Game Requests", navigationWithCount(navigation, len(requests))) {
		<header class="app-topbar">
			<div class="min-w-0">
				<h1 class="app-title">Game Requests</h1>
				@RequestStats(requests, false)
			</div>
			<a class="btn btn-primary btn-sm" href="/game-requests/new">Create Game Request</a>
		</header>
		<div class="request-shell">
			<div class="request-main">
				if notice != "" {
					<div role="status" class="alert alert-info mb-4"><span>{ notice }</span></div>
				}
				if event.ID == "" {
					<div role="status" class="alert alert-warning mb-4"><span>An administrator must select a current Event before players can create Game Requests.</span></div>
				}
				@GameRequestListContent(brand, requests, navigation.Viewer, "", false)
			</div>
			<aside class="request-rail" aria-label="Game Request summary">
				@TrendingSection(requests)
			</aside>
		</div>
	}
}

// RequestStats is swapped out of band by the list refresh, so the counts and the
// timestamp in the top bar stay in step with the rows below them. htmx resolves
// an out-of-band swap through the id of the element carrying the attribute, so
// the attribute belongs on this element rather than on a wrapper around it.
templ RequestStats(requests []requestquery.Request, oob bool) {
	<p id="request-stats" class="mt-1 text-sm text-base-content/70" { outOfBand(oob)... }><span class="data-text count-open font-bold">{ fmt.Sprint(playersInRequests(requests)) }</span>{ playersInRequestsLabel(requests) }<span class="data-text">{ updatedLabel() }</span></p>
}

templ TrendingSection(requests []requestquery.Request) {
	<section class="rail-section">
		<div class="flex items-baseline justify-between gap-3"><h2 class="text-[0.9375rem] font-semibold">Most requested</h2><span class="data-text text-xs text-base-content/65">open requests</span></div>
		if len(requests) == 0 {
			<p class="text-sm text-base-content/70">Nothing open yet.</p>
		} else {
			<ul class="grid gap-3">
				for _, entry := range trendingGames(requests) {
					<li class="flex items-center justify-between gap-3"><span class="min-w-0 truncate text-sm font-semibold text-base-content/80">{ entry.Name }</span><span class={ trendingCountClass(entry.Count) }>{ fmt.Sprint(entry.Count) }</span></li>
				}
			</ul>
		}
		<a class="link text-sm text-primary no-underline" href="/games">Browse games</a>
	</section>
}

templ GameRequestListContent(brand branding.Brand, requests []requestquery.Request, viewer *components.Viewer, highlightedID string, refresh bool) {
	if refresh {
		@RequestStats(requests, true)
	}
	<div id="game-request-list" data-game-request-list aria-live="polite" aria-busy="false">
		<div class="request-list-skeleton" aria-hidden="true">
			for range 3 {
				<div class="request-skeleton-row"><span></span><span></span><span></span></div>
			}
		</div>
		<div class="request-list-content">
			if len(requests) == 0 {
				<section class="request-empty" aria-labelledby="empty-request-title">
					<img src={ brand.Assets.Mascot } alt=""/>
					<div>
						<h2 id="empty-request-title" class="text-2xl font-bold">Quiet out there. Start something?</h2>
						<p class="mt-2 max-w-xl text-base-content/70">No open requests right now. Post one so other players can join.</p>
						<a class="btn btn-primary btn-sm mt-5" href="/game-requests/new">Create Game Request</a>
					</div>
				</section>
			} else {
				<div class="mb-2 flex items-center justify-between gap-4">
					<p class="section-label">{ fmt.Sprintf("%d open requests", len(requests)) }</p>
					<p class="data-text hidden text-xs text-base-content/65 sm:block" aria-hidden="true">places · start</p>
					<span class="sr-only">Player places and start times follow each game name.</span>
				</div>
				<div class="request-list">
					for _, request := range requests {
						@GameRequestRow(request, viewerID(viewer), highlightedID)
					}
				</div>
			}
		</div>
	</div>
	if gameName, followed := followedHighlight(requests, highlightedID); followed {
		<div hx-swap-oob="beforeend:#live-notices" role="status" class="alert alert-info" data-live-toast data-visibility-target={ highlightedID }>
			<span>New Game Request for { gameName }.</span>
			<button type="button" class="btn btn-ghost btn-sm" data-dismiss-live-toast aria-label="Dismiss notification">Dismiss</button>
		</div>
	}
}

templ GameRequestRow(request requestquery.Request, viewerID, highlightedID string) {
	<article id={ "game-request-" + request.ID } class={ gameRequestRowClass(request, highlightedID) } data-game-request-id={ request.ID }>
		<a class="request-row-main" href={ "/game-requests/" + request.ID }>
			<span class="game-abbreviation" aria-hidden="true">{ gameAbbreviation(request.GameName) }</span>
			<span class="min-w-0 truncate font-semibold">{ request.GameName }</span>
			if request.CreatorID == viewerID {
				<span class="status-chip status-chip-host">Host</span>
			} else if request.ViewerJoined {
				<span class="status-chip status-chip-joined">Joined</span>
			} else if lastPlace(request) {
				<span class="status-chip status-chip-last">Last place</span>
			} else if requestFull(request) {
				<span class="status-chip">Full</span>
			}
		</a>
		<span class={ playerCountClass(request) } aria-label={ playerCountAccessible(request) }>{ playerCount(request) }</span>
		<time class={ startTimeClass(request.StartsAt) } datetime={ request.StartsAt.Format(time.RFC3339) }>{ startLabel(request.StartsAt) }</time>
		<div class="request-row-action">
			if request.Status != gamerequest.StatusOpen {
				<span class="action-static">{ requestActionLabel(request) }</span>
			} else if request.CreatorID == viewerID {
				<a class="btn btn-quiet btn-sm" href={ "/game-requests/" + request.ID }>View</a>
			} else if request.ViewerJoined {
				<form method="post" action={ "/game-requests/" + request.ID + "/leave" } hx-post={ "/game-requests/" + request.ID + "/leave" } hx-target="closest article" hx-swap="outerHTML" hx-sync="closest article:drop" hx-disabled-elt="find button">
					@components.CSRFInput()
					<input type="hidden" name="return_to" value="list"/>
					<button class="btn btn-step-back btn-sm" type="submit">Leave</button>
				</form>
			} else if requestFull(request) {
				<span class="action-static">Full</span>
			} else {
				<form method="post" action={ "/game-requests/" + request.ID + "/join" } hx-post={ "/game-requests/" + request.ID + "/join" } hx-target="closest article" hx-swap="outerHTML" hx-sync="closest article:drop" hx-disabled-elt="find button">
					@components.CSRFInput()
					<input type="hidden" name="return_to" value="list"/>
					<button class={ joinButtonClass(request) } type="submit">Join</button>
				</form>
			}
		</div>
	</article>
}

templ NewGameRequest(brand branding.Brand, navigation components.NavigationState, options requestquery.CreationOptions, form GameRequestForm, message string) {
	@components.Layout(brand, "Create Game Request", navigation) {
		<header class="app-topbar">
			<a class="link count-open text-sm font-semibold no-underline" href="/game-requests">← Game Requests</a>
		</header>
		<div class="content-page">
			<div class="composer-panel">
				<div><h1 class="app-title">Who's up for a round?</h1><p class="mt-1 text-sm text-base-content/70">Pick a game, a start time, and how many players can join.</p></div>
				if message != "" {
					<div role="alert" class="alert alert-error mt-5"><span>{ message }</span></div>
				}
				if options.EventID == "" {
					<div role="status" class="alert alert-warning mt-5"><span>An administrator must select a current Event before Game Requests can be created.</span></div>
				} else if len(options.Games) == 0 {
					<div role="status" class="alert alert-warning mt-5"><span>An administrator must add or activate a game first.</span></div>
				} else {
					<form method="post" action="/game-requests" class="mt-6 grid gap-6">
						@components.CSRFInput()
						<label class="grid gap-2"><span class="label-text font-medium">Game</span><select class="select select-bordered w-full" name="game_id" required><option value="" disabled selected?={ form.GameID == "" }>Choose a game</option>
							for _, game := range options.Games {
								<option value={ game.ID } selected?={ form.GameID == game.ID }>{ game.Name }</option>
							}
						</select></label>
						<div class="grid gap-6 md:grid-cols-[10rem_minmax(0,1fr)]">
							<label class="grid content-start gap-2"><span class="label-text font-medium">Max players</span><input class="input input-bordered data-text w-full text-lg" type="number" name="max_players" min="1" max="2147483647" inputmode="numeric" value={ form.MaxPlayers } placeholder="No limit"/></label>
							<fieldset class="grid gap-3" data-start-options>
								<legend class="label-text mb-2 font-medium">Start</legend>
								<div class="flex flex-wrap gap-2">
									@StartChoice("now", "Now", form.StartPreset)
									@StartChoice("15", "in 15 min", form.StartPreset)
									@StartChoice("30", "in 30 min", form.StartPreset)
									@StartChoice("60", "in 1 h", form.StartPreset)
									@StartChoice("custom", "Pick date & time", form.StartPreset)
								</div>
								<div class="custom-start-fields gap-3 rounded-md bg-base-100 p-4 sm:grid-cols-2" data-custom-start>
									<label class="grid gap-2"><span class="section-label">Date</span><input class="input input-bordered data-text w-full" type="date" name="start_date" value={ form.StartDate }/></label>
									<label class="grid gap-2"><span class="section-label">Time</span><input class="input input-bordered data-text w-full" type="time" name="start_time" value={ form.StartTime }/></label>
								</div>
							</fieldset>
						</div>
						<input type="hidden" name="timezone_offset" value={ form.TimezoneOffset } data-timezone-offset/>
						<label class="grid gap-2"><span class="label-text font-medium">Description <span class="font-normal text-base-content/65">(optional)</span></span><textarea class="textarea textarea-bordered min-h-28 w-full" name="description" maxlength="1000" placeholder="Anything players should know" data-description>{ form.Description }</textarea><span class="flex justify-between gap-4 text-xs text-base-content/65"><span>Leave max players empty for an open round.</span><span class="data-text" data-description-count>{ fmt.Sprintf("%d / 1000", len([]rune(form.Description))) }</span></span></label>
						<div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end"><a class="btn btn-ghost" href="/game-requests">Cancel</a><button class="btn btn-primary sm:min-w-64" type="submit">Create Game Request</button></div>
					</form>
				}
			</div>
		</div>
	}
}

templ StartChoice(value, label, selected string) {
	<label class="start-choice"><input class="sr-only" type="radio" name="start_preset" value={ value } checked?={ startPreset(selected) == value }/><span>{ label }</span></label>
}

templ GameRequestDetail(brand branding.Brand, navigation components.NavigationState, request requestquery.Request, viewerID, message, notice string) {
	@components.Layout(brand, request.GameName, navigation) {
		<header class="app-topbar">
			<div class="flex flex-wrap items-center gap-x-4 gap-y-1">
				<a class="link count-open text-sm font-semibold no-underline" href="/game-requests">← Game Requests</a>
				if !request.CreatedAt.IsZero() {
					<span class="text-xs text-base-content/70">{ "created " }<span class="data-text">{ clockLabel(request.CreatedAt) }</span></span>
				}
			</div>
			@DetailStamp(false)
		</header>
		<div class="content-page">
			if notice != "" {
				<div role="status" class="alert alert-info mb-4"><span>{ notice }</span></div>
			}
			if message != "" {
				<div role="alert" class="alert alert-error mb-4"><span>{ message }</span></div>
			}
			@GameRequestDetailContent(request, viewerID, false)
		</div>
	}
}

// DetailStamp is swapped out of band by the detail refresh so the top bar keeps
// pace with the counters, player list, and activity below it.
templ DetailStamp(oob bool) {
	<p id="detail-stamp" class="text-xs text-base-content/70" { outOfBand(oob)... }>{ "updated " }<span class="data-text">{ updatedLabel() }</span></p>
}

templ GameRequestDetailContent(request requestquery.Request, viewerID string, refresh bool) {
	if refresh {
		@DetailStamp(true)
	}
	<div id="game-request-detail" data-game-request-detail data-game-request-id={ request.ID } class="detail-shell">
		<div class="detail-main">
			<article class="detail-hero">
				<div class="flex flex-wrap items-start gap-4">
					<span class="game-abbreviation game-abbreviation-lg" aria-hidden="true">{ gameAbbreviation(request.GameName) }</span>
					<div class="min-w-[12rem] flex-1">
						<div class="flex flex-wrap items-center gap-2.5">
							<h1 class="text-[1.875rem] font-black leading-tight tracking-tight">{ request.GameName }</h1>
							<span class={ detailStatusChipClass(request) }>{ statusLabel(request.Status) }</span>
						</div>
						<p class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-base-content/70 [&>span]:whitespace-nowrap">
							<strong class={ detailCountClass(request) }>{ playerCount(request) }</strong>
							<span>players</span>
							<span aria-hidden="true">·</span>
							<span>{ startLongLabel(request.StartsAt) }</span>
							if request.EventName != "" {
								<span aria-hidden="true">·</span>
								<span>{ request.EventName }</span>
							}
						</p>
					</div>
					<div class="flex w-full flex-wrap items-center gap-2.5 sm:w-auto">
						if request.Status == gamerequest.StatusOpen && request.CreatorID != viewerID && request.ViewerJoined {
							<form method="post" action={ "/game-requests/" + request.ID + "/leave" }>@components.CSRFInput()<button class="btn btn-step-back" type="submit">Leave</button></form>
						} else if request.Status == gamerequest.StatusOpen && request.CreatorID != viewerID && !requestFull(request) {
							<form method="post" action={ "/game-requests/" + request.ID + "/join" }>@components.CSRFInput()<button class={ detailJoinButtonClass(request) } type="submit">Join</button></form>
						}
						<button class="btn btn-quiet btn-square" type="button" data-copy-link aria-label="Copy link to this Game Request" title="Copy link">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.5-1.5"></path></svg>
						</button>
					</div>
				</div>
				<div class="mt-4 border-t border-base-300 pt-4">
					<p class="section-label">Description</p>
					if request.Description == "" {
						<p class="mt-2 text-base-content/65">No description.</p>
					} else {
						<p class="mt-2 max-w-[48rem] whitespace-pre-wrap leading-relaxed text-base-content/80">{ request.Description }</p>
					}
				</div>
			</article>
			<section class="detail-card flex-1" aria-labelledby="players-title">
				<div class="flex flex-wrap items-baseline justify-between gap-3">
					<h2 id="players-title" class="text-[1.0625rem] font-semibold">Players</h2>
					<p class="data-text text-xs text-base-content/70">{ placesSummary(request) }</p>
				</div>
				<ul class="grid">
					for _, member := range request.Members {
						<li class="member-row">
							<span class={ memberAvatarClass(member, request) } aria-hidden="true">{ components.ViewerInitial(member.DisplayName) }</span>
							<span class="min-w-0 flex-1 truncate font-semibold">{ member.DisplayName }</span>
							if member.ID == request.CreatorID {
								<span class="status-chip status-chip-host">Host</span>
							}
							if !activityTime(member, request).IsZero() {
								<time class="member-time" datetime={ activityTime(member, request).Format(time.RFC3339) }>{ memberTimeLabel(member, request) }</time>
							}
						</li>
					}
					if lastPlace(request) {
						<li class="last-place-row">
							<span class="avatar-placeholder avatar-placeholder-outline" aria-hidden="true">+</span>
							<strong class="flex-1">Last place open</strong>
							<span class="text-xs text-base-content/65">joins update live</span>
						</li>
					}
				</ul>
			</section>
		</div>
		<aside class="detail-rail" aria-label="Game Request context">
			if request.Status == gamerequest.StatusOpen && request.CreatorID == viewerID {
				<section class="detail-card detail-card-accent">
					<p class="section-label">Host actions</p>
					<form method="post" action={ "/game-requests/" + request.ID + "/close" } data-confirm="Close this Game Request? Players will no longer be able to join.">@components.CSRFInput()<button class="btn btn-step-back btn-sm w-full" type="submit">Close for new players</button></form>
					<form method="post" action={ "/game-requests/" + request.ID + "/cancel" } data-confirm="Cancel this Game Request? This cannot be reopened.">@components.CSRFInput()<button class="btn btn-danger btn-sm w-full" type="submit">Cancel Game Request</button></form>
					<p class="text-xs leading-relaxed text-base-content/65">Visible to the host only. Cancelling asks once and notifies every player.</p>
				</section>
			}
			<section class="detail-card">
				<p class="section-label">Game</p>
				<p class="text-[1.0625rem] font-semibold">{ request.GameName }</p>
				<div class="flex items-center justify-between gap-3 text-xs text-base-content/70">
					<span>{ request.EventName }</span>
					if request.ViewerSubscribed {
						<span class="count-open font-semibold">followed</span>
					} else {
						<span>not followed</span>
					}
				</div>
				<a class="link count-open text-sm font-semibold no-underline" href="/game-requests">All Game Requests →</a>
			</section>
			<section class="detail-card flex-1">
				<p class="section-label">Activity</p>
				<ol class="grid gap-3">
					for _, member := range activityEntries(request) {
						<li class="flex gap-3">
							if !activityTime(member, request).IsZero() {
								<time class="data-text w-12 flex-none text-xs text-base-content/70" datetime={ activityTime(member, request).Format(time.RFC3339) }>{ clockLabel(activityTime(member, request)) }</time>
							}
							<span class="flex-1 text-sm text-base-content/80">
								if member.ID == request.CreatorID {
									{ member.DisplayName + " created the request" }
								} else {
									{ member.DisplayName + " joined" }
								}
							</span>
						</li>
					}
				</ol>
				<p class="mt-auto text-xs leading-relaxed text-base-content/65">Counter, player list and activity update without a reload.</p>
			</section>
		</aside>
	</div>
}

templ GameRequestError(brand branding.Brand, navigation components.NavigationState) {
	@components.Layout(brand, "Game Requests unavailable", navigation) {
		<header class="app-topbar"><h1 class="app-title">Game Requests</h1></header>
		<section class="content-page"><div role="alert" class="alert alert-error"><div><p class="font-bold">Game Requests could not be loaded</p><p>Try the request again.</p></div><a class="btn btn-quiet btn-sm" href="/game-requests">Retry</a></div></section>
	}
}

templ GameRequestActionError(message string) {
	<div role="alert" class="alert alert-error" data-live-toast><span>{ message }</span><button type="button" class="btn btn-ghost btn-sm" data-dismiss-live-toast aria-label="Dismiss error">Dismiss</button></div>
}

func requestFull(request requestquery.Request) bool {
	return request.MaxPlayers != nil && request.MemberCount >= int64(*request.MaxPlayers)
}

func lastPlace(request requestquery.Request) bool {
	return request.MaxPlayers != nil && request.Status == gamerequest.StatusOpen && request.MemberCount+1 == int64(*request.MaxPlayers)
}

func playerCount(request requestquery.Request) string {
	if request.MaxPlayers == nil {
		return fmt.Sprintf("%d/∞", request.MemberCount)
	}
	return fmt.Sprintf("%d/%d", request.MemberCount, *request.MaxPlayers)
}

func playerCountAccessible(request requestquery.Request) string {
	if request.MaxPlayers == nil {
		return fmt.Sprintf("%d players, no limit", request.MemberCount)
	}
	return fmt.Sprintf("%d of %d players", request.MemberCount, *request.MaxPlayers)
}

func playerCountClass(request requestquery.Request) string {
	// A cancelled or closed request has no open places, so its counter must not
	// keep the colour that means "places left".
	if requestFull(request) || request.Status != gamerequest.StatusOpen {
		return "place-counter count-muted"
	}
	if lastPlace(request) {
		return "place-counter count-last"
	}
	return "place-counter count-open"
}

func joinButtonClass(request requestquery.Request) string {
	if lastPlace(request) {
		return "btn btn-urgent btn-sm"
	}
	return "btn btn-primary btn-sm"
}

// detailJoinButtonClass carries the same action level as the list row. Sea Foam
// is a label colour in docs/BRANDING.md, not an action fill.
func detailJoinButtonClass(request requestquery.Request) string {
	if lastPlace(request) {
		return "btn btn-urgent"
	}
	return "btn btn-primary"
}

func gameRequestRowClass(request requestquery.Request, highlightedID string) string {
	classes := "request-row"
	if request.ID == highlightedID {
		classes += " request-row-incoming"
	}
	if request.ViewerJoined {
		classes += " request-row-joined"
	}
	if lastPlace(request) {
		classes += " request-row-last"
	}
	if requestFull(request) || request.Status != gamerequest.StatusOpen {
		classes += " request-row-closed"
	}
	return classes
}

func statusLabel(status gamerequest.Status) string {
	text := string(status)
	if text == "" {
		return ""
	}
	return strings.ToUpper(text[:1]) + text[1:]
}

func detailStatusChipClass(request requestquery.Request) string {
	switch request.Status {
	case gamerequest.StatusCancelled:
		return "status-chip status-chip-cancelled"
	case gamerequest.StatusOpen:
		return "status-chip status-chip-open"
	default:
		return "status-chip"
	}
}

// detailCountClass keeps the hero counter at the kit's larger size while it
// carries the same urgency colours as the list.
func detailCountClass(request requestquery.Request) string {
	if requestFull(request) || request.Status != gamerequest.StatusOpen {
		return "place-counter place-counter-lg count-muted"
	}
	if lastPlace(request) {
		return "place-counter place-counter-lg count-last"
	}
	return "place-counter place-counter-lg count-open"
}

func memberAvatarClass(member requestquery.Member, request requestquery.Request) string {
	if member.ID == request.CreatorID {
		return "avatar-placeholder"
	}
	return "avatar-placeholder avatar-placeholder-member"
}

// activityEntries lists the newest event first, as the kit does, without
// reordering the player list itself.
func activityEntries(request requestquery.Request) []requestquery.Member {
	entries := slices.Clone(request.Members)
	slices.Reverse(entries)
	return entries
}

func activityTime(member requestquery.Member, request requestquery.Request) time.Time {
	if member.ID == request.CreatorID {
		return request.CreatedAt
	}
	return member.JoinedAt
}

func startTimeClass(time.Time) string {
	return "data-text text-xs text-base-content/70"
}

func startLabel(startsAt time.Time) string {
	remaining := time.Until(startsAt)
	if remaining <= 2*time.Minute {
		return "now"
	}
	if remaining < time.Hour {
		return fmt.Sprintf("in %d min", max(1, int(remaining.Round(time.Minute)/time.Minute)))
	}
	if remaining < 24*time.Hour {
		return fmt.Sprintf("in %d h", max(1, int(remaining.Round(time.Hour)/time.Hour)))
	}
	return startsAt.Local().Format("Jan 2")
}

func startLongLabel(startsAt time.Time) string {
	if startsAt.Before(time.Now().Add(2 * time.Minute)) {
		return "starts now"
	}
	return "starts " + startLabel(startsAt)
}

// An unknown time is not rendered at all; an em dash in its place is a
// placeholder, and placeholders are not UI.
func clockLabel(value time.Time) string {
	if value.IsZero() {
		return ""
	}
	return value.Local().Format("15:04")
}

func outOfBand(oob bool) templ.Attributes {
	if oob {
		return templ.Attributes{"hx-swap-oob": "true"}
	}
	return nil
}

func gameAbbreviation(name string) string {
	words := strings.Fields(name)
	if len(words) == 0 {
		return "?"
	}
	if len(words) == 1 {
		runes := []rune(words[0])
		if len(runes) > 3 {
			runes = runes[:3]
		}
		return strings.ToUpper(string(runes))
	}
	result := make([]rune, 0, 3)
	for _, word := range words {
		if roman := romanDigit(word); roman != 0 {
			result = append(result, roman)
		} else {
			for _, value := range word {
				if unicode.IsLetter(value) || unicode.IsDigit(value) {
					result = append(result, unicode.ToUpper(value))
					break
				}
			}
		}
		if len(result) == 3 {
			break
		}
	}
	return string(result)
}

func romanDigit(word string) rune {
	switch strings.ToUpper(strings.TrimSpace(word)) {
	case "I":
		return '1'
	case "II":
		return '2'
	case "III":
		return '3'
	case "IV":
		return '4'
	case "V":
		return '5'
	default:
		return 0
	}
}

// updatedLabel stamps when the page rendered its data. app.ts refreshes it
// after a live list update so it never claims data is newer than it is.
func navigationWithCount(navigation components.NavigationState, openRequests int) components.NavigationState {
	navigation.OpenRequests = openRequests
	return navigation
}

func updatedLabel() string {
	return time.Now().Local().Format("15:04:05")
}

type trendingGame struct {
	Name  string
	Count int
}

// trendingGames ranks the games with the most open requests, most first and
// then alphabetically so equal counts keep a stable order.
func trendingGames(requests []requestquery.Request) []trendingGame {
	counts := make(map[string]int, len(requests))
	for _, request := range requests {
		counts[request.GameName]++
	}
	ranked := make([]trendingGame, 0, len(counts))
	for name, count := range counts {
		ranked = append(ranked, trendingGame{Name: name, Count: count})
	}
	slices.SortFunc(ranked, func(a, b trendingGame) int {
		if a.Count != b.Count {
			return b.Count - a.Count
		}
		return strings.Compare(a.Name, b.Name)
	})
	return ranked[:min(len(ranked), 5)]
}

func trendingCountClass(count int) string {
	if count >= 3 {
		return "data-text text-xs font-bold count-hot"
	}
	return "data-text text-xs font-bold count-open"
}

// playersInRequestsLabel joins the counter to the timestamp beside it. The
// count itself is rendered separately so it keeps the data typeface.
func playersInRequestsLabel(requests []requestquery.Request) string {
	if playersInRequests(requests) == 1 {
		return " player in open requests · updated "
	}
	return " players in open requests · updated "
}

func playersInRequests(requests []requestquery.Request) int64 {
	var total int64
	for _, request := range requests {
		total += request.MemberCount
	}
	return total
}

func followedHighlight(requests []requestquery.Request, highlightedID string) (string, bool) {
	for _, request := range requests {
		if request.ID == highlightedID && request.ViewerSubscribed {
			return request.GameName, true
		}
	}
	return "", false
}

func viewerID(viewer *components.Viewer) string {
	if viewer == nil {
		return ""
	}
	return viewer.ID
}

func startPreset(value string) string {
	if value == "" {
		return "now"
	}
	return value
}

func placesSummary(request requestquery.Request) string {
	if request.MaxPlayers == nil {
		return fmt.Sprintf("%d players · open round", request.MemberCount)
	}
	left := int64(*request.MaxPlayers) - request.MemberCount
	if left < 0 {
		left = 0
	}
	if left == 1 {
		return fmt.Sprintf("%d of %d · 1 place left", request.MemberCount, *request.MaxPlayers)
	}
	return fmt.Sprintf("%d of %d · %d places left", request.MemberCount, *request.MaxPlayers, left)
}

func memberTimeLabel(member requestquery.Member, request requestquery.Request) string {
	if member.ID == request.CreatorID {
		return "created " + clockLabel(request.CreatedAt)
	}
	return "joined " + clockLabel(member.JoinedAt)
}

func requestActionLabel(request requestquery.Request) string {
	if request.Status == gamerequest.StatusCancelled {
		return "Cancelled"
	}
	return "Closed"
}
