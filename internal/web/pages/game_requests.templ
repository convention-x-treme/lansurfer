package pages

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/convention-x-treme/lansurfer/internal/game"
	"github.com/convention-x-treme/lansurfer/internal/gamerequest"
	requestquery "github.com/convention-x-treme/lansurfer/internal/query/gamerequest"
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

// ComposerMessage is one server-side complaint about a submitted
// composer. Field names the control the complaint is about
// ("max_players", "start", "description"), so the message can be rendered
// with that control, wired to it through aria-describedby, and focused --
// rather than as a banner the player has to match to a field themselves.
// An empty Field is a message about the request as a whole (a Game that
// left the catalog, an infrastructure failure) and stays a page-level
// alert.
type ComposerMessage struct {
	Text  string
	Field string
}

func (m ComposerMessage) for_(field string) bool { return m.Text != "" && m.Field == field }

func (m ComposerMessage) pageLevel() bool { return m.Text != "" && m.Field == "" }

type GameRequestForm struct {
	GameID      string
	Provider    string
	ExternalID  string
	MaxPlayers  string
	StartPreset string
	StartDate   string
	StartTime   string
	StartsAt    string
	Timezone    string
	Description string
}

templ GameRequestList(brand branding.Brand, navigation components.NavigationState, filter requestquery.Filter, requests []requestquery.Request, trending []requestquery.TrendingGame, activeRequests int64, message string, notice components.Notice) {
	@components.Layout(brand, "Game Requests", navigationWithActiveCount(navigation, activeRequests)) {
		<header class="app-topbar">
			<div class="min-w-0">
				<h1 class="app-title sr-only">Game Requests</h1>
				@RequestStats(requests, false)
			</div>
			<a class="btn btn-primary btn-sm" href="/game-requests/new"><i class="ph ph-plus" aria-hidden="true"></i>Create Game Request</a>
		</header>
		<div class="request-shell">
			<div class="request-main">
				@components.NoticeAlert(notice, "mb-4")
				@RequestFilters(filter)
				@GameRequestListContent(brand, requests, filter, navigation.Viewer, "", false, nil, message)
			</div>
			<aside class="request-rail" aria-label="Game Request summary">
				@TrendingSection(trending, false)
			</aside>
		</div>
	}
}

// RequestFilters submits normally without scripting and swaps only the list
// with htmx, so discovery stays server-rendered either way. Every visible
// control filters live; the submit button renders only without scripting.
//
// The URL is replaced rather than pushed: a debounced keystroke that pushed
// history would bury the previous page under one entry per pause. hx-sync drops
// an in-flight search when the next one starts, so the list cannot settle on a
// stale response that arrived late.
templ RequestFilters(filter requestquery.Filter) {
	<form
		class="request-toolbar"
		method="get"
		action="/game-requests"
		hx-get="/game-requests"
		hx-target="#game-request-list"
		hx-swap="outerHTML"
		hx-replace-url="true"
		hx-sync="this:replace"
		hx-trigger="submit, change from:(.filter-toggle input), input changed delay:300ms from:(#request-search), search from:(#request-search)"
	>
		<label class="sr-only" for="request-search">Search Game Requests by game name or alias</label>
		<input id="request-search" class="input input-sm request-search" type="search" name="q" value={ filter.Search } maxlength="120" placeholder="Search by name or alias, e.g. wc3" autocomplete="off"/>
		<fieldset class="filter-scope">
			<legend class="sr-only">Show which Game Requests</legend>
			for _, option := range scopeOptions() {
				<label class="filter-toggle"><input class="radio radio-sm" type="radio" name="scope" value={ string(option.scope) } checked?={ filter.Scope == option.scope }/><span>{ option.label }</span></label>
			}
			<label class="filter-toggle"><input class="checkbox checkbox-sm" type="checkbox" name="open_places" value="1" checked?={ filter.OpenPlacesOnly }/><span>Free places</span></label>
		</fieldset>
		<noscript><button class="btn btn-quiet btn-sm" type="submit"><i class="ph ph-funnel" aria-hidden="true"></i>Filter</button></noscript>
	</form>
}

// RequestStats is swapped out of band by the list refresh, so the counts and the
// timestamp in the top bar stay in step with the rows below them. htmx resolves
// an out-of-band swap through the id of the element carrying the attribute, so
// the attribute belongs on this element rather than on a wrapper around it.
templ RequestStats(requests []requestquery.Request, oob bool) {
	<p id="request-stats" class="text-sm text-base-content/70" { outOfBand(oob)... }><span class="data-text count-open font-bold">{ fmt.Sprint(playersInRequests(requests)) }</span>{ playersInRequestsLabel(requests) }<time class="data-text" datetime={ updatedAt() } data-local-time="clock">{ updatedLabel() }</time></p>
}

// TrendingSection ranks games from Game Request activity inside the window the
// read model states. A quiet period leaves it sparse or empty on purpose.
//
// The rail is a column of cover art: rank is carried by the order of the
// tiles, so each entry needs no visible counter beside it. The counts stay in
// every tile's accessible name, which is also the only name a cover-only link
// has.
templ TrendingSection(trending []requestquery.TrendingGame, oob bool) {
	<section id="trending-rail" class="rail-section" { outOfBand(oob)... }>
		<div class="trending-heading"><h2 class="text-[0.9375rem] font-semibold">Trending</h2><span class="data-text text-xs text-base-content/65">{ trendingWindowLabel() }</span></div>
		if len(trending) == 0 {
			<p class="text-sm text-base-content/70">No Game Request activity in the last { trendingHours() }. It stays quiet until something happens.</p>
		} else {
			<ul class="trending-covers">
				for _, entry := range trending {
					<li>
						<a class="trending-cover" href={ templ.SafeURL("/game-requests?q=" + url.QueryEscape(entry.GameName)) } title={ entry.GameName } aria-label={ trendingAccessibleLabel(entry) }>
							@CoverArt(entry.CoverImageID, entry.GameName, false)
						</a>
					</li>
				}
			</ul>
		}
		<a class="link text-sm text-primary no-underline" href="/games">Browse more games</a>
	</section>
}

// CoverArt is the portrait cover tile shared by the Game Request list rows
// and the Trending rail: the approved IGDB cover when the Game carries one,
// and the abbreviation in its place when it does not. The abbreviation also
// stays in the markup behind a known cover as the immediate next sibling,
// which is what app.ts unhides when the remote image fails to load.
//
// priority marks the one cover a screen opens on -- the composer's chosen
// Game, the detail hero -- which is in the viewport immediately and so is
// fetched eagerly; every cover in a list stays lazy.
templ CoverArt(coverImageID, gameName string, priority bool) {
	if coverImageID != "" {
		<img class="cover-art-image" src={ providerCoverLargeURL(coverImageID) } alt="" { coverLoading(priority)... } data-cover-fallback="true"/>
		<span class="cover-art-fallback" aria-hidden="true" hidden>{ components.GameAbbreviation(gameName) }</span>
	} else {
		<span class="cover-art-fallback" aria-hidden="true">{ components.GameAbbreviation(gameName) }</span>
	}
}

templ GameRequestListContent(brand branding.Brand, requests []requestquery.Request, filter requestquery.Filter, viewer *components.Viewer, highlightedID string, refresh bool, trending []requestquery.TrendingGame, message string) {
	if refresh {
		@RequestStats(requests, true)
		if trending != nil {
			@TrendingSection(trending, true)
		}
	}
	<div id="game-request-list" data-game-request-list data-filter-query={ filterQuery(filter) } aria-live="polite" aria-busy="false">
		if message != "" {
			<div role="alert" class="alert alert-error mb-4"><span>{ message }</span></div>
		}
		<div class="request-list-skeleton" aria-hidden="true">
			for range 3 {
				<div class="request-skeleton-row"><span></span><span></span><span></span></div>
			}
		</div>
		<div class="request-list-content">
			if len(requests) == 0 && filter.Active() {
				<section class="request-empty request-empty-portrait" aria-labelledby="empty-request-title">
					<img src={ brand.Assets.MascotSad } alt="" width="287" height="352"/>
					<div>
						<h2 id="empty-request-title" class="text-2xl font-bold">No Game Request matches that.</h2>
						<p class="mt-2 max-w-xl text-pretty text-base-content/70">Try a different name or alias, or clear the filters to see everything active.</p>
						<a class="btn btn-quiet btn-sm mt-5" href="/game-requests"><i class="ph ph-funnel-x" aria-hidden="true"></i>Clear filters</a>
					</div>
				</section>
			} else if len(requests) == 0 {
				<section class="request-empty request-empty-portrait" aria-labelledby="empty-request-title">
					<img src={ brand.Assets.MascotSad } alt="" width="287" height="352"/>
					<div>
						<h2 id="empty-request-title" class="text-2xl font-bold">Quiet out there. Start something?</h2>
						<p class="mt-2 max-w-xl text-pretty text-base-content/70">No active requests right now. Post one so other players can join.</p>
						<a class="btn btn-primary btn-sm mt-5" href="/game-requests/new"><i class="ph ph-plus" aria-hidden="true"></i>Create Game Request</a>
					</div>
				</section>
			} else {
				<div class="mb-2 flex items-center justify-between gap-4">
					<p class="section-label">
						{ activeRequestsLabel(len(requests), filter) }
						if filter.Active() {
							<a class="link ml-2 font-semibold text-primary no-underline" href="/game-requests">Clear filters</a>
						}
					</p>
				</div>
				<div class="request-list">
					for _, request := range requests {
						@GameRequestRow(request, viewerID(viewer), highlightedID)
					}
				</div>
			}
		</div>
	</div>
	if gameName, followed := followedHighlight(requests, highlightedID); followed {
		<div hx-swap-oob="beforeend:#live-notices" role="status" class="alert alert-info" data-live-toast data-visibility-target={ highlightedID }>
			<i class="ph ph-bell-ringing live-toast-icon" aria-hidden="true"></i>
			<span>New Game Request for { gameName }.</span>
			<button type="button" class="btn btn-ghost btn-sm" data-dismiss-live-toast aria-label="Dismiss notification"><i class="ph ph-x" aria-hidden="true"></i>Dismiss</button>
		</div>
	}
}

// GameRequestRow is the cover row of the UI kit's Game Requests v2: the
// Game's cover art, then who is looking for what, the one-line description,
// and the places/start/state line PRODUCT asks the list to carry without a
// detail-page detour.
//
// The title is one sentence in two weights: the Game Nick and the Game are
// what a player scans for, so "is looking for" between them stays regular
// and lets the two names carry the line. A Game Request whose creator has no
// public Game Nick yet is titled by the Game alone, rather than by a dangling
// sentence or a placeholder.
//
// The description is deliberately clamped to a single line rather than
// wrapped: the row is a scanning surface, and a player-authored paragraph
// would set the height of every row around it. The whole reading block is one
// link; the Join/Leave form stays outside it, because a form inside an anchor
// is not valid markup.
templ GameRequestRow(request requestquery.Request, viewerID, highlightedID string) {
	<article id={ "game-request-" + request.ID } class={ gameRequestRowClass(request, highlightedID) } data-game-request-id={ request.ID }>
		<a class="request-row-main" href={ "/game-requests/" + request.ID }>
			<span class="request-cover">
				@CoverArt(request.Game.CoverImageID, request.Game.Name, false)
			</span>
			<span class="request-row-body">
				<span class="request-row-title">
					<span class="request-row-title-text">
						if request.CreatorGameNick != "" {
							{ request.CreatorGameNick }
							<span class="request-row-connector">{ requestRowConnector(request) }</span>
						}
						{ request.Game.Name }
					</span>
					if request.CreatorID == viewerID {
						<span class="status-chip status-chip-host flex-none">Host</span>
					}
				</span>
				if request.Description != "" {
					<span class="request-row-description">{ request.Description }</span>
				}
				<span class="request-row-meta">
					<span class="request-places">
						<span class={ playerCountClass(request) } aria-label={ playerCountAccessible(request) }>{ playerCount(request) }</span>
						<span class="data-text text-xs text-base-content/70" aria-hidden="true">players</span>
					</span>
					<time class={ startTimeClass(request.StartsAt) } datetime={ request.StartsAt.Format(time.RFC3339) } title={ components.AbsoluteTime(request.StartsAt) } data-local-time="start">{ components.StartLabel(request.StartsAt) }</time>
					if request.CreatorID != viewerID {
						if request.ViewerJoined {
							<span class="status-chip status-chip-joined">Joined</span>
						} else if lastPlace(request) {
							<span class="status-chip status-chip-last">Last place</span>
						} else if requestFull(request) {
							<span class="status-chip">Full</span>
						}
					}
				</span>
			</span>
		</a>
		<div class="request-row-action">
			if request.Status != gamerequest.StatusOpen {
				<span class="action-static">{ requestActionLabel(request) }</span>
			} else if request.CreatorID == viewerID {
				<a class="btn btn-quiet btn-sm" href={ "/game-requests/" + request.ID }><i class="ph ph-eye" aria-hidden="true"></i>View</a>
			} else if request.ViewerJoined {
				<form method="post" action={ "/game-requests/" + request.ID + "/leave" } hx-post={ "/game-requests/" + request.ID + "/leave" } hx-target="closest article" hx-swap="outerHTML" hx-sync="closest article:drop" hx-disabled-elt="find button">
					@components.CSRFInput()
					<input type="hidden" name="return_to" value="list"/>
					<button class="btn btn-step-back btn-sm" type="submit"><i class="ph ph-user-minus" aria-hidden="true"></i>Leave</button>
				</form>
			} else if requestFull(request) {
				<span class="action-static">Full</span>
			} else {
				<form method="post" action={ "/game-requests/" + request.ID + "/join" } hx-post={ "/game-requests/" + request.ID + "/join" } hx-target="closest article" hx-swap="outerHTML" hx-sync="closest article:drop" hx-disabled-elt="find button">
					@components.CSRFInput()
					<input type="hidden" name="return_to" value="list"/>
					<button class={ joinButtonClass(request) } type="submit"><i class="ph ph-user-plus" aria-hidden="true"></i>Join</button>
				</form>
			}
		</div>
	</article>
}

// NewGameRequest is the Game Request composer (Task 7): discovery-first,
// exactly like /games (Task 4), rather than a dropdown of pre-existing
// Games. It never materializes a provider Game itself -- selected already
// carries whatever discovery.Select found (page.SearchTooShort/HasMore rules
// from Task 3), and only the final validated Create POST ever calls
// GameResolver.Resolve.
//
// showDetails controls #game-request-details independently of selected:
// New() only ever shows it once selected != nil, but a failed Create POST
// (Task 7 Step 9) keeps every already-typed request detail visible (and
// showDetails true) even when the previously selected provider Game just
// became unavailable and selected is nil again, so the player can pick a
// replacement without retyping max players/start/description.
templ NewGameRequest(brand branding.Brand, navigation components.NavigationState, page game.DiscoveryPage, selected *game.DiscoveryItem, showDetails bool, search string, form GameRequestForm, message ComposerMessage) {
	@components.Layout(brand, "Create Game Request", navigation) {
		<header class="app-topbar">
			<a class="link count-open icon-label text-sm font-semibold no-underline" href="/game-requests"><i class="ph ph-arrow-left" aria-hidden="true"></i>Game Requests</a>
		</header>
		<div class="content-page">
			<div class="composer-panel">
				<div><h1 class="app-title">Who's up for a round?</h1><p class="mt-1 text-sm text-base-content/70">Pick a game, a start time, and how many players can join.</p></div>
				if message.pageLevel() {
					<div role="alert" class="alert alert-error mt-5"><span>{ message.Text }</span></div>
				}
				if showDetails {
					<form method="post" action="/game-requests" class="mt-6 grid gap-6">
						@components.CSRFInput()
						if selected != nil {
							@GameRequestSelectedGame(*selected, form)
							@GameRequestGameFields(*selected)
						}
						@GameRequestDetailsFields(form, message)
						<div class="composer-actions">
							<button class="btn btn-primary composer-commit" type="submit"><i class="ph ph-plus" aria-hidden="true"></i>Create Game Request</button>
							<a class="btn btn-ghost" href="/game-requests"><i class="ph ph-x" aria-hidden="true"></i>Cancel</a>
						</div>
					</form>
				}
				if selected == nil {
					<div class="mt-6 mb-2">
						<h2 class="text-[1.0625rem] font-semibold">Find your game</h2>
						<p class="text-sm text-base-content/70">The games you follow, or search the whole catalog.</p>
					</div>
					@GameRequestDiscoverySearchForm(search, form)
					@GameRequestDiscovery(page, search, navigation.Viewer, form)
				}
			</div>
		</div>
	}
}

// GameRequestSelectedGame is the composer's read-only display of the
// currently selected Game (either an authoritative local Game or an
// unmaterialized provider result, rendered identically -- spec: "4.1 One
// player-facing Game card"). It shows the cover and the name only: the
// player already recognised this Game well enough to pick it, so repeating
// its type/platform/release line here would be noise on the one screen
// where they are answering a different question.
//
// "Change game" is a plain link back to the composer's own pick list,
// carrying every request detail already typed, rather than an inline
// second search: one list, one way to pick, and the back/forward buttons
// work the way the player expects.
templ GameRequestSelectedGame(item game.DiscoveryItem, form GameRequestForm) {
	<div id="game-request-selected-game">
		<p class="section-label">Game</p>
		<div class="selected-game">
			<span class="selected-game-cover">
				@CoverArt(item.CoverImageID, item.Name, true)
			</span>
			<div class="selected-game-body">
				<strong class="selected-game-name">{ item.Name }</strong>
				<a class="btn btn-quiet self-start" href={ composerChangeGameURL(form) }><i class="ph ph-arrow-left" aria-hidden="true"></i>Change game</a>
			</div>
		</div>
	</div>
}

// GameRequestGameFields carries the composer's selected identity into the
// POST body: either the authoritative local Game ID, or the opaque provider
// reference alone (never a browser-supplied name/slug -- the final Create
// POST resolves/materializes the Game itself, exactly like /games' provider
// follow).
templ GameRequestGameFields(item game.DiscoveryItem) {
	<div id="game-request-game-fields">
		if item.LocalGameID != "" {
			<input type="hidden" name="game_id" value={ item.LocalGameID }/>
		} else {
			<input type="hidden" name="provider" value={ item.Reference.Provider }/>
			<input type="hidden" name="external_id" value={ item.Reference.ExternalID }/>
		}
	</div>
}

// GameRequestDetailsFields is the request-local half of the composer: max
// players, when the round starts, and an optional description. Every value
// here survives a trip back to the pick list, because "Change game" carries
// them in its own URL.
templ GameRequestDetailsFields(form GameRequestForm, message ComposerMessage) {
	<div id="game-request-details" class="grid gap-6">
		<div class="grid gap-6">
			<div class="grid content-start gap-2">
				<label class="label-text font-medium" for="max-players">Max players</label>
				<input
					id="max-players"
					class="input input-bordered data-text w-32 text-2xl placeholder:text-sm"
					type="number"
					name="max_players"
					min="0"
					max="999"
					step="1"
					inputmode="numeric"
					value={ form.MaxPlayers }
					{ fieldState("max-players-hint", message.for_("max_players"), "max-players-error")... }
				/>
				if message.for_("max_players") {
					<p id="max-players-error" class="field-error">{ message.Text }</p>
				}
				<span id="max-players-hint" class="text-xs text-base-content/65">Up to 999 players, or 0 for an open round.</span>
			</div>
			<fieldset class="grid gap-3" data-start-options { describedBy("", message.for_("start"), "start-error")... }>
				<legend class="label-text mb-2 font-medium">Start</legend>
				if message.for_("start") {
					<p id="start-error" class="field-error">{ message.Text }</p>
				}
				<div class="flex flex-wrap gap-2">
					@StartChoice("now", "Now", form.StartPreset)
					@StartChoice("15", "in 15 min", form.StartPreset)
					@StartChoice("30", "in 30 min", form.StartPreset)
					@StartChoice("60", "in 1 h", form.StartPreset)
					@StartChoice("custom", "Pick date & time", form.StartPreset)
				</div>
				<div class="custom-start-fields gap-3 rounded-md bg-base-100 p-4 sm:grid-cols-2" data-custom-start>
					<label class="grid gap-2"><span class="section-label">Date</span><input class="input input-bordered data-text w-full" type="date" name="start_date" value={ form.StartDate } { fieldState("", message.for_("start"), "start-error")... }/></label>
					<label class="grid gap-2"><span class="section-label">Time</span><input class="input input-bordered data-text w-full" type="time" name="start_time" value={ form.StartTime }/></label>
				</div>
			</fieldset>
		</div>
		<input type="hidden" name="timezone" value={ form.Timezone } data-timezone/>
		<label class="grid gap-2">
			<span class="label-text font-medium">Description <span class="font-normal text-base-content/65">(optional)</span></span>
			<textarea
				class="textarea textarea-bordered min-h-24 w-full"
				rows="3"
				name="description"
				maxlength="1000"
				placeholder="Anything players should know"
				data-description
				{ fieldState("", message.for_("description"), "description-error")... }
			>{ form.Description }</textarea>
			if message.for_("description") {
				<p id="description-error" class="field-error">{ message.Text }</p>
			}
			<span class="flex justify-end gap-4 text-xs text-base-content/65"><span class="data-text" data-description-count>{ fmt.Sprintf("%d / 1000", len([]rune(form.Description))) }</span></span>
		</label>
	</div>
}

// GameRequestDiscoverySearchForm is the composer's search box, reusing
// Games' live-search interaction model (Task 4's GameSearchForm) rather
// than reinventing it: the same 300ms debounce, no submit button to press,
// and the composer's already-typed request details riding along as hidden
// transport state so a result's plain href still preserves them.
//
// The form's action is the real composer page, not the layout-less
// discovery fragment: without JS a plain submit (the noscript button, or
// Enter in the search field) must land somewhere with page chrome, and
// hx-get alone (not hx-replace-url) is what a submit enhanced by JS
// actually uses. It also does not replace the address bar with the
// fragment's own URL, which would leave reload/back/share pointing at that
// same layout-less fragment.
templ GameRequestDiscoverySearchForm(search string, form GameRequestForm) {
	<form
		class="request-toolbar"
		data-game-request-search
		method="get"
		action="/game-requests/new"
		hx-get="/game-requests/new/discovery"
		hx-target="#game-request-discovery"
		hx-swap="outerHTML"
		hx-sync="this:replace"
		hx-trigger="submit, input changed delay:300ms from:(#game-request-search), search from:(#game-request-search)"
	>
		<label class="sr-only" for="game-request-search">Search by game name or alias</label>
		<input id="game-request-search" class="input input-sm request-search" type="search" name="q" value={ search } maxlength="120" placeholder="Search by name or alias, e.g. wc3" autocomplete="off"/>
		@GameRequestDetailsTransportFields(form)
		<noscript><button class="btn btn-quiet btn-sm" type="submit"><i class="ph ph-magnifying-glass" aria-hidden="true"></i>Search</button></noscript>
	</form>
}

// GameRequestDiscovery renders the composer's pick list, with the same
// page-state/copy rules as Games' GameCatalogResults (Task 4) -- reused
// rather than reinvented. Every card is a plain full-page link back to the
// composer, exactly like Games' "Find Players" action.
templ GameRequestDiscovery(page game.DiscoveryPage, search string, viewer *components.Viewer, form GameRequestForm) {
	<div id="game-request-discovery" aria-live="polite">
		@GameDiscoveryState(page, search, viewer, "", GameRequestDiscoveryCards(page.Items, form), gameRequestPickEmpty(search))
	</div>
}

templ GameRequestDiscoveryCards(items []game.DiscoveryItem, form GameRequestForm) {
	<div class="game-grid">
		for _, item := range items {
			@GameRequestDiscoveryCard(item, form)
		}
	</div>
}

// GameRequestDiscoveryCard is a pick row, not a catalog card: cover, title,
// and the whole row as the select control, so choosing a game is one click
// anywhere on it rather than a hunt for a button. It carries no follow
// action and no metadata line -- /games owns the catalog browsing, this list
// only picks.
templ GameRequestDiscoveryCard(item game.DiscoveryItem, form GameRequestForm) {
	<a class="pick-card" href={ gameRequestComposerURL(item, form) }>
		@gameRequestPickIdentity(item)
	</a>
}

templ gameRequestPickIdentity(item game.DiscoveryItem) {
	<span class="pick-cover">
		@CoverArt(item.CoverImageID, item.Name, false)
	</span>
	<span class="pick-name">{ item.Name }</span>
}

// GameRequestPickEmpty is the pre-search state of a player who follows
// nothing yet: the list is followed Games only, so an empty one is not an
// empty catalog and must not read like one. Searching is the way on, and it
// is already right above this panel.
templ GameRequestPickEmpty() {
	<section class="detail-card">
		<h3 class="text-[1.0625rem] font-semibold">You follow no games yet.</h3>
		<p class="text-sm text-base-content/70">Search above to pick any game from the catalog.</p>
	</section>
}

templ GameRequestDetailsTransportFields(form GameRequestForm) {
	if form.MaxPlayers != "" {
		<input type="hidden" name="max_players" value={ form.MaxPlayers }/>
	}
	if form.StartPreset != "" {
		<input type="hidden" name="start_preset" value={ form.StartPreset }/>
	}
	if form.StartDate != "" {
		<input type="hidden" name="start_date" value={ form.StartDate }/>
	}
	if form.StartTime != "" {
		<input type="hidden" name="start_time" value={ form.StartTime }/>
	}
	if form.StartsAt != "" {
		<input type="hidden" name="starts_at" value={ form.StartsAt }/>
	}
	if form.Timezone != "" {
		<input type="hidden" name="timezone" value={ form.Timezone }/>
	}
	if form.Description != "" {
		<input type="hidden" name="description" value={ form.Description }/>
	}
}

templ StartChoice(value, label, selected string) {
	<label class="start-choice"><input class="sr-only" type="radio" name="start_preset" value={ value } checked?={ startPreset(selected) == value }/><span>{ label }</span></label>
}

templ GameRequestDetail(brand branding.Brand, navigation components.NavigationState, request requestquery.Request, viewerID, message string, notice components.Notice) {
	@components.Layout(brand, request.Game.Name, navigation) {
		<header class="app-topbar">
			<div class="flex flex-wrap items-center gap-x-4 gap-y-1">
				<a class="link count-open icon-label text-sm font-semibold no-underline" href="/game-requests"><i class="ph ph-arrow-left" aria-hidden="true"></i>Game Requests</a>
				if !request.CreatedAt.IsZero() {
					<span class="text-xs text-base-content/70">{ "created " }<time class="data-text" datetime={ request.CreatedAt.Format(time.RFC3339) } title={ components.AbsoluteTime(request.CreatedAt) } data-local-time="clock">{ clockLabel(request.CreatedAt) }</time></span>
				}
			</div>
			@DetailStamp(false)
		</header>
		<div class="content-page">
			@components.NoticeAlert(notice, "mb-4")
			if message != "" {
				<div role="alert" class="alert alert-error mb-4"><span>{ message }</span></div>
			}
			@GameRequestDetailContent(request, viewerID, false)
		</div>
	}
}

// DetailStamp is swapped out of band by the detail refresh so the top bar keeps
// pace with the counters, player list, and activity below it.
templ DetailStamp(oob bool) {
	<p id="detail-stamp" class="text-xs text-base-content/70" { outOfBand(oob)... }>{ "updated " }<time class="data-text" datetime={ updatedAt() } data-local-time="clock">{ updatedLabel() }</time></p>
}

templ GameRequestDetailContent(request requestquery.Request, viewerID string, refresh bool) {
	if refresh {
		@DetailStamp(true)
	}
	<div id="game-request-detail" data-game-request-detail data-game-request-id={ request.ID } class="detail-shell">
		<div class="detail-main">
			<article class={ detailHeroClass(request) }>
				<div class="flex flex-wrap items-start gap-4">
					<span class="detail-cover">
						@CoverArt(request.Game.CoverImageID, request.Game.Name, true)
					</span>
					<div class="min-w-[12rem] flex-1">
						<div class="flex flex-wrap items-center gap-2.5">
							<h1 class="detail-title">{ request.Game.Name }</h1>
							<span class={ detailStatusChipClass(request) }>{ statusLabel(request.Status) }</span>
							if lastPlace(request) {
								<span class="status-chip status-chip-last">Last place</span>
							}
						</div>
						<p class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-base-content/70 [&>span]:whitespace-nowrap">
							<strong class={ detailCountClass(request) }>{ playerCount(request) }</strong>
							<span>players</span>
							<span class="max-sm:hidden" aria-hidden="true">·</span>
							<time class={ detailStartClass(request.StartsAt) } datetime={ request.StartsAt.Format(time.RFC3339) } title={ components.AbsoluteTime(request.StartsAt) } data-local-time="start">{ startLongLabel(request.StartsAt) }</time>
						</p>
					</div>
					<div class="flex w-full flex-wrap items-center gap-2.5 sm:w-auto">
						if request.Status == gamerequest.StatusOpen && request.CreatorID != viewerID && request.ViewerJoined {
							<form method="post" action={ "/game-requests/" + request.ID + "/leave" }>
								@components.CSRFInput()
								<button class="btn btn-step-back" type="submit"><i class="ph ph-user-minus" aria-hidden="true"></i>Leave</button>
							</form>
						} else if request.Status == gamerequest.StatusOpen && request.CreatorID != viewerID && !requestFull(request) {
							<form method="post" action={ "/game-requests/" + request.ID + "/join" }>
								@components.CSRFInput()
								<button class={ detailJoinButtonClass(request) } type="submit"><i class="ph ph-user-plus" aria-hidden="true"></i>Join</button>
							</form>
						}
						<button class="btn btn-quiet btn-square" type="button" data-copy-link aria-label="Copy link to this Game Request" title="Copy link">
							<i class="ph ph-link" aria-hidden="true"></i>
						</button>
					</div>
				</div>
				<div class="mt-4 border-t border-base-300 pt-4">
					<p class="section-label data-text">Description</p>
					if request.Description == "" {
						<p class="mt-2 text-base-content/65">No description.</p>
					} else {
						<p class="mt-2 whitespace-pre-wrap leading-relaxed text-base-content/80">{ request.Description }</p>
					}
				</div>
			</article>
			<section class="detail-card flex-1" aria-labelledby="players-title">
				<div class="flex flex-wrap items-baseline justify-between gap-3">
					<h2 id="players-title" class="text-[1.0625rem] font-semibold">Players</h2>
					<p class="data-text text-xs text-base-content/70">{ placesSummary(request) }</p>
				</div>
				<ul class="grid">
					for _, member := range request.Members {
						<li class="member-row">
							@components.Avatar(memberAvatarClass(member, request), member.GameNick, member.AvatarKey)
							<span class="min-w-0 flex-1 truncate font-semibold">{ member.GameNick }</span>
							if member.ID == request.CreatorID {
								<span class="status-chip status-chip-host">Host</span>
							}
							if !activityTime(member, request).IsZero() {
								<time class="member-time" datetime={ activityTime(member, request).Format(time.RFC3339) } title={ components.AbsoluteTime(activityTime(member, request)) } data-local-time="clock">{ memberTimeLabel(member, request) }</time>
							}
						</li>
					}
					if lastPlace(request) {
						<li class="last-place-row">
							<span class="avatar-placeholder avatar-placeholder-outline" aria-hidden="true">+</span>
							<strong class="flex-1">Last place open</strong>
							<span class="text-xs text-base-content/65">joins update live</span>
						</li>
					}
				</ul>
			</section>
			if chatOpen(request, viewerID) {
				@collapsible("main-chat", "Lobby chat", "flex-1", true, true) {
					<ol id="chat-log" class="chat-log" role="log" aria-live="polite" hx-get={ "/game-requests/" + request.ID + "/chat" } hx-trigger="load" hx-swap="outerHTML"></ol>
					<div class="chat-compose">
						<div class="flex flex-wrap gap-1.5">
							for _, quick := range quickChats {
								<form method="post" action={ "/game-requests/" + request.ID + "/chat" } hx-post={ "/game-requests/" + request.ID + "/chat" } hx-target="#chat-log" hx-swap="outerHTML" hx-disabled-elt="find button">
									@components.CSRFInput()
									<input type="hidden" name="body" value={ quick }/>
									<button class="btn btn-ghost btn-xs chat-chip" type="submit">{ quick }</button>
								</form>
							}
						</div>
						<form class="flex gap-2" method="post" action={ "/game-requests/" + request.ID + "/chat" } hx-post={ "/game-requests/" + request.ID + "/chat" } hx-target="#chat-log" hx-swap="outerHTML" hx-disabled-elt="find button" data-chat-form>
							@components.CSRFInput()
							<input class="input input-bordered min-w-0 flex-1" type="text" name="body" maxlength="1000" required autocomplete="off" placeholder="Message the lobby" aria-label="Message the lobby"/>
							<button class="btn btn-primary" type="submit">Send</button>
						</form>
						<p class="pointer-coarse:hidden text-xs text-base-content/70">Emoji: <kbd class="data-text">Win</kbd> + <kbd class="data-text">.</kbd> on Windows, <kbd class="data-text">Ctrl</kbd> + <kbd class="data-text">Cmd</kbd> + <kbd class="data-text">Space</kbd> on Mac</p>
					</div>
				}
			}
		</div>
		<aside class="detail-rail" aria-label="Game Request context">
			if request.Status == gamerequest.StatusOpen && request.CreatorID == viewerID {
				@collapsible("rail-host", "Host actions", "detail-card-accent", true, false) {
					<form method="post" action={ "/game-requests/" + request.ID + "/start" } data-confirm="Start this game? The Game Request becomes Playing and can no longer be cancelled. Close it when the game is finished.">
						@components.CSRFInput()
						<button class="btn btn-primary btn-sm w-full" type="submit"><i class="ph ph-play" aria-hidden="true"></i>Start game</button>
					</form>
					<form method="post" action={ "/game-requests/" + request.ID + "/cancel" } data-confirm="Cancel this Game Request? This cannot be reopened.">
						@components.CSRFInput()
						<button class="btn btn-danger btn-sm w-full" type="submit"><i class="ph ph-x-circle" aria-hidden="true"></i>Cancel Game Request</button>
					</form>
					<p class="text-xs leading-relaxed text-base-content/65">Visible to the Host only. Starting asks once; cancelling asks once and notifies every player.</p>
				}
			} else if request.Status == gamerequest.StatusPlaying && request.CreatorID == viewerID {
				@collapsible("rail-host", "Host actions", "detail-card-accent", true, false) {
					<form method="post" action={ "/game-requests/" + request.ID + "/close" } data-confirm="Close this game? The Game Request ends and cannot be reopened.">
						@components.CSRFInput()
						<button class="btn btn-step-back btn-sm w-full" type="submit"><i class="ph ph-prohibit" aria-hidden="true"></i>Close game</button>
					</form>
					<p class="text-xs leading-relaxed text-base-content/65">Visible to the Host only. Close the game when everyone is done.</p>
				}
			}
			@collapsible("rail-game", "Game", "", true, false) {
				<div>
					<p class="min-w-0 text-[1.0625rem] font-semibold">{ request.Game.Name }</p>
					if releaseYear(request.Game) != "" {
						<p class="data-text text-xs text-base-content/70">{ releaseYear(request.Game) }</p>
					}
				</div>
				if request.Game.Summary != "" {
					<p class="whitespace-pre-line text-sm leading-relaxed text-base-content/80">{ request.Game.Summary }</p>
				}
				if request.ViewerSubscribed {
					<span class="status-chip status-chip-joined icon-label self-start"><i class="ph-fill ph-heart" aria-hidden="true"></i>Following</span>
				} else if request.GameID != "" {
					<form method="post" action={ "/games/" + request.GameID + "/follow" }>
						@components.CSRFInput()
						<input type="hidden" name="request_id" value={ request.ID }/>
						<button class="btn btn-primary btn-sm w-full" type="submit"><i class="ph ph-heart" aria-hidden="true"></i>Follow Game</button>
					</form>
				}
				<a class="link count-open icon-label text-sm font-semibold no-underline" href={ templ.SafeURL("/game-requests?q=" + url.QueryEscape(request.Game.Name)) }>More rounds of this game<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
			}
			@collapsible("rail-activity", "Activity", "flex-1", true, false) {
				if len(request.Activity) == 0 {
					<p class="text-sm text-base-content/70">No activity recorded yet.</p>
				} else {
					<ol class="activity-list">
						for _, entry := range request.Activity {
							<li class="activity-row">
								if !entry.OccurredAt.IsZero() {
									<time class="data-text w-12 flex-none text-xs text-base-content/70" datetime={ entry.OccurredAt.Format(time.RFC3339) } title={ components.AbsoluteTime(entry.OccurredAt) } data-local-time="clock">{ clockLabel(entry.OccurredAt) }</time>
								}
								<span class="flex-1 text-sm text-base-content/80">{ activityLabel(entry) }</span>
							</li>
						}
					</ol>
				}
			}
		</aside>
	</div>
}

templ GameRequestError(brand branding.Brand, navigation components.NavigationState) {
	@components.Layout(brand, "Game Requests unavailable", navigation) {
		<header class="app-topbar"><h1 class="app-title">Game Requests</h1></header>
		<section class="content-page"><div role="alert" class="alert alert-error"><div><p class="font-bold">Game Requests could not be loaded</p><p>Try the request again.</p></div><a class="btn btn-quiet btn-sm" href="/game-requests"><i class="ph ph-arrow-clockwise" aria-hidden="true"></i>Retry</a></div></section>
	}
}

templ GameRequestActionError(message string) {
	<div role="alert" class="alert alert-error" data-live-toast><i class="ph ph-warning-circle live-toast-icon" aria-hidden="true"></i><span>{ message }</span><button type="button" class="btn btn-ghost btn-sm" data-dismiss-live-toast aria-label="Dismiss error"><i class="ph ph-x" aria-hidden="true"></i>Dismiss</button></div>
}

func requestFull(request requestquery.Request) bool {
	return request.MaxPlayers != nil && request.MemberCount >= int64(*request.MaxPlayers)
}

func lastPlace(request requestquery.Request) bool {
	return request.MaxPlayers != nil && request.Status == gamerequest.StatusOpen && request.MemberCount+1 == int64(*request.MaxPlayers)
}

func playerCount(request requestquery.Request) string {
	if request.MaxPlayers == nil {
		return fmt.Sprintf("%d/∞", request.MemberCount)
	}
	return fmt.Sprintf("%d/%d", request.MemberCount, *request.MaxPlayers)
}

func playerCountAccessible(request requestquery.Request) string {
	if request.MaxPlayers == nil {
		return fmt.Sprintf("%d players, no limit", request.MemberCount)
	}
	return fmt.Sprintf("%d of %d players", request.MemberCount, *request.MaxPlayers)
}

func playerCountClass(request requestquery.Request) string {
	// A cancelled or closed request has no open places, so its counter must not
	// keep the colour that means "places left".
	if requestFull(request) || request.Status != gamerequest.StatusOpen {
		return "place-counter count-muted"
	}
	if lastPlace(request) {
		return "place-counter count-last"
	}
	return "place-counter count-open"
}

func joinButtonClass(request requestquery.Request) string {
	if lastPlace(request) {
		return "btn btn-urgent btn-sm"
	}
	return "btn btn-primary btn-sm"
}

// detailJoinButtonClass carries the same action level as the list row. Sea Foam
// is a label colour in docs/BRANDING.md, not an action fill.
func detailJoinButtonClass(request requestquery.Request) string {
	if lastPlace(request) {
		return "btn btn-urgent"
	}
	return "btn btn-primary"
}

func gameRequestRowClass(request requestquery.Request, highlightedID string) string {
	classes := "request-row"
	if request.ID == highlightedID {
		classes += " request-row-incoming"
	}
	if request.ViewerJoined {
		classes += " request-row-joined"
	}
	if lastPlace(request) {
		classes += " request-row-last"
	}
	if request.Status == gamerequest.StatusPlaying {
		classes += " request-row-playing"
	} else if requestFull(request) || request.Status != gamerequest.StatusOpen {
		classes += " request-row-closed"
	}
	return classes
}

func statusLabel(status gamerequest.Status) string {
	text := string(status)
	if text == "" {
		return ""
	}
	return strings.ToUpper(text[:1]) + text[1:]
}

// detailHeroClass gives the hero the Sunset border a last free place already
// puts on the list row, so the page a player lands on states the same scarcity
// as the row they came from.
func detailHeroClass(request requestquery.Request) string {
	if request.Status == gamerequest.StatusPlaying {
		return "detail-hero detail-hero-playing"
	}
	if lastPlace(request) {
		return "detail-hero detail-hero-last"
	}
	return "detail-hero"
}

func detailStatusChipClass(request requestquery.Request) string {
	switch request.Status {
	case gamerequest.StatusCancelled:
		return "status-chip status-chip-cancelled"
	case gamerequest.StatusOpen:
		return "status-chip status-chip-open"
	case gamerequest.StatusPlaying:
		return "status-chip status-chip-playing"
	default:
		return "status-chip"
	}
}

// detailCountClass keeps the hero counter at the kit's larger size while it
// carries the same urgency colours as the list.
func detailCountClass(request requestquery.Request) string {
	if requestFull(request) || request.Status != gamerequest.StatusOpen {
		return "place-counter place-counter-lg count-muted"
	}
	if lastPlace(request) {
		return "place-counter place-counter-lg count-last"
	}
	return "place-counter place-counter-lg count-open"
}

func memberAvatarClass(member requestquery.Member, request requestquery.Request) string {
	if member.ID == request.CreatorID {
		return "avatar-placeholder"
	}
	return "avatar-placeholder avatar-placeholder-member"
}

// activityLabel names a durable activity entry with the actor's public name.
func activityLabel(entry requestquery.Activity) string {
	switch entry.Kind {
	case gamerequest.ActivityCreated:
		return entry.ActorGameNick + " created the request"
	case gamerequest.ActivityJoined:
		return entry.ActorGameNick + " joined"
	case gamerequest.ActivityLeft:
		return entry.ActorGameNick + " left"
	case gamerequest.ActivityClosed:
		return entry.ActorGameNick + " closed the request"
	case gamerequest.ActivityStarted:
		return entry.ActorGameNick + " started the game"
	case gamerequest.ActivityCancelled:
		return entry.ActorGameNick + " cancelled the request"
	default:
		return entry.ActorGameNick
	}
}

// startTimeClass warms a start time as it approaches and makes it loud once
// there is no time left, on the shared thresholds. Anything further out stays
// quiet, so a scanning eye only stops at the rounds that need it.
func startTimeClass(startsAt time.Time) string {
	switch components.StartUrgency(startsAt) {
	case components.UrgencyStarting:
		return "data-text text-xs font-bold count-last"
	case components.UrgencySoon:
		return "data-text text-xs font-bold count-hot"
	default:
		return "data-text text-xs text-base-content/70"
	}
}

// detailStartClass is the same rule on the detail header's start sentence,
// which inherits the quiet meta ink until the round is close.
//
// The meta line keeps its facts on one line each, which its own [&>span] rule
// can no longer do for a <time>, so the class carries the wrap rule itself.
func detailStartClass(startsAt time.Time) string {
	switch components.StartUrgency(startsAt) {
	case components.UrgencyStarting:
		return "whitespace-nowrap font-semibold count-last"
	case components.UrgencySoon:
		return "whitespace-nowrap font-semibold count-hot"
	default:
		return "whitespace-nowrap"
	}
}

// releaseYear is the one piece of catalog metadata the rail's Game card
// states outright; everything else it has room for is the summary itself.
func releaseYear(p game.GamePresentation) string {
	if p.FirstReleaseDate == nil {
		return ""
	}
	return strconv.Itoa(p.FirstReleaseDate.Year())
}

func startLongLabel(startsAt time.Time) string {
	if startsAt.Before(time.Now().Add(2 * time.Minute)) {
		return "starts now"
	}
	return "starts " + components.StartLabel(startsAt)
}

// An unknown time is not rendered at all; an em dash in its place is a
// placeholder, and placeholders are not UI.
func clockLabel(value time.Time) string {
	if value.IsZero() {
		return ""
	}
	return value.UTC().Format("15:04")
}

func outOfBand(oob bool) templ.Attributes {
	if oob {
		return templ.Attributes{"hx-swap-oob": "true"}
	}
	return nil
}

// navigationWithActiveCount carries how many Game Requests are active (`open`
// or `playing`) on the whole installation, not how many the current filter
// matched. The badge sits in the shell beside every section, so a number that
// changed meaning with the viewer's filter would read as the instance suddenly
// going quiet.
func navigationWithActiveCount(navigation components.NavigationState, activeRequests int64) components.NavigationState {
	navigation.ActiveRequests = activeRequests
	return navigation
}

func updatedLabel() string {
	return time.Now().UTC().Format("15:04:05")
}

func updatedAt() string {
	return time.Now().UTC().Format(time.RFC3339)
}

// trendingWindowLabel states the window the ranking covers, as the product
// requires. Both come from the read model's own constant.
func trendingWindowLabel() string {
	return "last " + trendingHours()
}

func trendingHours() string {
	return fmt.Sprintf("%d hours", int(requestquery.TrendingWindow/time.Hour))
}

// trendingAccessibleLabel is the whole accessible name of a Trending tile:
// the rail shows cover art alone, so the Game and its ranking inputs have
// nowhere else to be stated.
func trendingAccessibleLabel(entry requestquery.TrendingGame) string {
	entries := "entries"
	if entry.ActivityCount == 1 {
		entries = "entry"
	}
	if entry.RequestCount == 1 {
		return fmt.Sprintf("%s, %d activity %s across 1 Game Request", entry.GameName, entry.ActivityCount, entries)
	}
	return fmt.Sprintf("%s, %d activity %s across %d Game Requests", entry.GameName, entry.ActivityCount, entries, entry.RequestCount)
}

// activeRequestsLabel says whether the list is showing everything or a filtered
// selection, so a short list never reads as "nothing is happening". It counts
// the active set: `open` and `playing` alike, because a round that has started
// is still one the player can look at.
func activeRequestsLabel(count int, filter requestquery.Filter) string {
	if filter.Active() {
		if count == 1 {
			return "1 matching active request"
		}
		return fmt.Sprintf("%d matching active requests", count)
	}
	if count == 1 {
		return "1 active request"
	}
	return fmt.Sprintf("%d active requests", count)
}

// The scope chips are one exclusive choice rather than four toggles: a player
// asking for requests they created and requests for games they follow at the
// same time has no useful answer. Free places stays a separate checkbox
// because it narrows any of them.
func scopeOptions() []struct {
	scope requestquery.Scope
	label string
} {
	return []struct {
		scope requestquery.Scope
		label string
	}{
		{requestquery.ScopeAll, "All"},
		{requestquery.ScopeMyGames, "My Games"},
		{requestquery.ScopeJoined, "Joined"},
		{requestquery.ScopeMine, "Created by me"},
	}
}

// filterQuery hands the active filters to app.ts so a live refresh reloads the
// same selection the player is looking at.
func filterQuery(filter requestquery.Filter) string {
	values := url.Values{}
	if filter.Search != "" {
		values.Set("q", filter.Search)
	}
	if filter.Scope != requestquery.ScopeAll {
		values.Set("scope", string(filter.Scope))
	}
	if filter.OpenPlacesOnly {
		values.Set("open_places", "1")
	}
	return values.Encode()
}

// playersInRequestsLabel joins the counter to the timestamp beside it. The
// count itself is rendered separately so it keeps the data typeface.
func playersInRequestsLabel(requests []requestquery.Request) string {
	if playersInRequests(requests) == 1 {
		return " player in active requests · updated "
	}
	return " players in active requests · updated "
}

func playersInRequests(requests []requestquery.Request) int64 {
	var total int64
	for _, request := range requests {
		total += request.MemberCount
	}
	return total
}

func followedHighlight(requests []requestquery.Request, highlightedID string) (string, bool) {
	for _, request := range requests {
		if request.ID == highlightedID && request.ViewerSubscribed {
			return request.Game.Name, true
		}
	}
	return "", false
}

func viewerID(viewer *components.Viewer) string {
	if viewer == nil {
		return ""
	}
	return viewer.ID
}

func startPreset(value string) string {
	if value == "" {
		return "now"
	}
	return value
}

func placesSummary(request requestquery.Request) string {
	if request.MaxPlayers == nil {
		return fmt.Sprintf("%d players · open round", request.MemberCount)
	}
	left := int64(*request.MaxPlayers) - request.MemberCount
	if left < 0 {
		left = 0
	}
	if left == 1 {
		return fmt.Sprintf("%d of %d · 1 place left", request.MemberCount, *request.MaxPlayers)
	}
	return fmt.Sprintf("%d of %d · %d places left", request.MemberCount, *request.MaxPlayers, left)
}

// activityTime is when the player's current membership started: the creator's
// own row carries the request's creation time.
func activityTime(member requestquery.Member, request requestquery.Request) time.Time {
	if member.ID == request.CreatorID {
		return request.CreatedAt
	}
	return member.JoinedAt
}

func memberTimeLabel(member requestquery.Member, request requestquery.Request) string {
	if member.ID == request.CreatorID {
		return "created " + clockLabel(request.CreatedAt)
	}
	return "joined " + clockLabel(member.JoinedAt)
}

func requestActionLabel(request requestquery.Request) string {
	switch request.Status {
	case gamerequest.StatusPlaying:
		return "Playing"
	case gamerequest.StatusCancelled:
		return "Cancelled"
	default:
		return "Closed"
	}
}

func requestRowConnector(request requestquery.Request) string {
	if request.Status == gamerequest.StatusPlaying {
		return "is playing"
	}
	return "is looking for"
}

// chatOpen reports whether the viewer is shown the request chat. The chat is
// private to the Host and joined players while the request is open or playing.
func chatOpen(request requestquery.Request, viewerID string) bool {
	active := request.Status == gamerequest.StatusOpen || request.Status == gamerequest.StatusPlaying
	return active && (request.ViewerJoined || request.CreatorID == viewerID)
}

var quickChats = []string{"Ready", "Need 2 min", "On my way", "Running late", "At my seat", "Server is up", "Starting soon", "GG"}

// GameRequestChatLog replaces #chat-log; it carries no load trigger so the swap
// does not refetch itself.
// ChatCount is the message total in the chat card title. A negative count
// renders it empty until the first log load; the log refresh swaps it out of band.
templ ChatCount(count int) {
	<span
		id="main-chat-count"
		class="data-text text-base-content/70"
		if count >= 0 {
			hx-swap-oob="true"
		}
	>
		if count >= 0 {
			{ fmt.Sprintf("(%d)", count) }
		}
	</span>
}

templ GameRequestChatLog(requestID string, messages []gamerequest.Message, viewerID string) {
	<ol id="chat-log" class="chat-log" role="log" aria-live="polite">
		if len(messages) == 0 {
			<li class="text-sm text-base-content/70">No messages yet. Say hi to the lobby.</li>
		}
		for _, m := range messages {
			<li class="chat-message">
				<div class="flex items-baseline gap-2">
					<span class={ chatAuthorClass(m, viewerID) }>{ m.AuthorGameNick }</span>
					<time class="data-text text-xs text-base-content/70" datetime={ m.CreatedAt.Format(time.RFC3339) } title={ components.AbsoluteTime(m.CreatedAt) } data-local-time="clock">{ clockLabel(m.CreatedAt) }</time>
				</div>
				<p class="text-sm text-base-content/80">{ m.Body }</p>
			</li>
		}
	</ol>
	@ChatCount(len(messages))
}

func chatAuthorClass(m gamerequest.Message, viewerID string) string {
	if m.AuthorID == viewerID {
		return "text-sm font-semibold text-primary"
	}
	return "text-sm font-semibold"
}

// collapsible is a rail card the viewer can fold away; app.ts keeps the choice
// across live refreshes, which otherwise re-render each card in its default.
templ collapsible(id, title, class string, open, counter bool) {
	<details id={ id } class={ "detail-card " + class } data-collapsible open?={ open }>
		<summary class="detail-card-summary section-label">
			<span>
				{ title }
				if counter {
					@ChatCount(-1)
				}
			</span>
			<i class="ph ph-caret-down" aria-hidden="true"></i>
		</summary>
		<div class="detail-card-body">
			{ children... }
		</div>
	</details>
}
