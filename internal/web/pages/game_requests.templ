package pages

import (
	"fmt"
	"time"

	"github.com/convention-x-treme/lansurfer/internal/gamerequest"
	requestquery "github.com/convention-x-treme/lansurfer/internal/query/gamerequest"
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

type GameRequestForm struct {
	GameID string
	MaxPlayers string
	StartsAt string
	Description string
}

templ GameRequestList(brand branding.Brand, navigation components.NavigationState, requests []requestquery.Request, notice string) {
	@components.Layout(brand, "Game Requests", navigation) {
		<section class="page-shell py-10">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div><p class="data-text text-sm font-semibold uppercase tracking-widest text-secondary">Looking for players</p><h1 class="mt-2 text-3xl font-bold">Active Game Requests</h1><p class="mt-2 text-base-content/70">Find a group for the current Event or create your own.</p></div>
				<a class="btn btn-primary" href="/game-requests/new">Create Game Request</a>
			</div>
			if notice != "" {
				<div role="status" class="alert alert-info mt-6"><span>{ notice }</span></div>
			}
			if len(requests) == 0 {
				<div class="card mt-8 border border-base-300 bg-base-200"><div class="card-body"><h2 class="card-title">No active Game Requests</h2><p>Be the first to look for players at the current Event.</p><div class="card-actions"><a class="btn btn-primary btn-sm" href="/game-requests/new">Create Game Request</a></div></div></div>
			} else {
				<div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
					for _, request := range requests {
						@GameRequestCard(request)
					}
				</div>
			}
		</section>
	}
}

templ GameRequestCard(request requestquery.Request) {
	<article class="card border border-base-300 bg-base-200 shadow-sm">
		<div class="card-body gap-4">
			<div><p class="data-text text-xs uppercase tracking-wider text-secondary">{ request.EventName }</p><h2 class="card-title mt-1 text-2xl"><a class="link-hover" href={ "/game-requests/" + request.ID }>{ request.GameName }</a></h2><p class="mt-1 text-sm text-base-content/65">Created by { request.CreatorName }</p></div>
			<div class="flex flex-wrap gap-2"><span class={ playerBadgeClass(request) }>{ playerCount(request) }</span><span class="badge badge-warning">{ startLabel(request.StartsAt) }</span></div>
			if request.Description != "" {
				<p class="line-clamp-3 text-base-content/80">{ request.Description }</p>
			}
			<div class="card-actions mt-auto justify-end">
				<a class="btn btn-ghost btn-sm" href={ "/game-requests/" + request.ID }>View</a>
				if request.Status == gamerequest.StatusOpen && !request.ViewerJoined && !requestFull(request) {
					<form method="post" action={ "/game-requests/" + request.ID + "/join" }><input type="hidden" name="return_to" value="list"/><button class="btn btn-primary btn-sm" type="submit">Join</button></form>
				} else if request.ViewerJoined {
					<span class="badge badge-primary self-center">Joined</span>
				}
			</div>
		</div>
	</article>
}

templ NewGameRequest(brand branding.Brand, navigation components.NavigationState, options requestquery.CreationOptions, form GameRequestForm, message string) {
	@components.Layout(brand, "Create Game Request", navigation) {
		<section class="page-shell py-10"><div class="mx-auto max-w-2xl">
			<a class="link link-hover text-sm" href="/game-requests">← Back to Game Requests</a>
			<p class="data-text mt-6 text-sm font-semibold uppercase tracking-widest text-secondary">Find players</p><h1 class="mt-2 text-3xl font-bold">Create Game Request</h1>
			if message != "" {
				<div role="alert" class="alert alert-error mt-6"><span>{ message }</span></div>
			}
			if options.EventID == "" {
				<div class="card mt-8 border border-base-300 bg-base-200"><div class="card-body"><h2 class="card-title">No current Event</h2><p>An administrator must select a current Event before Game Requests can be created.</p></div></div>
			} else if len(options.Games) == 0 {
				<div class="card mt-8 border border-base-300 bg-base-200"><div class="card-body"><h2 class="card-title">No active games</h2><p>An administrator must add or activate a game first.</p></div></div>
			} else {
				<form method="post" action="/game-requests" class="card mt-8 border border-base-300 bg-base-200 shadow-sm"><div class="card-body gap-5">
					<p>Event: <strong>{ options.EventName }</strong></p>
					<label class="form-control"><span class="label-text mb-2 font-semibold">Game</span><select class="select select-bordered" name="game_id" required><option value="" disabled selected?={ form.GameID == "" }>Choose a game</option>
						for _, game := range options.Games {
							<option value={ game.ID } selected?={ form.GameID == game.ID }>{ game.Name }</option>
						}
					</select></label>
					<label class="form-control"><span class="label-text mb-2 font-semibold">Maximum players <span class="font-normal text-base-content/60">(optional, includes you)</span></span><input class="input input-bordered" type="number" name="max_players" min="1" value={ form.MaxPlayers } placeholder="No limit"/></label>
					<label class="form-control"><span class="label-text mb-2 font-semibold">Scheduled start <span class="font-normal text-base-content/60">(optional, UTC)</span></span><input class="input input-bordered" type="datetime-local" name="starts_at" value={ form.StartsAt }/><span class="mt-2 text-sm text-base-content/60">Leave blank to start now.</span></label>
					<label class="form-control"><span class="label-text mb-2 font-semibold">Description <span class="font-normal text-base-content/60">(optional)</span></span><textarea class="textarea textarea-bordered min-h-28" name="description" maxlength="1000" placeholder="Anything players should know">{ form.Description }</textarea></label>
					<div class="card-actions justify-end"><a class="btn btn-ghost" href="/game-requests">Cancel</a><button class="btn btn-primary" type="submit">Create Game Request</button></div>
				</div></form>
			}
		</div></section>
	}
}

templ GameRequestDetail(brand branding.Brand, navigation components.NavigationState, request requestquery.Request, viewerID, message, notice string) {
	@components.Layout(brand, request.GameName, navigation) {
		<section class="page-shell py-10"><div class="mx-auto max-w-3xl">
			<a class="link link-hover text-sm" href="/game-requests">← Back to Game Requests</a>
			if notice != "" {
				<div role="status" class="alert alert-info mt-6"><span>{ notice }</span></div>
			}
			if message != "" {
				<div role="alert" class="alert alert-error mt-6"><span>{ message }</span></div>
			}
			<article class="card mt-6 border border-base-300 bg-base-200 shadow-sm"><div class="card-body gap-6">
				<div><div class="flex flex-wrap items-center gap-2"><span class="data-text text-sm uppercase tracking-wider text-secondary">{ request.EventName }</span><span class="badge badge-outline">{ string(request.Status) }</span></div><h1 class="mt-2 text-3xl font-bold">{ request.GameName }</h1><p class="mt-2 text-base-content/65">Created by { request.CreatorName }</p></div>
				<div class="flex flex-wrap gap-2"><span class={ playerBadgeClass(request) }>{ playerCount(request) }</span><span class="badge badge-warning">{ startLabel(request.StartsAt) }</span></div>
				if request.Description != "" {
					<p class="whitespace-pre-wrap text-base-content/85">{ request.Description }</p>
				}
				<div><h2 class="text-xl font-bold">Players</h2><ul class="mt-3 grid gap-2 sm:grid-cols-2">
					for _, member := range request.Members {
						<li class="rounded-lg border border-base-300 px-4 py-3">{ member.DisplayName }
							if member.ID == request.CreatorID {
								<span class="badge badge-outline ml-2">Creator</span>
							}
						</li>
					}
				</ul></div>
				<div class="card-actions justify-end border-t border-base-300 pt-5">
					if request.Status == gamerequest.StatusOpen && request.CreatorID == viewerID {
						<form method="post" action={ "/game-requests/" + request.ID + "/close" }><button class="btn btn-outline" type="submit">Close Game Request</button></form>
						<form method="post" action={ "/game-requests/" + request.ID + "/cancel" }><button class="btn btn-error" type="submit">Cancel Game Request</button></form>
					} else if request.Status == gamerequest.StatusOpen && request.ViewerJoined {
						<form method="post" action={ "/game-requests/" + request.ID + "/leave" }><button class="btn btn-outline" type="submit">Leave</button></form>
					} else if request.Status == gamerequest.StatusOpen && !requestFull(request) {
						<form method="post" action={ "/game-requests/" + request.ID + "/join" }><button class="btn btn-primary" type="submit">Join</button></form>
					} else if requestFull(request) {
						<span class="badge badge-outline">Full</span>
					}
				</div>
			</div></article>
		</div></section>
	}
}

templ GameRequestError(brand branding.Brand, navigation components.NavigationState) {
	@components.Layout(brand, "Game Requests unavailable", navigation) {
		<section class="page-shell py-16"><div role="alert" class="alert alert-error"><div><h1 class="font-bold">Game Requests could not be loaded</h1><p>Try the request again.</p></div></div></section>
	}
}

func requestFull(request requestquery.Request) bool { return request.MaxPlayers != nil && request.MemberCount >= int64(*request.MaxPlayers) }
func playerCount(request requestquery.Request) string { if request.MaxPlayers == nil { return fmt.Sprintf("%d players", request.MemberCount) }; return fmt.Sprintf("%d / %d players", request.MemberCount, *request.MaxPlayers) }
func playerBadgeClass(request requestquery.Request) string { if requestFull(request) { return "badge badge-neutral data-text" }; if request.MaxPlayers != nil && request.MemberCount+1 == int64(*request.MaxPlayers) { return "badge badge-accent data-text" }; return "badge badge-primary data-text" }
func startLabel(startsAt time.Time) string { if startsAt.Before(time.Now().Add(2 * time.Minute)) { return "Starts now" }; return "Starts " + startsAt.UTC().Format("Jan 2, 15:04 UTC") }
