package pages

import (
	"github.com/convention-x-treme/lansurfer/internal/auth"
	"github.com/convention-x-treme/lansurfer/internal/web/branding"
	"github.com/convention-x-treme/lansurfer/internal/web/components"
)

// providerLoginHref maps a configured provider kind to its login start
// route, matching onboarding.go's resolveOptions.
func providerLoginHref(kind string) string {
	return "/auth/" + kind
}

// providerIcon is the Phosphor glyph for a configured provider kind. It keys
// on the kind, never the operator-chosen display name.
func providerIcon(kind string) string {
	switch kind {
	case "discord":
		return "ph ph-discord-logo"
	case "guest":
		return "ph ph-user"
	case "twitch":
		return "ph ph-twitch-logo"
	default:
		return "ph ph-key"
	}
}

templ Login(brand branding.Brand, providers []auth.ProviderAvailability, guestAvailable bool) {
	@components.AuthLayout(brand, "Log in") {
		<section class="auth-stage">
			<svg class="auth-waves" viewBox="0 0 1440 420" preserveAspectRatio="none" aria-hidden="true" focusable="false">
				<path d="M0,230 C230,120 400,320 610,220 C810,128 980,320 1180,210 C1320,132 1390,250 1440,210 L1440,420 L0,420 Z" fill="var(--brand-deep-ocean)" opacity="0.55"></path>
				<path d="M0,300 C210,200 410,380 630,290 C830,206 990,378 1190,286 C1330,224 1400,320 1440,290 L1440,420 L0,420 Z" fill="var(--brand-surf-blue)" opacity="0.28"></path>
				<path d="M0,360 C200,280 430,420 640,350 C840,286 1010,420 1210,348 C1350,300 1410,372 1440,352 L1440,420 L0,420 Z" fill="var(--brand-aqua-wave)" opacity="0.22"></path>
			</svg>
			<img class="auth-mascot" src="/assets/images/mascot-welcome-pose.webp" alt="LANsurfer otter ready to help players find a game"/>
			<div class="auth-panel">
				<div class="flex items-center gap-4">
					<img class="size-16 shrink-0" src={ brand.Assets.Icons.Any192 } width="64" height="64" alt=""/>
					<h1 class="text-[1.75rem] font-black leading-tight tracking-tight">Find your crew.<br/>Catch the next game.</h1>
				</div>
				<p class="mt-2.5 text-base-content/70">Sign in with the account you already have. LANsurfer never stores a password.</p>
				if len(providers) > 0 {
					<div class="mt-7 flex flex-col gap-3">
						for index, provider := range providers {
							if index == 1 {
								<div class="divider my-2 text-sm text-base-content/70">or</div>
							}
							if provider.Kind == "discord" {
								<a class="btn btn-provider-discord w-full" href={ templ.URL(providerLoginHref(provider.Kind)) }>
									<i class={ providerIcon(provider.Kind) } aria-hidden="true"></i>
									<span>Continue with { provider.DisplayName }</span>
								</a>
							} else if provider.Kind == "twitch" {
								<a class="btn btn-provider-twitch w-full" href={ templ.URL(providerLoginHref(provider.Kind)) }>
									<i class={ providerIcon(provider.Kind) } aria-hidden="true"></i>
									<span>Continue with { provider.DisplayName }</span>
								</a>
							} else {
								<a class="btn btn-primary w-full" href={ templ.URL(providerLoginHref(provider.Kind)) }>
									<i class={ providerIcon(provider.Kind) } aria-hidden="true"></i>
									<span>Continue with { provider.DisplayName }</span>
								</a>
							}
						}
					</div>
				}
				if guestAvailable {
					if len(providers) > 0 {
						<div class="divider my-2 text-sm text-base-content/70">or</div>
					}
					<div class="mt-4">
						<a class="btn btn-quiet w-full" href="/auth/guest/start"><i class="ph ph-user" aria-hidden="true"></i>Login as Guest</a>
						<p class="mt-2 text-sm text-base-content/70">Create a new guest account. An existing guest account cannot be recovered here.</p>
					</div>
				}
				if len(providers) > 0 || guestAvailable {
					<p class="mt-5 text-xs text-base-content/70">
						By logging in you agree to the <a class="link" href="/terms">Terms of Service</a> and acknowledge the <a class="link" href="/privacy">Privacy Policy</a>.
					</p>
				} else {
					<div role="alert" class="alert alert-warning mt-7"><span>Login is not configured for this LANsurfer instance.</span></div>
				}
				<div class="mt-7 border-t border-base-300 pt-5">
					@components.OperatorAttribution("text-xs text-base-content/70")
				</div>
			</div>
		</section>
	}
}

templ AuthenticationError(brand branding.Brand, message string, providers []auth.ProviderAvailability) {
	@components.AuthLayout(brand, "Login problem") {
		<section class="auth-stage">
			<div role="alert" class="auth-panel justify-self-center border-error">
				<h1 class="text-3xl font-bold">Login could not be completed</h1>
				<p class="mt-4 text-base-content/70">{ message }</p>
				<div class="mt-7 flex flex-wrap gap-3">
					if len(providers) > 0 {
						<a class="btn btn-primary" href="/auth/login"><i class="ph ph-sign-in" aria-hidden="true"></i>Start login again</a>
					}
					<a class="btn btn-ghost" href="/"><i class="ph ph-arrow-left" aria-hidden="true"></i>Return to login</a>
				</div>
			</div>
		</section>
	}
}
