{
  "name": "lansurfer-frontend",
  "private": true,
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "build:css": "tailwindcss -i web/src/brand.generated.css -o internal/web/assets/dist/app.css --minify",
    "build:js": "esbuild web/src/app.ts --bundle --minify --target=es2022 --outfile=internal/web/assets/dist/app.js",
    "build:js:sw": "esbuild web/src/service-worker.ts --bundle --minify --target=es2022 --outfile=internal/web/assets/dist/service-worker.js",
    "build:js:admin-pwa": "esbuild web/src/admin-pwa.ts --bundle --minify --target=es2022 --outfile=internal/web/assets/dist/admin-pwa.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build": "npm run prepare:assets && npm run build:css && npm run build:js && npm run build:js:sw && npm run build:js:admin-pwa && npm run typecheck"
  },
  "dependencies": {
    "htmx.org": "2.0.10"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@phosphor-icons/web": "2.1.2",
    "@playwright/test": "1.60.0",
    "@tailwindcss/cli": "4.3.3",
    "daisyui": "5.7.28",
    "esbuild": "0.28.2",
    "ffmpeg-static": "^5.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
